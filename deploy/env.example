# 小谷上线版环境变量模板。复制到服务器 /etc/xiaogu/<staging|prod>.env，chmod 600，属主 root。
# 不要把填好的文件放进仓库（.gitignore 已忽略 deploy/*.env）。

# staging 或 prod
XIAOGU_ENV=staging
# 只监听 127.0.0.1，由 nginx 反代；staging 8102，prod 8101
PORT=8102
XIAOGU_DB=/var/lib/xiaogu/staging/xiaogu.db

# 模型：staging 不写这一行就用模拟模型（不花钱）；要测真模型时写 deepseek，并用一把单独的低预算 key
# XIAOGU_PROVIDER=deepseek
# DEEPSEEK_API_KEY=           # prod 必填。旧 key 曾在对话里明文出现过，上线前必须在 DeepSeek 后台轮换
# XIAOGU_MODEL=deepseek-v4-pro
# 走 new-api 系中转站时（如 TornadoRouter）：base_url 指向它，模型名填中转站 /v1/models 里列出的准确 id；
# 后台会改用 GET <中转站>/api/usage/token/ 读这把 key 的用量。生产还必须显式确认（RUNBOOK B7）
# XIAOGU_BASE_URL=https://new.tornadorouter.com/v1
# XIAOGU_ALLOW_THIRD_PARTY_ROUTER=1
# XIAOGU_BASE_URL=https://new.tornadorouter.com/v1   # 走中转站时填；不填默认 https://api.deepseek.com。中转站没有 /user/balance，余额熔断会失效

# 必填：openssl rand -hex 32 生成；用于验证码哈希
XIAOGU_SECRET=
# 必填：后台口令，openssl rand -base64 24 生成，存进密码管理器
XIAOGU_ADMIN_TOKEN=

# 登录验证码发送方式：console 只把验证码打印到服务器日志，prod 会拒绝启动
XIAOGU_LOGIN_SENDER=console

# 后台生成邀请码时的默认额度
XIAOGU_SIGNUP_CREDITS=500

# 页脚公示（拿到后填写；没有就留空，页脚不显示）
# 例：浙ICP备2026000000号-1
XIAOGU_ICP_NO=
# 所用大模型的备案号 / 上线登记编号
XIAOGU_MODEL_FILING=
