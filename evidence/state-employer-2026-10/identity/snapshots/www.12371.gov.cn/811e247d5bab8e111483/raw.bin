    <script>
      function setDetailFontSize(size) {
        var detailContent = document.querySelector(".detail-content");
        if (!detailContent) return;

        console.log("set font size:", size);

        var currentStyle = getComputedStyle(detailContent);

        var currentFontSize = currentStyle.fontSize || "14px";
        var currentLineHeight = currentStyle.lineHeight || "25px";

        var fontSizeVal = Number(currentFontSize.replace("px", "")) || 14;
        var lineHeightVal = Number(currentLineHeight.replace("px", "")) || 25;

        if (fontSizeVal <= 10 && size === "small") {
          return;
        }

        if (size === "small") {
          newFontSize = fontSizeVal - 1;
          newLineHeight = lineHeightVal - 1;
        } else if (size === "large") {
          newFontSize = fontSizeVal + 1;
          newLineHeight = lineHeightVal + 1;
        }

        detailContent.style.fontSize = newFontSize + "px";
        detailContent.style.lineHeight = newLineHeight + "px";
      }
    </script>
  

