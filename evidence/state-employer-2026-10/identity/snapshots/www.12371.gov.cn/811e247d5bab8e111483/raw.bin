      var prevnext = {"prevArt":{"newsId":1438689961394532352,"title":"\u91CD\u5E86\u5E02\u5DEB\u5C71\u53BF\u4E8B\u4E1A\u5355\u4F4D2024\u5E74\u7B2C\u56DB\u5B63\u5EA6\u516C\u5F00\u62DB\u8058\u5DE5\u4F5C\u4EBA\u5458\u516C\u544A","url":"https:\/\/www.12371.gov.cn\/web\/article\/1438689961394532352\/web\/content_1438689961394532352.html","h5Url":"https:\/\/www.12371.gov.cn\/h5\/article\/1438689961394532352\/h5\/content_1438689961394532352.html","appUrl":"","jsonUrl":"","publishTime":"2025-01-02T10:01:36"},"nextArt":{"newsId":1438686596902838272,"title":"\u4E2D\u592E\u673A\u5173\u53CA\u5176\u76F4\u5C5E\u673A\u67842025\u5E74\u5EA6\u8003\u8BD5\u5F55\u7528\u516C\u52A1\u5458\u62A5\u540D\u5373\u5C06\u5F00\u59CB","url":"https:\/\/www.12371.gov.cn\/web\/article\/1438686596902838272\/web\/content_1438686596902838272.html","h5Url":"https:\/\/www.12371.gov.cn\/h5\/article\/1438686596902838272\/h5\/content_1438686596902838272.html","appUrl":"","jsonUrl":"","publishTime":"2024-10-14T10:23:06"}};
