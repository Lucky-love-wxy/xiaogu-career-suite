        } else if (cur_url.indexOf(xxgk_url) != -1) {
            $("#ibar_nav4").addClass("erj_d");
            $("#ibar_nav1").removeClass("home_on");
            $("#ibar_nav1").addClass("home_off");

        } else if (cur_url.indexOf(zwfw_url) != -1) {
            $("#ibar_nav5").addClass("erj_d");
            $("#ibar_nav1").addClass("home_off"); s

        } else if (cur_url.indexOf(hdjl_url) != -1) {
            $("#ibar_nav6").addClass("erj_d");
            $("#ibar_nav1").removeClass("home_on");
            $("#ibar_nav1").addClass("home_off");


        } else if (cur_url.indexOf(tzjb_url) != -1) {
            $("#ibar_nav7").addClass("erj_d");
            $("#ibar_nav1").removeClass("home_on");
            $("#ibar_nav1").addClass("home_off");


        } else if (cur_url.indexOf(cycx_url) != -1) {
