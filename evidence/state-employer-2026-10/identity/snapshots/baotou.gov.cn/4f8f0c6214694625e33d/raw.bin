<style>
      .archive {
        position: absolute;
        top: 35%;
        right: 10%;
        display: flex;
        flex-direction: column;
        align-items: center;
        transform: translate(-50%, -50%) rotate(-45deg);
        z-index: 999;
      }

      .archive_text {
        display: flex;
        align-items: center;
        font-size: 16px;
        font-family: "微软雅黑", "黑体";
        color: #c91211;
        font-weight: bold;
      }
    </style>
    <div class="archive">
      <div class="archive_text">
        <div>归档时间：</div>
        <div class="archive_state" style="display: none;">
          0
        </div>
        <p class="archive_time">
           
        </p>
      </div>
      <img src="../../../../../../material/images/archive_img.png" alt="" />
    </div>

    <script>
      // ISARCHIVE：0=未归档（隐藏标记），1=已归档（显示标记）
      (function () {
        var stateEl = document.querySelector(".archive_state");
        var state = stateEl ? stateEl.textContent.trim() : "";
        var archive = document.querySelector(".archive");
        if (!archive) return;
        if (state === "1") {
          archive.style.display = "";
        } else {
          archive.style.display = "none";
        }
      })();
    </script>

    <script>
      $(function() {
        const zoomFactor = 1.25;

        function getTargetElements() {
          return $('p, span, a, h1, h2, h3, h4, h5, h6, li, td, th, label, div:not(:has(*))');
        }

        // --- 开启长者模式 ---
        $('#zoomIn').on('click', function() {
          if ($('body').hasClass('senior-mode-active')) {
            return;
          }
          const currentElements = getTargetElements();
          // ... (字体放大的两步走逻辑，此处省略以保持简洁) ...
          currentElements.each(function() { /* 保存原始大小 */
            const currentSizeStr = $(this).css('font-size');
            $(this).data('original-font-size', currentSizeStr);
          });
          currentElements.each(function() { /* 计算并应用新大小 */
            const originalSizeStr = $(this).data('original-font-size');
            if (originalSizeStr) {
              const originalSizeNum = parseFloat(originalSizeStr);
              if (!isNaN(originalSizeNum) && originalSizeNum > 0) {
                $(this).css('font-size', (originalSizeNum * zoomFactor) + 'px');
              }
            }
          });

          $('body').addClass('senior-mode-active'); // 仍然建议保留class用于状态判断

          // --- 切换按钮显示 ---
          $(this).hide(); // 隐藏自己（“开启”按钮）
          $('#resetZoom').show(); // 查找并显示“关闭”按钮
        });

        // --- 关闭长者模式 ---
        $('#resetZoom').on('click', function() {
          const currentElements = getTargetElements();
          // ... (字体恢复的逻辑) ...
          currentElements.each(function() {
            const originalSize = $(this).data('original-font-size');
            if (originalSize) {
              $(this).css('font-size', originalSize);
              $(this).removeData('original-font-size');
            }
          });
            
          $('body').removeClass('senior-mode-active');
          // --- 切换按钮显示 ---
          $(this).hide(); // 隐藏自己（“关闭”按钮）
          $('#zoomIn').show(); // 查找并显示“开启”按钮
        });
    })
    </script>

    <!-- 点击量 -->
    <script type="text/javascript">
	  //上传点击数据
      let eventReport = new EventReport("/hx-api/receive/receiveData")
      let siteName = "包头市人民政府"
      let chnlRelation = "包头市人民政府>政府信息公开>政策>现行有效规范性文件>政府及其部门>市国有资产监督管理委员会"
      chnlRelation = chnlRelation.replace(siteName+">","")
      let docid = "663913"
      let doc_id = 0
      if(docid.length > 0){
        doc_id = parseInt(docid)
      }
      let url = "https://www.baotou.gov.cn/zfxxgk/zc/zc_xzgfxwj/zfjqbm/sgyzcjdglwyh/202510/t20251004_663913.html"
      let title ='包头市国资委关于印发《包头市属国有企业劳动用工管理办法》的通知';
      var reg =/<[^<>]+>/g;
      title = title.replace(reg, "");
      let docpubtime = "2025-10-04 12:14:34"
    
      if (doc_id== 0) {
        doc_id = 0;
        url = document.URL
        title = document.title
        docpubtime = ""
      }
      let doc_channel = "市国有资产监督管理委员会"
      let siteid = parseInt("53")
      if (siteid.length == 0) {
        siteid = 0
      }
    
      let channel_id = parseInt("5975")
    
      if(channel_id.length == 0){
        channel_id = 0
      }
      //appkey
      let appKey = "dda1bee997e29182febbe848dd3b313a"
    
      let myParam = {
		    title: title,
		    url: url,
		    doc_id: doc_id,
		    siteid: siteid,
		    site_name: siteName,
		    doc_channel: doc_channel,
		    channel_relation: chnlRelation,
		    channel_id: channel_id,
		    doc_pub_time: docpubtime,
		    app_key: appKey
      }
      //统计外链
      InitExternalLinks("/hx-api/receive/receiveLink",myParam,"trs.nmsuny.com")
      eventReport.trackUserData(myParam)
      // 点击量埋点结束
    </script>

    <!-- 用户一号登录 -->
    <script>
      function goLogin(){
        window.open("/personal/validate/gotoLogin.do?client_id=PDSAYLDQY&goto="+decodeURIComponent("https://www.baotou.gov.cn"));
      }
      var ovUserInfo;
      var ovData;
      // 获取用户登录状态
      function getUserObj() {
        $.ajax({
          url: '/personal/usrlogin/getUserInfo',//根据实际事情情况更换域名
          type: 'get',
          dataType: 'json',
          success: function(data) {
            if(!data.success){ 
              $(".userInfo2").hide();
              $(".userInfo1").show();
            }else{
              ovUserInfo = data.data;
              $(".userInfo1").hide();
              $(".userInfo2").show();
              $('.userInfo2').html("欢迎："+ovUserInfo.USER_NAME);
            }
          },
          error: function (err) {
            console.log('不好意思，您请求的接口出错了！')
          }
        })
        return ovData;
      }

      $(function () {
        $(".userInfo2").hide();
        $(".userInfo1").show();
        getUserObj();
      })
    </script>

  <!-- 政策沟通 -->
  <script>
    var policyUrl = window.location.href
    var policyId = '663913'
    var policyTitle = '包头市国资委关于印发《包头市属国有企业劳动用工管理办法》的通知'
    var replyDeptid = ''

    let policyData = {
      policyId: policyId,
      policyTitle: policyTitle,
      replyDeptid: replyDeptid,
      policyUrl: policyUrl
    };
      
    localStorage.removeItem("policyData");
    localStorage.setItem("policyData", JSON.stringify(policyData));

    if(replyDeptid == "") {
      $("#gtjl_box").hide();
    }

    function fetchZczxList() {
      $.ajax({
        type: "GET",
        url: "/common-api/server/policy-communications/anonymous/policy/page",
        data: {
          policyId: policyId,
          pageNo: 1,
          pageSize: 5
        },
        success: function(res) {
          if(res.code == 0) {
            if(res.data.total <= 0) return $("#gtrd").hide();
            $("#zcgt_list").empty();
            res.data.list.forEach(item => {              
              // $("#zcgt_list").append(`<li>
              //     <a href="" target="_blank"></a>
              //   </li>`);
              $("#zcgt_list").append("<li><a href=https://www.baotou.gov.cn/hdjl/gtjl/wygt/202608/t20260826_959014.html?id=" + item.id + " target=\"_blank\">" + item.title + "</a></li>");
            });
          }
        }
      })
    }

    fetchZczxList();

    // 浏览器打印
    function printPage() {
      window.print();
    }

    // 关闭当前页面
    function closePage() {
      window.close();
    }

    // 字体大小切换
    $(".font_option li").click(function () {
      $(this).addClass("active").siblings().removeClass("active");

      let type = $(this).attr("size");
      let inner = $("#inner");

      if (type == "large") {
        inner.addClass("large").removeClass("medium").removeClass("small");
      } else if (type == "medium") {
        inner.addClass("medium").removeClass("large").removeClass("small");
      } else {
        inner.addClass("small").removeClass("large").removeClass("medium");
      }
    });

    // 滚动固定
    window.addEventListener("scroll", function () {
      const scrollTop = window.scrollY;
      if (scrollTop >= 1064) {
        $(".main_other_box").css("position", "sticky");
        $(".main_other_box").css("top", "90px");
      } else {
        $(".main_other_box").css("position", "static");
      }
    }); 

    // 文章详情页，添加如下代码获取点击量
    let docid_text="663913";
    if(docid_text.length > 0){
      docid_text=parseInt(docid_text);
      $.ajax({
        url: '/hx-api/trsHxOpenApi/getDocPVCountById?docId='+docid_text+'&appKey='+appKey,
        dataType: "jsonp",
        jsonp: 'callback',
        jsonpCallback: "callback",
        success: function(data) {
          //回显点击量
          $('#clickcounts').html('浏览次数：'+data);
        },
        error: function(err) {
          console.log(err)
        }
      })
    }

  </script>

  <!-- 语音播报功能 -->
  <script>
    function startOnlineRead(text) {
      if (!window.WzaSpeechReader || typeof window.WzaSpeechReader.speak !== "function") {
        console.error("在线朗读能力未初始化，请确认 toolbar_init.js 已加载完成");
        return;
      }
      text = (text || "").replace(/\s+/g, " ").trim();
      if (!text) {
        console.warn("朗读内容为空");
        return;
      }
      return window.WzaSpeechReader.speak(text, {
        speed: 50,
        volume: 100,
        pitch: 50,
        vcn: "x4_xiaoyan"
      });
    }

    function startOnlineReadById(id) {
      var el = document.getElementById(id);
      if (!el) {
        console.error("未找到朗读内容元素：" + id);
        return;
      }
      var text = el.innerText || el.textContent || "";
      text = text.replace(/\s+/g, " ").trim();
      if (!text) {
        console.warn("朗读内容为空");
        return;
      }
      $('#begin').hide();
      $('#pause').show();
      return startOnlineRead(text);
    }

    function stopOnlineRead() {
      if (!window.WzaSpeechReader) {
        console.error("在线朗读能力未初始化");
        return;
      }
      $('#begin').show();
      $('#pause').hide();
      window.WzaSpeechReader.stop();
    }


    
  </script>

  <!-- AI 分析弹框结构（隐藏模板） -->
  <div id="aiDialogTpl" style="display: none;">
    <div class="ai_dialog">
      <div class="ai_dialog_head">
        <h3>
          <img class="icon" src="../../../../../../material/images/073ai_dialog_logo.png" alt="" />
          <span>AI导读</span>
        </h3>
        <p style="font-size: 18px;color: #666;margin-top: 10px;">（试运行）</p>
        <div class="close">
          <img src="../../../../../../material/images/074ai_dialog_icon_close.png" alt="" />
        </div>
      </div>
      <div class="ai_dialog_content">
        <div class="ai_dialog_title"></div>
        <div class="ai_dialog_main dialogSlide">
          <div class="hd">
            <ul class="ai_dialog_main_nav">
              <li>政策概览</li>
              <li>政策脑图</li>
            </ul>
          </div>
          <div class="bd">
            <!-- 政策概览：AI 摘要 markdown 流式渲染 -->
            <div class="ai_dialog_inner ai_overview">
              <div class="ai_state ai_loading">AI 正在生成政策概览…</div>
              <div class="ai_md_wrap"></div>
            </div>
            <!-- 政策脑图：markmap 流式渲染 -->
            <div class="ai_dialog_inner ai_naotu">
              <div class="ai_state ai_loading">AI 正在生成政策脑图…</div>
              <div class="ai_mm_toolbar">
                <button type="button" data-act="zoomin">放大</button>
                <button type="button" data-act="zoomout">缩小</button>
                <button type="button" data-act="reset">重置</button>
                <button type="button" data-act="export">导出SVG</button>
                <button type="button" data-act="copy">复制图片</button>
              </div>
              <svg class="ai_mm_svg"></svg>
            </div>
          </div>
        </div>
        <div class="ai_dialog_bot">
          <div class="tips">本内容由AI生成，仅供参考。</div>
          <div class="statement">
            <img src="../../../../../../material/images/077ai_icon_safe.png" alt="" />
            <span>免责声明</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- AI 分析相关代码 -->
  <script>
    /**
     * AI 请求层（TRS LLMOPS 平台），接口说明见 ai.md：
     *   接口一：POST {API_BASE}/{appId}/conversations/info
     *          -> 创建会话并提问，返回 data[0]{ conversationId, qaId, chatLogId }
     *   接口二：POST {API_BASE}/{appId}/conversations/{cid}/qas/{qaId}/stream
     *          -> SSE 流式返回，每行 data:{"answer":"增量文本"}
     */
    (function () {
      'use strict';

      var API_BASE = 'https://llmys.trscd.com.cn/llmops/chat/apps';
      var COMMON_HEADERS = {
        'Content-Type': 'application/json',
        'Username': 'naotu',
        'Access-Token': 'aff4d6239a014070'
      };

      /**
       * 发起一次 AI 问答，流式回调增量文本
       * @param {number} appId 应用 ID（1697 AI导读 / 1695 思维导图）
       * @param {string} question 完整提问（prompt 前缀 + 内容）
       * @param {function} onChunk 每收到一段增量文本回调 (text) => void
       * @param {AbortSignal} [signal] 中断信号（关闭弹框时 abort）
       * @returns {Promise<void>} 流读取完毕 resolve；失败/中断 reject
       */
      function ask(appId, question, onChunk, signal) {
        return fetch(API_BASE + '/' + appId + '/conversations/info', {
          method: 'POST',
          headers: COMMON_HEADERS,
          signal: signal,
          body: JSON.stringify({ conversationId: -1, tenantId: 3, question: question })
        })
          .then(function (res) {
            if (!res.ok) throw new Error('AI 服务异常（HTTP ' + res.status + '）');
            return res.json();
          })
          .then(function (info) {
            // 判空校验：接口异常时 data[0] 可能不存在（ai.md 已知缺陷，这里补上）
            var first = info && info.data && info.data[0];
            if (!first || !first.conversationId || !first.qaId) {
              throw new Error('AI 服务返回数据异常');
            }
            return fetch(
              API_BASE + '/' + appId + '/conversations/' + first.conversationId
                + '/qas/' + first.qaId + '/stream',
              {
                method: 'POST',
                headers: COMMON_HEADERS,
                signal: signal,
                body: JSON.stringify({ chatLogId: first.chatLogId })
              }
            );
          })
          .then(function (res) {
            if (!res.ok) throw new Error('AI 服务异常（HTTP ' + res.status + '）');
            return readSse(res.body, onChunk);
          });
      }

      /** 读取 SSE 流：带行缓冲（JSON 行可能被网络分包截断），流结束冲刷解码器防多字节丢尾字 */
      function readSse(body, onChunk) {
        var reader = body.getReader();
        var decoder = new TextDecoder('utf-8');
        var lineBuf = '';

        function pump() {
          return reader.read().then(function (result) {
            if (result.done) {
              var tail = decoder.decode(); // 冲刷跨 chunk 的多字节字符残留
              if (tail) lineBuf += tail;
              if (lineBuf) emit(lineBuf, onChunk);
              return;
            }
            lineBuf += decoder.decode(result.value, { stream: true });
            var lines = lineBuf.split('\n');
            lineBuf = lines.pop(); // 保留最后一段不完整行
            for (var i = 0; i < lines.length; i++) emit(lines[i], onChunk);
            return pump();
          });
        }

        return pump();
      }

      /** 解析单行 data: 前缀的 JSON，回调 answer 增量；坏行直接忽略 */
      function emit(line, onChunk) {
        if (!line || line.indexOf('data:') !== 0) return;
        try {
          var parsed = JSON.parse(line.slice(5).trim());
          if (parsed && parsed.answer) onChunk(parsed.answer);
        } catch (e) {
          /* 忽略非 JSON / 截断的坏行 */
        }
      }

      window.AI = {
        APP_OVERVIEW: 1697, // AI导读：输出 Markdown 摘要
        APP_MINDMAP: 1695,  // 思维导图：输出 Markdown 层级大纲
        PROMPT_OVERVIEW: '请基于以下内容生成摘要，内容详情：',
        PROMPT_MINDMAP: '请基于以下内容生成思维导图，内容详情：',
        ask: ask
      };
    })();

    $(function () {
      'use strict';

      // =============================================================
      // 详情页取数：从 DOM 组装与列表页 policyList 项同构的数据对象
      // （title / docno / scrq / docpubtime / zc_doccontent）
      // =============================================================
      function buildItem() {
        function meta(label) {
          var val = '';
          $('.info_table th').each(function () {
            if ($(this).text().replace(/：\s*$/, '').trim() === label) {
              val = $(this).next('td').text().trim();
            }
          });
          return val;
        }
        var docpubtime = '';
        var m = ($('.publish_date').text() || '').match(/\d{4}[-/年]\d{1,2}[-/月]\d{1,2}/);
        if (m) docpubtime = m[0];
        return {
          title: $.trim($('.article_head h2').text()),
          docno: meta('文号'),
          scrq: meta('成文日期'),
          docpubtime: docpubtime,
          zc_doccontent: $.trim($('#inner').text())
        };
      }

      // 构建 AI 提问内容：元数据 + 全文
      function buildQuestion(prefix, item) {
        var parts = [
          '标题：' + (item.title || ''),
          '发文字号：' + (item.docno || ''),
          '成文日期：' + (item.scrq || ''),
          '发布日期：' + (item.docpubtime || '')
        ];
        if (item.zc_doccontent) {
          parts.push('正文内容：');
          parts.push(item.zc_doccontent);
        }
        return prefix + parts.join('\n');
      }

      // 请求失败 / 流中断时更新面板状态提示（用户主动关闭弹框除外）
      function showStateError($state, buf, err) {
        $state.removeClass('ai_loading').addClass('ai_error')
          .text(buf ? '生成中断，内容可能不完整' : '生成失败：' + ((err && err.message) || '网络异常'));
      }

      // =============================================================
      // 政策概览：累加增量 -> 100ms 节流 marked.parse 整段重渲染 -> 滚动跟随
      // =============================================================
      function renderOverview($panel, item, signal) {
        var $state = $panel.find('.ai_state');
        var $wrap = $panel.find('.ai_md_wrap');
        var buf = '';
        var timer = null;
        var follow = true; // 用户上滚后停止自动跟随，滚回底部恢复

        $panel.on('scroll', function () {
          follow = $panel.scrollTop() + $panel.height() >= this.scrollHeight - 30;
        });

        function render() {
          timer = null;
          if (!buf) return;
          $wrap.html(marked.parse(buf));
          if (follow) $panel.scrollTop($panel[0].scrollHeight);
        }

        AI.ask(AI.APP_OVERVIEW, buildQuestion(AI.PROMPT_OVERVIEW, item), function (chunk) {
          $state.hide();
          buf += chunk;
          if (!timer) timer = setTimeout(render, 100); // 节流重渲染
        }).then(function () {
          clearTimeout(timer);
          render(); // 流结束冲刷最后一段
        }).catch(function (err) {
          if (signal.aborted) return; // 用户主动关闭弹框
          clearTimeout(timer);
          showStateError($state.show(), buf, err);
        });
      }

      // =============================================================
      // 政策脑图：累加增量 -> 节流 transform + setData + fit
      // 面板被 SuperSlide fade 隐藏时（display:none）svg 尺寸为 0，
      // 此时只缓冲不渲染，等面板可见后再创建 / 重适配
      // =============================================================

      // markmap 自带的 rescale 走 d3 过渡（transition）应用缩放，
      // 在本项目 d3 v6 下实测不生效（实测 k 值不变），
      // 这里补一个立即应用的原型方法（以视图中心为锚点）
      markmap.Markmap.prototype.zoomAt = function (ratio) {
        var el = this.svg.node();
        var rect = el.getBoundingClientRect();
        var t = d3.zoomTransform(el);
        var next = t.translate(
          (rect.width / 2 - t.x) * (1 - ratio) / t.k,
          (rect.height / 2 - t.y) * (1 - ratio) / t.k
        ).scale(ratio);
        this.svg.call(this.zoom.transform, next);
      };

      function renderMindmap($panel, item, signal) {
        var $state = $panel.find('.ai_state');
        var $svg = $panel.find('.ai_mm_svg');
        var transformer = new markmap.Transformer();
        var instance = null;
        var buf = '';
        var timer = null;

        function render() {
          timer = null;
          if (!buf.trim() || !$panel.is(':visible')) return; // 隐藏时缓冲，show() 里触发
          try {
            var root = transformer.transform(buf).root; // 大纲未完整时可能抛错，忽略本次
            if (!instance) {
              instance = markmap.Markmap.create($svg[0], { autoFit: true, fitRatio: 0.95, duration: 300 }, root);
            } else {
              instance.setData(root);
            }
            instance.fit();
          } catch (e) { /* 忽略 */ }
        }

        AI.ask(AI.APP_MINDMAP, buildQuestion(AI.PROMPT_MINDMAP, item), function (chunk) {
          $state.hide();
          buf += chunk;
          if (!timer) timer = setTimeout(render, 300); // 脑图重排较重，节流放宽
        }).then(function () {
          clearTimeout(timer);
          render();
        }).catch(function (err) {
          if (signal.aborted) return;
          clearTimeout(timer);
          showStateError($state.show(), buf, err);
        });

        // =========================================================
        // 工具条：放大 / 缩小 / 重置 / 导出 SVG / 复制图片
        // =========================================================

        // 当前缩放倍数（markmap 底层是 d3.zoom）
        function currentK() {
          return d3.zoomTransform($svg[0]).k;
        }

        function zoomBy(ratio) {
          var next = currentK() * ratio;
          if (next > 3 || next < 0.3) return; // 0.3 ~ 3 倍限制
          if (instance.zoomAt) instance.zoomAt(ratio);
          else instance.rescale(ratio); // 兜底
        }

        // 导出文件名：政策标题去特殊字符，超长截断
        function fileBase() {
          return (item.title || '政策脑图').replace(/[\\/:*?"<>|\s]+/g, '').slice(0, 30) + '-政策脑图';
        }

        function downloadUrl(url, filename) {
          var a = document.createElement('a');
          a.href = url;
          a.download = filename;
          document.body.appendChild(a);
          a.click();
          a.remove();
        }

        // 序列化 svg：补 width/height 属性（否则位图导出是 0 尺寸）+ 白色背景
        function buildSvgSource() {
          var rect = $svg[0].getBoundingClientRect();
          var w = Math.ceil(rect.width);
          var h = Math.ceil(rect.height);
          var clone = $svg[0].cloneNode(true);
          clone.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
          clone.setAttribute('width', w);
          clone.setAttribute('height', h);
          var bg = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
          bg.setAttribute('width', '100%');
          bg.setAttribute('height', '100%');
          bg.setAttribute('fill', '#fff');
          clone.insertBefore(bg, clone.firstChild);
          return { source: new XMLSerializer().serializeToString(clone), width: w, height: h };
        }

        function exportSvg() {
          var r = buildSvgSource();
          var url = URL.createObjectURL(new Blob([r.source], { type: 'image/svg+xml;charset=utf-8' }));
          downloadUrl(url, fileBase() + '.svg');
          setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
          aiToast('SVG 已导出');
        }

        // 复制图片：svg -> Image -> canvas -> 剪贴板；
        // 剪贴板不可用（非 https/localhost 或无权限）时降级为下载 PNG
        function copyPng() {
          aiToast('正在生成图片…');
          var r = buildSvgSource();
          var img = new Image();
          img.onload = function () {
            var scale = 2; // 2 倍尺寸绘制，文字更清晰
            var canvas = document.createElement('canvas');
            canvas.width = r.width * scale;
            canvas.height = r.height * scale;
            var ctx = canvas.getContext('2d');
            ctx.scale(scale, scale);
            ctx.fillStyle = '#fff';
            ctx.fillRect(0, 0, r.width, r.height);
            ctx.drawImage(img, 0, 0, r.width, r.height);
            canvas.toBlob(function (blob) {
              if (!blob) { aiToast('图片生成失败'); return; }
              if (navigator.clipboard && window.ClipboardItem) {
                navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })])
                  .then(function () { aiToast('图片已复制到剪贴板，可直接粘贴（Ctrl+V）', 3000); })
                  .catch(function () { fallbackDownloadPng(blob); });
              } else {
                fallbackDownloadPng(blob);
              }
            }, 'image/png');
          };
          img.onerror = function () { aiToast('图片生成失败'); };
          img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(r.source);
        }

        function fallbackDownloadPng(blob) {
          var url = URL.createObjectURL(blob);
          downloadUrl(url, fileBase() + '.png');
          setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
          aiToast('剪贴板不可用，已改为下载图片');
        }

        // 弹框内容是克隆节点，用事件委托绑定工具条
        $panel.on('click', '.ai_mm_toolbar button', function () {
          if (!instance) { aiToast('脑图生成中，请稍候'); return; }
          var act = $(this).data('act');
          if (act === 'zoomin') zoomBy(1.25);
          else if (act === 'zoomout') zoomBy(0.8);
          else if (act === 'reset') instance.fit();
          else if (act === 'export') exportSvg();
          else if (act === 'copy') copyPng();
        });

        // 切到脑图 tab 后由外部调用：面板可见后创建实例 / 重新适配尺寸
        return {
          show: function () {
            clearTimeout(timer);
            render();
            if (instance) instance.fit();
          }
        };
      }

      // 轻提示：单例复用；每次调用先移除再添加 show 类，
      // 强制过渡动画重新播放，避免连续提示时只换文字、用户无感知
      var $toast = null;
      var toastTimer = null;
      function aiToast(msg, duration) {
        if (!$toast) $toast = $('<div class="ai_toast"></div>').appendTo('body');
        $toast.stop(true, true).text(msg).removeClass('show');
        void $toast[0].offsetWidth; // 强制重绘，让动画重新开始
        $toast.addClass('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { $toast.removeClass('show'); }, duration || 2000);
      }

      // =============================================================
      // AI分析按钮点击 -> 打开弹框，并行发起概览 + 脑图两个请求
      // =============================================================
      $('.bt-ai-guide-btn').on('click', function () {
        var item = buildItem();
        // PC 端 67% x 80%，移动端宽度 92%、高度自适应
        var dialogArea = $(window).width() < 750 ? ['92%'] : ['67%', '80%'];

        // 克隆页面中的弹框结构模板，填充标题后序列化为 HTML 字符串
        var $dialog = $('#aiDialogTpl .ai_dialog').clone();
        $dialog.find('.ai_dialog_title').text(item.title || '');

        layui.use(['layer'], function () {
          var layer = layui.layer;
          var controller = new AbortController(); // 关闭弹框时中断所有 AI 流

          layer.open({
            type: 1, // 自定义内容层
            title: false,
            closeBtn: 0,
            area: dialogArea,
            skin: 'ai-dialog-layer',
            shade: 0.4,
            resize: false,
            content: $dialog[0].outerHTML,
            // 弹框内容是异步插入的克隆节点，插件行为不会随 outerHTML 带过去，
            // 必须等 layer 渲染完成后对弹框内的节点重新初始化
            success: function (layero, index) {
              layero.find('.dialogSlide').slide({ trigger: 'click' });
              // 点击弹框内关闭按钮关闭弹框（同样是克隆节点，行为需在此绑定）
              layero.find('.ai_dialog_head .close').on('click', function () {
                layer.close(index);
              });

              var $panels = layero.find('.ai_dialog_inner');
              // 概览是默认 tab：打开弹框即加载
              renderOverview($panels.eq(0), item, controller.signal);

              // 脑图懒加载：首次切到该 tab 才发起请求；之后切回不重复请求，只重新适配尺寸
              var mindmap = null;
              var mindmapStarted = false;
              layero.find('.ai_dialog_main_nav li').eq(1).on('click', function () {
                if (!mindmapStarted) {
                  mindmapStarted = true;
                  mindmap = renderMindmap($panels.eq(1), item, controller.signal);
                }
                // 等 fade 动画完成、面板可见后再创建实例 / fit
                setTimeout(function () { mindmap && mindmap.show(); }, 550);
              });

              // 点击"免责声明"：叠加弹出免责声明弹框（内容固定，直接用 HTML 字符串）
              layero.find('.ai_dialog_bot .statement').on('click', function () {
                var statementArea = $(window).width() < 750 ? ['86%'] : ['520px'];
                layer.open({
                  type: 1,
                  title: '免责声明',
                  area: statementArea,
                  skin: 'ai-statement-layer',
                  shade: 0.4,
                  resize: false,
                  btn: ['我知道了'],
                  btnAlign: 'c',
                  content: '<div class="ai_statement">'
                    + '<ol>'
                    + '<li>本功能生成的内容（含政策概览、政策脑图）均由人工智能模型自动生成，仅供学习参考，不构成任何形式的官方解释、政策承诺或决策依据。</li>'
                    + '<li>AI 生成内容可能存在不准确、不完整或与政策原文不一致之处，请以政府正式发布文件及官方解读为准。</li>'
                    + '<li>如需正式引用政策内容或作为办事依据，请查阅政策原文或咨询政策发布机构。</li>'
                    + '<li>本平台不对因使用 AI 生成内容而产生的任何直接或间接损失承担责任。</li>'
                    + '</ol>'
                    + '</div>'
                });
              });
            },
            // 兜底：无论以何种方式关闭弹框，都中断未完成的 AI 流
            end: function () {
              controller.abort();
            }
          });
        });
      });
    });
  </script>
</body>

</html>