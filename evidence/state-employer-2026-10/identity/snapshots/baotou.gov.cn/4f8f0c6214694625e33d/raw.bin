    <script>
      // 栏目着重
      $(function() {
        var href = window.location.href;
        var index = 0;
        if (href.indexOf("/ywdt/") != -1) index = 1;
        if (href.indexOf("/zfxxgk/") != -1) index = 2;
        if (href.indexOf("/zwfw/") != -1) index = 3;
        if (href.indexOf("/hdjl/") != -1) index = 4;
        if (href.indexOf("/sjkf/") != -1) index = 5;
        if (href.indexOf("/yxbt/") != -1) index = 6;
        $("#navList li").each(function(i){
          $("#navList li").removeClass("active").eq(index).addClass("active");
        });
      })

      // 网站搜索
      document.getElementById("searchBtn").addEventListener("click", function () {
        var keyword = document.getElementById("searchInput").value;
          if (keyword) {
            window.location.href = "/searchweb/#/Door?keywords=" + keyword;
          } else {
            alert("请输入您需要查询的关键词");
          }
      });

      $('#search_icon').click(function(e){
          e.stopPropagation()
          $('#scroll_nav').hide()
          $('#scroll_search_box').css('display','flex')
          $('#scrollInput').focus()
          $('#sc_icon').hide()
        })

        $(document).click(function(event) {
          $('#scroll_nav').show()
          $('#scroll_search_box').css('display','none')
          $('#search_icon').show()
          $('#sc_icon').show()
          $('#scrollInput').val('')
        });

        $('#scrollBtn').click(function() { 
          let k = $('#scrollInput').val()
          if(k) {
            window.location.href = "/searchweb/#/Door?keywords=" + k;
          }else {
            alert("请输入您需要查询的关键词");
          }
        })
    </script>

    <script>
      // 判断设备类型
      const judgeDeviceType = () => {
        return /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|OperaMini/i.test(navigator.userAgent) ? "Mobile" : "PC";
      };

      function windowScroll() {
        let lastScrollTop = 0;
        let ticking = false;
        let isHeaderShown = true;

        if (judgeDeviceType() === "PC") {
          window.addEventListener("scroll", function () {
            if (!ticking) {
              requestAnimationFrame(function () {
                const scrollTop = window.scrollY;

                if (scrollTop > 420 && isHeaderShown) {
                  $(".header_nav").fadeOut(100);
                  $(".header_scroll").fadeIn(100);
                  isHeaderShown = false;
                } else if (scrollTop <= 420 && !isHeaderShown) {
                  $(".header_nav").fadeIn(100);
                  $(".header_scroll").fadeOut(100);
                  isHeaderShown = true;
                }

                ticking = false;
              });
              ticking = true;
            }
          });
        }
      }

      windowScroll();

      // 头部轮播
      new Swiper(".headerSwiper", {
        autoplay: {
          delay: 5000,
          disableOnInteraction: false,
        },
        speed: 500,
        spaceBetween: 30,
        effect: "fade",
        loop: true,
        allowTouchMove: false,
      });
    </script>

