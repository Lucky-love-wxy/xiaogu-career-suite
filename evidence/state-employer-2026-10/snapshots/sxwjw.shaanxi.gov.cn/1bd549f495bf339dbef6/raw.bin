<script>
	function submitsearch(){
		var result = $("#textfield").val();
		result = $.trim(result); 
		var reg = /[`~!@#$%^&*_+<>{}\/'[\]]/im;

		var url = window.location.href;
		var arrUrl = url.split("//");
		var arrUrl1 = arrUrl[1].split("/");
		var para = arrUrl1[0];

		if (reg.test(result)) {
			window.wxc.xcConfirm('您输入的信息包含非法字符!', window.wxc.xcConfirm.typeEnum.info)
			return false;
		}
		if (result == "搜索关键字" || result == "" || result == null) {
			window.wxc.xcConfirm('请输入检索条件!', window.wxc.xcConfirm.typeEnum.info)
			return false;
		} else {
			result = result.replace("-", "\-");
			result = result.replace("(", "\(");
			result = result.replace(")", "\)");
		}
		window.open("/sxsearch/search.html?code=1845a1ac642&tenantId=16&searchWord=" + encodeURI(result));
	}
</script>
<iframe id="tempIframe1" src="" style="display:none;" name="tempIframe1"></iframe>
<iframe id="tempIframe2" src="" style="display:none;" name="tempIframe2"></iframe>
<script>
(function(window,localStorage,undefined){
var LS = {
    set : function(key, value){
        //在iPhone/iPad上有时设置setItem()时会出现诡异的QUOTA_EXCEEDED_ERR错误
        //这时一般在setItem之前，先removeItem()就ok了
        if( this.get(key) !== null )
            this.remove(key);
        localStorage.setItem(key, value);
    },
    //查询不存在的key时，有的浏览器返回undefined，这里统一返回null
    get : function(key){
        var v = localStorage.getItem(key);
        return v === undefined ? null : v;
    },
    remove : function(key){ localStorage.removeItem(key); },
    clear : function(){ localStorage.clear(); },
    each : function(fn){
        var n = localStorage.length, i = 0, fn = fn || function(){}, key;
        for(; i<n; i++){
            key = localStorage.key(i);
            if( fn.call(this, key, this.get(key)) === false )
                break;
            //如果内容被删除，则总长度和索引都同步减少
            if( localStorage.length < n ){
                n --;
                i --;
            }
        }
    }
},
j = window.jQuery, c = window.Core;
//扩展到相应的对象上
window.LS = window.LS || LS;
//扩展到其他主要对象上
if(j) j.LS = j.LS || LS;
if(c) c.LS = c.LS || LS;
})(window,window.localStorage);
var searchUrl=window.location.href;
var SSOSignOrder= /code=(\w*)/;
var SSOSign = searchUrl.match(SSOSignOrder);
SSOSign = SSOSign ? SSOSign [1] : '';
if(SSOSign=="" || SSOSign==null) {
	SSOSign = localStorage.SSOSign;
}else{
	$("#tempIframe1").attr("src","https://sfrz.shaanxi.gov.cn/sysauthserver/authorize?authCheck=true&needAuth=true&client_id=SN000000717&redirect_uri="+window.location.href.substring(0,window.location.href.indexOf("?")));
	$("#tempIframe1").load(function(){  
		if($("#tempIframe1").attr("src").indexOf("renew=true&flag=true")>-1){
			$("#tempIframe2").attr("src","https://sfrz.shaanxi.gov.cn/sysauthserver/authorize?response_type=code&client_id=SN000000717&redirect_uri="+window.location.href.substring(0,window.location.href.indexOf("?")));
			$("#tempIframe2").load(function(){  
				SSOSign=$("#tempIframe2").attr("src").match(SSOSignOrder);
				SSOSign = SSOSign ? SSOSign [1] : '';
			});
		}
	});
}
function addTrack(){
	$.ajax({
        url: '/fsp/user/center/addTrack',
        type: 'post',
		headers: {
            SSOSign: SSOSign
        },
        data: JSON.stringify({
            articleName: $("meta[name=ArticleTitle]").attr("content"),
            articleAddress: $("meta[name=Url]").attr("content"),
            siteName:$("meta[name=SiteName]").attr("content"),
			siteDomain:$("meta[name=SiteDomain]").attr("content")
        }),
        "contentType": 'application/json',
        success: function(data) {
            data = JSON.parse(data);
            if (data.code === '200') {
				console.log("记录足迹");
            }
        }
    })
}

function userInfoByKey(){
    $.ajax({
        type: "get",
        dataType: "json",
        url: "/fsp/login/userInfoByKey" ,
        contentType:"application/json",
    headers: {
            SSOSign: SSOSign
        },
        success: function (result) {
    if(result.code==200){
    var secretKey = result.summary_info.secretKey;
    var userdata = result.datas;
            $.ajax({
    type: "get",
    dataType: "json",
    url: "/fsp/login/getPrivateKey?secureKey="+secretKey ,
    contentType:"application/json",
    headers: {
    SSOSign: SSOSign
    },
    success: function (result) {
    var decryptData = sm2.doDecrypt(userdata,result.datas.secretvalue, 1)
    decryptData = JSON.parse(decryptData);
    //console.log(decryptData);
    if(result.code==200){
    localStorage.SSOSign=SSOSign;
    if(decryptData.accttype == "10"){
    $("#dlxx").text("你好，"+decryptData.username);
    }else{
    $("#dlxx").text("你好，"+decryptData.corpname);
    }
    $("#dlxx").attr("href","https://zwfw.shaanxi.gov.cn/icity/uinfo");
    $("#zcxx").text("退出");
    $("#zcxx").attr("href","javascript:logout();");
    var nowlasturl = /[^/]*$/.exec(window.location.href)[0];
    if(nowlasturl.indexOf("t") == 0 && nowlasturl.indexOf("_") > 0){
    addTrack();
    }
    }
    },
    error : function(result) {
    }
    });
    }else{
    $("#zcxx").attr("href",(result.link[0].url+window.location.href).replace("amp;",""));//给注册赋值
    $("#dlxx").attr("href",(result.link[0].url+window.location.href).replace("amp;",""));
    }
        },
        error : function(result) {
        }
    });
}
userInfoByKey();
function logout(){
	$.ajax({
		type: "get",//方法类型
		dataType: "json",//预期服务器返回的数据类型
		url: "/fsp/login/ucBinLogout.do" ,//url
		contentType:"application/json",
		beforeSend: function (XMLHttpRequest) {
		XMLHttpRequest.setRequestHeader("SSOSign", SSOSign);
		},
		success: function (result) {
			if(result.code==200){
				localStorage.removeItem("SSOSign");
				window.location.href=(result.datas+window.location.href);
				alert(result.msg);
			}
		},
		error : function(result) {
			alert("退出失败，请稍后再试");
		}
	});
}
</script>
