                    $(".gqzc").css("display", "none")
                    $(".gqzc").eq(i - 1).css("display", "block")
                    $(".tab span").removeClass("tab_now")
                    $(".tab span").eq(i).addClass("tab_now")
                    console.log(i)
                    if ($(this).attr("id") == "gqdt") {
                        $("#more").attr("href", "/shgzw_zxzx_gqdt/");
                    } else if ($(this).attr("id") == "shzr") {
                        $("#more").attr("href", "/shgzw_gqzc_shzr/");
                    }
                })
            })
        })
    </script> 
