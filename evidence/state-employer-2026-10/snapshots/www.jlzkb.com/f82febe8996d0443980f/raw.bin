                <td style="text-align:center;">
<style type="text/css">
div,ul,li,a,img{margin: 0;padding: 0;}
  	img{border:0 none;}
    .banner{position:relative;width: 266px;height: 210px;overflow: hidden;}
	.banner ul{list-style:none;}
    .img{position: relative;top: 0;left: 0;}
    .img li{float: left;}
    .num{position: relative;height:10%;bottom: 15px;width: 100%;text-align: center;font-size: 0;left:40%;}
    .num li{width: 10px;height: 10px;background:rgba(0,0,0,0.5);display: block;border-radius: 100%;display: inline-block;margin: 0 5px;cursor: pointer;float:left;background:black;}
    .btn{display: none;}
    .btn span{display: block;width: 30px;height: 30px;background: rgba(0,0,0,0.6);color: #fff;font-size: 30px;line-height: 30px;text-align: center;cursor:pointer;}
    .btn .prev{position: absolute;left: 0;top: 40%;}
    .btn .next{position: absolute;right: 0;top: 40%;}
    .num .active{background-color: #fff;}

 .infoList{position: absolute;bottom: 0px;left:0;}
  .infoList a{color:black;}
  .infoList li{display: none;text-align:center;}
  .infoList .infoOn{display: inline;}
</style>

<div class="banner">
  <ul class="img">
	<li><a href="tpxwdetail.vm?path=L-iAg-ivleWKqOaAgS_lm77niYfmlrDpl7svYmQwMDM4ZTgtYzJjNy00NmNjLWE4NTItMzZiN2U4YTIxNDQ4"><img src="bin.bin?path=L-iAg-ivleWKqOaAgS_lm77niYfmlrDpl7svYmQwMDM4ZTgtYzJjNy00NmNjLWE4NTItMzZiN2U4YTIxNDQ4&field=5Zu-54mH" style="width:266px;height:190px;"/></a></li>
  </ul>
  <ul class="num"></ul> 
  <div class="btn">
    <span class="prev">&lt;</span>
    <span class="next">&gt;</span>
  </div>
   <ul class="infoList"><!-- 图片左下角文字信息部分 -->
	<li><a href="tpxwdetail.vm?content=L-iAg-ivleWKqOaAgS_lm77niYfmlrDpl7svYmQwMDM4ZTgtYzJjNy00NmNjLWE4NTItMzZiN2U4YTIxNDQ4" title="中华人民共和国人力资源和社会保障部令 第31号">中华人民共和国人力资源和社会保障部令 第...&nbsp;&nbsp;&nbsp;</a></li>
   </ul>
</div>

<script type="text/javascript">
  
  $(function(){
 
    var i=0;
    var timer=null;
    for (var j = 0; j < $('.img li').length; j++) {  //创建圆点
      $('.num').append('<li></li>')
    }
    $('.num li').first().addClass('active'); //给第一个圆点添加样式
 
    var firstimg=$('.img li').first().clone(); //复制第一张图片
    $('.img').append(firstimg).width($('.img li').length*($('.img img').width())+$('.img img').width()); //将第一张图片放到最后一张图片后，设置ul的宽度为图片张数*图片宽度
 
 
    // 下一个按钮
    $('.next').click(function(){
      i++;
      if (i==$('.img li').length) {
        i=1; //这里不是i=0
        $('.img').css({left:0}); //保证无缝轮播，设置left值
      };

      $('.img').stop().animate({left:-i*266},300);
      if (i==$('.img li').length-1) {   //设置小圆点指示
        $('.num li').eq(0).addClass('active').siblings().removeClass('active');
		$(".infoList").find("li").removeClass("infoOn").eq(0).addClass("infoOn");
      }else{
        $('.num li').eq(i).addClass('active').siblings().removeClass('active');
		$(".infoList").find("li").removeClass("infoOn").eq(i).addClass("infoOn");
      }
       
    })
 
    // 上一个按钮
    $('.prev').click(function(){
      i--;
      if (i==-1) {
        i=$('.img li').length-2;
        $('.img').css({left:-($('.img li').length-1)*266});
      }
      $('.img').stop().animate({left:-i*266},300);
      $('.num li').eq(i).addClass('active').siblings().removeClass('active');
	  $(".infoList").find("li").removeClass("infoOn").eq(i).addClass("infoOn");
    })
 
    //设置按钮的显示和隐藏
    $('.banner').hover(function(){
      $('.btn').show();
    },function(){
      $('.btn').hide();
    })
 
    //鼠标划入圆点
    $('.num li').mouseover(function(){
      var _index=$(this).index();
      $('.img').stop().animate({left:-_index*266},150);
      $('.num li').eq(_index).addClass('active').siblings().removeClass('active');
	  $(".infoList").find("li").removeClass("infoOn").eq(_index).addClass("infoOn");
    })
 
    //定时器自动播放
    timer=setInterval(function(){
      i++;
      if (i==$('.img li').length) {
        i=1;
        $('.img').css({left:0});
      };
 
      $('.img').stop().animate({left:-i*266},300);
      if (i==$('.img li').length-1) { 
        $('.num li').eq(0).addClass('active').siblings().removeClass('active');
		$(".infoList").find("li").removeClass("infoOn").eq(0).addClass("infoOn");
      }else{
        $('.num li').eq(i).addClass('active').siblings().removeClass('active');
		$(".infoList").find("li").removeClass("infoOn").eq(i).addClass("infoOn");
      }
    },2000)
 
    //鼠标移入，暂停自动播放，移出，开始自动播放
    $('.banner').hover(function(){ 
      clearInterval(timer);
    },function(){
      timer=setInterval(function(){
      i++;
      if (i==$('.img li').length) {
        i=1;
        $('.img').css({left:0});
      };
 
      $('.img').stop().animate({left:-i*266},300);
      if (i==$('.img li').length-1) { 
        $('.num li').eq(0).addClass('active').siblings().removeClass('active');
		$(".infoList").find("li").removeClass("infoOn").eq(0).addClass("infoOn");
      }else{
        $('.num li').eq(i).addClass('active').siblings().removeClass('active');
		$(".infoList").find("li").removeClass("infoOn").eq(i).addClass("infoOn");
      }
    },2000)
    })
 
  })


  </script>
