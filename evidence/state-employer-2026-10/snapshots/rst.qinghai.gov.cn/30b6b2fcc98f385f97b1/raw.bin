	<script type="text/javascript"> 
    var st = jQuery(".slideBox").slide( { mainCell:".bd ul",autoPlay:true} );
    jQuery(document).ready(function(){
        var s= $('#sidebar').offset().top;
        $(window).scroll(function(){			   
