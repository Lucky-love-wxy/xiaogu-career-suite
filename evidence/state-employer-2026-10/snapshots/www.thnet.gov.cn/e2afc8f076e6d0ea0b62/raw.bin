                var url = "/postmeta/i/19389.json";
                $.ajax({
                  type: "get",
                  url: url,
                  dataType: "json",
                  async: false,
                  success: function (data) {
                    var len = data.articles.length;
                    var _in = 0;
                    for (var i = 0; i <= len; i++) {
                      var html;
                      if (_in < 5) {
                        var tp = data.articles[i];
                        var _cover = tp.cover;
                        var str = tp.title;
                        var len1 = tp.title.length;
                        if (_cover) {
                          if (len1 > 22) {
                            str = str.substr(0, 22) + '...';
                            html = '<div class="s1Tpxw_nr " style="float: left; width: 438px;">';
                            html += '<div class="pic"><a href="' + tp.url + '" target="_blank"><img src="' + tp.cover + '"></a></div>';
                            html += '<div class="txt"><h5><a href="' + tp.url + '" target="_blank" title="' + tp.title + '">' + str + '</a></h5><p>' + tp.abstract + '</p></div></div>';
                            $('.s1_TPxw').append(html);//首页轮播
                            _in++;
                          } else {
                            html = '<div class="s1Tpxw_nr " style="float: left; width: 438px;">';
                            html += '<div class="pic"><a href="' + tp.url + '" target="_blank"><img src="' + tp.cover + '"></a></div>';
                            html += '<div class="txt"><h5><a href="' + tp.url + '" target="_blank" title="' + tp.title + '">' + str + '</a></h5><p>' + tp.abstract + '</p></div></div>';
                            $('.s1_TPxw').append(html);//首页轮播
                            _in++;
                          }
                        }
                      } else {
                        break;
                      }

                    }

                  }
                });

