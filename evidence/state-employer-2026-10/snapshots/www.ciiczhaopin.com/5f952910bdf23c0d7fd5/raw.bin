<script>
    new Vue({
        el: '#link',
        data: function () {
            return {
                linksTab: [
                    { label: "友情链接", name: "betterLink" },
                    // { label: "热门职位", name: "hotPosition" },
                    // { label: "热招企业", name: "hotEnterprise" },
                ],
                activeLinkName: 'betterLink',
                showAll: false,
                isRedirect: true,
                linkData: []
            }
        },
        computed: {
            showList: function () {
                if (this.showAll == false) {
                    //不显示全部数据
                    var showList = []; //空数组
                    if (this.linkData.length > 10) {
                        //只显示10条
                        for (var i = 0; i < 10; i++) {
                            showList.push(this.linkData[i]); //将数组的前10条存放到showList数组中
                        }
                    } else {
                        showList = this.linkData; //个数足够显示，不需要在截取
                    }
                    return showList;
                } else {
                    //显示全部数据
                    return this.linkData;
                }
            },
            word: function () {
                //点击显示部分
                if (this.showAll == false) {
                    this.isRedirect = true;
                    return "展开";
                } else {
                    this.isRedirect = false;
                    return "收起";
                }
            }
        },
        mounted() {
            this.linkData = friendlyLink;
        },
        methods: {
            handleLinkClick() {

            }
        }
    })
</script>

