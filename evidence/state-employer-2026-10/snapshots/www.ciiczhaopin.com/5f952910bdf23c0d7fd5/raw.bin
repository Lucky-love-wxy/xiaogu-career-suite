    <div class="footer">
<style>
    .footer-link {
        width: 100%;
        height: auto;
        background: #fff;
    }
    .footer-link .footer-container {
        max-width: 1200px;
        margin: 0 auto;
    }
    .footer-link .footer-wrap {
        z-index: 999;
        background: #1e2b47;
        padding: 20px 0;
    }
    .footer-link .footer-content {
        display: flex;
        width: 100%;
        flex-direction: column;
    }
    .footer-link .content-top {
        width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        margin-bottom: 35px;
    }
    .footer-link .conpany-message {
        display: flex;
        width: 88%;
        justify-content: space-around;
    }
    .footer-link .message-item {
        width: 25%;
    }
    .footer-link .message-name {
        font-size: 16px;
        line-height: 46px;
        color: #fff;
        letter-spacing: 1.14px;
    }
    .footer-link .message-name-item {
        font-size: 14px;
        display: flex;
        color: rgba(255, 255, 255, 0.65);
        font-weight: 400;
        line-height: 30px;
    }
    .footer-link a {
        margin-right: 10px;
        text-decoration: none;
    }
    a:hover {
        color: #2185ff;
    }
    .footer-link .qrCode {
        width: 10%;
        margin-top: 15px;
    }
    .footer-link .qrCodeImg {
        display: block;
        width: 122px;
        height: 122px;
    }
    .footer-link .account {
        line-height: 30px;
        color: rgba(255, 255, 255, 0.65);
        text-align: center;
        font-weight: 400;
    }
    .footer-link .line {
        width: 100%;
        height: 1px;
        background: rgba(255,255,255,0.20);
        margin-bottom: 35px;
    }
    .footer-link .content-bottom {
        width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
    }
    .footer-link .license {
        display: flex;
        font-size: 14px;
