<script>
  var menu = "首页";
  let appHeader = new Vue({
    el: '#appHeader',
    data: function () {
      return {
        isLogin: false,
        mobile: '',
        name: '',
        gender: '男',
        avatar: '',
        userInfoReady: false,
        cityArr: ['上海', '广州', '深圳'],
        personArr: [
          '个人中心', '我的简历', '我的申请', '账号设置', '退出登录'
        ],
        active: menu,
        subMenu: [{name: '空宣', url: '/oct/index'}]
      }
    },
    created() {
      window.addEventListener("updateUserInfo", () => {
        localStorageSet('userInfo', null);
        this.getMyUserInfo();
      });
    },
    beforeDestroy() {
      window.removeEventListener("updateUserInfo");
    },
    mounted() {
      let that = this;
      document.addEventListener(NOTOKEN, function() {
        that.isLogin = false;
      });
      document.addEventListener(TOKEN_CHANGE, function() {
        that.isLogin = true;
        that.getMyUserInfo();
      });
      document.addEventListener('updateHeader', function() {
        that.getMyUserInfo();
      });
    },
    methods: {
      getMyUserInfo() {
        if (this.isLogin) {
          Axios.get('/api/person/getMyUserInfo').then(res => {
            // console.log('UserInfo', res)
            if (res.code == 401) {
              this.login();
              return;
            }
            localStorageSet('userInfo', res.result);
            this.mobile = res.result.mobile;
            this.name = res.result.name;
            this.gender = res.result.gender;
            this.avatar = res.result.avatar;
            this.userInfoReady = true;
          });
        }
      },
      login() {
        if (config) {
            if (location.href.toLowerCase().indexOf('jobfair') >= 0) {
                window.location.href = config.ssoCandidatePcUrl + '?backurl=' + encodeURIComponent(window.location.href) + '&registerPlatform=' + PLATFORM + '&registerSource=' + JFSOURCE;
            } else {
                window.location.href = config.ssoCandidatePcUrl + '?backurl=' + encodeURIComponent(window.location.href) + '&registerPlatform=' + PLATFORM +
                        '&registerSource=' + (registerSource || SOURCE) + '&registerSourceId=' + registerSourceId;
            }
        }
      },
      companylogin() {
        if (config){
            window.location.href = config.ssoCompanyUrl + '?registerPlatform=' + COMPANY_PLATFORM +
                    '&registerSource=' + (registerSource || SOURCE) + '&registerSourceId=' + registerSourceId;
        }
      },
      gotoPage(url) {
        if (menu == '机构站点' && url == '/area/changeSite') {
          return;
        }
        // openPage(url, false);
        openPage(url);
      },
      openPage(url) {
        openPage(url);
      },
      handleCommand(item) {
        if (item == '退出登录') {
          sso.logout();
          window.location.href = '/';
        } else if (item == '个人中心') {
          openPage('/personal/index', false);
        } else if (item == '我的简历') {
          openPage('/personal/resume-edit', false);
        } else if (item == '我的申请') {
          openPage('/personal/myapplied', false);
        } else if (item == '账号设置') {
          openPage('/personal/account', false);
        }
      }
    }
  })
</script>

