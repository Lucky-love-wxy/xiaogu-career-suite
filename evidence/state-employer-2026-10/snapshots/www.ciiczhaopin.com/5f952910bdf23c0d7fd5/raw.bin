<script type="text/javascript" src="/common/http-vue-loader.js"></script>
<script>
    Vue.use(httpVueLoader); // 引入 http-vue-loader

    let infoSource = getQueryString('infoSource');
    let infoSourceId = getQueryString('infoSourceId');
    let registerSource = getQueryString('registerSource');
    let registerSourceId = getQueryString('registerSourceId');
    // let registerPlatform = PLATFORM;

    function openPage(url, isNew = true, infoS = infoSource, infoSId = infoSourceId, rs = registerSource, rsId = registerSourceId) {
        let str = url;
        if (infoS) {
            if (str.includes('?')) {
                str += '&infoSource=' + infoS
            } else {
                str += '?infoSource=' + infoS
            }
        }
        if (infoSId) {
            if (str.includes('?')) {
                str += '&infoSourceId=' + infoSId
            } else {
                str += '?infoSourceId=' + infoSId
            }
        }
        if (rs) {
            if (str.includes('?')) {
                str += '&registerSource=' + rs
            } else {
                str += '?registerSource=' + rs
            }
        }
        if (rsId) {
            if (str.includes('?')) {
                str += '&registerSourceId=' + rsId
            } else {
                str += '?registerSourceId=' + rsId
            }
        }
        if (isNew) {
            window.open(str);
        } else {
            window.location.href = str;
        }
    }
</script><script>
  // document.addEventListener(NOTOKEN, function() {
  //   console.log('NOTOKEN');
  // });
  // document.addEventListener(TOKEN_CHANGE, function() {
  //   console.log('TOKEN_CHANGE');
  // });
  // document.addEventListener(REFRESH, function() {
  //   console.log('REFRESH');
  // });

  // 读取各端host并保存1天
  window.config = window.config || localStorageGet('config');
  if (!config) {
    Axios.get('/api/common/getUrls').then(res => {
      if (res.code == 0) {
        localStorageSet('config', res.result, 1);
        config = res.result;
        sso.init(res.result.ssoCandidatePcUrl.split('/jstlogin')[0], SITE);
        console.log('sso init')
      }
    })
  } else {
      setTimeout(() => {
          sso.init(config.ssoCandidatePcUrl.split('/jstlogin')[0], SITE);
          console.log('sso init')
      }, 500);
  }
</script>

