                <div class="city-tab">
                    <span :class="{
                        'active': item.active
                    }" v-for="item in citysList" @click="selectCity(item)">{{item.label}}</span>
                </div>
                <span class="more-position" @click="window.openPage('/position/list', true)">更多城市></span>
           </div>
            <div class="position-list-ctnr zplb-content">
                <div class="content-ctnr" style="width: 890px;">
                  <div class="ctnr-left" >
                    <div class="main-inner-container">
                      <ul class="position-info-list" v-if="zplbList&&zplbList.length>0">
                        <li class="position-info-item" v-for="item in zplbList" :key="item.uuid">
                          <div class="info-primary">
                          
                            <div class="primary-wrapper" @click="gotoPcLink(item)">
                            <div class="job-title">
                                <h3 class="job-name ellipsis">
                                    <a href="javascript:void(0);" :title="item.jobname_show" >{{item.jobname_show}}</a>
                                </h3>
                                <!-- <span class="job-status isTop" v-if="item.istop">置顶</span> -->
                                <span class="job-status isHot" v-if="item.ishot">热门</span>
                                <span class="job-status isJx" v-if="item.postwholenature === '见习'">见习</span>
                                <span class="job-status isXz" v-else-if="item.worknature === '校招'">校招</span>
                                <span class="publish-time">{{item.publishtime|filterTime}}</span>
                            </div>
                            <div class="job-limit">
                                <span class="job-salary ellipsis" v-if="item.ifface_show && item.ifface_show == '1'">
                                    <span>面议</span>
                                </span>
        
                                <span class="job-salary ellipsis"v-else-if="item.sallow_show && item.salup_show && item.salunit_show && item.salunit_show == '日薪'"  :title="(item.sallow_show || '')+'-'+(item.salup_show || '')+'元/天'"> {{ item.sallow_show || '' }}-{{ item.salup_show || '' }}元/天</span>

                                <span class="job-salary ellipsis" v-else-if="item.sallow_show && item.salup_show && item.salunit_show && item.salunit_show == '月薪'"  title="">{{ item.sallow_show || '' }}-{{ item.salup_show || '' }}</span>

                                <span class="job-salary ellipsis" v-else-if="item.sallow_show" title="以上">{{item.sallow_show}}以上</span>
        
                                <span class="job-salary ellipsis" v-else-if="item.salup_show" title="以下">{{item.salup_show}}以下</span>
                               
                                <i class="vline" v-if="item.workplace_show"></i>
                                <span class="job-address ellipsis"  :title="item.workplace_show|filterCity">
                                    {{item.workplace_show|filterCity}}
                                </span>
        
                                <i class="vline" v-if="item.workexp_show"></i>
                                <span class="job-years ellipsis" :title="item.workexp_show">
                                    {{item.workexp_show}}
                                </span>
        
        
                                <i class="vline" v-if="item.education_show"></i>
                                <span :title="item.education_show" class="job-education ellipsis" title="">
                                    {{item.education_show}}
                                </span>
        
        
                                <i class="vline"></i>
                                <span class="job-recruitment-number ellipsis" :title="'招聘'+item.recnum_show+'人'">
                                招聘{{item.recnum_show}}人
                                </span>
        
                            </div>
                            </div>
          
                            <div class="info-company"  @click="window.openPage('/company/companyDetail?companyUUid=' + (item.companyUUid ? item.companyUUid : item.orgid))">

                                <div class="company-text">
                                    <h3>
                                        <a class="ellipsis" :title="item.orgname_show?item.orgname_show:'未知'" href="javascript:void(0);">{{item.orgname_show?item.orgname_show:'未知'}}</a>
                                    </h3>
                                    <p>
                                    <span class="ellipsis" :title="item.industry" style="max-width: 118px;">{{item.industry}}</span>
                                    <i class="vline" v-if="item.qualitative"></i>
                                    <span :title="item.qualitative" class="ellipsis" style="max-width: 92px;">
                                        {{item.qualitative}}
                                    </span>
                                    <i class="vline" v-if="item.scale"></i>
                                    <span class="ellipsis" :title="item.scale" style="max-width: 84px;">
                                        {{item.scale}}
                                    </span>
            
                                    </p>
                                </div>
                                <div class="company-logo-container">
                                    <a href="javascript:void(0);">
            
                                    <img v-if="item.orglogo_show" class="carousel-img" :src="item.orglogo_show" alt="logo" />
            
                                    <img v-else src="/images/home/emptyImg.svg" alt="logo" />
            
                                    </a>
                            </div>
                            </div>
                          
                          </div>
                          <div class="info-append">
                            <div class="tags">
                                <template v-for="hlsItem in item.highlights_show">
                                    <span class="zqj-light" v-if="hlsItem == '藏青疆专招'">藏青疆专招</span>
                                    <span class="disability-light" v-else-if="hlsItem == '残疾人专招'">残疾人专招</span>
                                    <span class="hxhd-light" v-else-if="hlsItem == '海峡专招'">海峡专招</span>
                                    <span v-else>{{hlsItem}}</span>
                                </template>
                                <span v-if="item.isEllipsis">...</span>
                                <!-- <div class="highlightPop">
                                    <span></span>
                                </div> -->
                          
                            </div>
                            <div class="info-desc">
                              <div class="inner-info-desc" v-if="item.attr === 'dlzp'" >
                                <span class="welfareItem-text"><span style="color: #2185ff;">委托代招：{{item.clientname}}</span></span>
                              </div>
                              <div class="inner-info-desc" v-else>
                                <span class="welfareItem-text" title="">{{item.livelihoodwelfare_show}}</span>
                              </div>
                            </div>
          
                            <div class="btns-container">
                              <div class="applyPost-btn">
                                <el-button class="primary-btn" @click="gotoPcLink(item)">申请职位</el-button>
                                <!-- <el-button class="disabled-btn" disabled style="display: none;">已申请</el-button> -->
                              </div>
                            </div>
                          </div>
                        </li>
                      </ul>
                      <div class="noData" v-else>
                        <img src="/images/position/搜索为空.png" alt="empty" style="width: 150px; height: 96px;" />
                        <span style="font-size: 14px;">暂时没有符合该搜索条件的职位</span>
                        <span style="font-size: 12px;margin-top: 5px;">请重新修改搜索条件后再进行搜索</span>
                    </div>
                    </div>
                 
                  </div>
                </div>
              </div>
        </div>
