<script>
    var app = new Vue({
        el: '#appIndex',
        components: { // 标签全小写，变量和事件全小写
            'category': httpVueLoader('/components/category.vue'),
            'advertisement': httpVueLoader('/components/advertisement.vue'),
            'specialad': httpVueLoader('/components/specialAdvertisement.vue'),
            'warningdialog': httpVueLoader('/components/outsideWarningDialog.vue')
            // 'qzfuandqyfw': httpVueLoader('/components/qzfuAndqyfw.vue')
        },
        data() {
            return {
                noticeList: [],
                currTabName: '热招职位',
                cityValue: '',
                propModifyName:{
                    isTop: 'istop',
                    publishTime: 'publishtime',
                    jobName:'jobname_show',
                    organizationName:'orgname_show',
                    livelihoodWelfare:'livelihoodwelfare_show',
                    education:'education_show',
                    workPlace:'workplace_show',
                    workExp:'workexp_show',
                    recruitmentNum:'recnum_show',
                    highlights:'highlights_show',
                    salUp:'salup_show',
                    salLow:'sallow_show',
                    industry:'industry_show',
                    scale:'scale_show',
                    logoFileId:'orglogo_show',
                    ifFace:'ifface_show',
                    uuid:'id',
                    isToJumpShow: 'istojump_show',
                    pcLinkShow:'pclink_show',
                    salUnit:'salunit_show',
                    clientName:'clientname',
                    isHot: 'ishot',
                    isTop:'istop',
                    '校招':'worknature',

                },
                zplbList: [],
                tabList:[
                    {
                        label:'热招',
                        active:true,
                    },
                    {
                        label:'最新',
                        active:false,
                    },
                    {
                        label:'社招',
                        active:false,
                        value: '社招|全职,社招|兼职'
                    },
                    {
                        label:'校招',
                        active:false,
                        value: '校招|全职,校招|兼职,校招|实习,校招|见习',
                        prop: 'nature'
                    },
                    {
                        label:'灵活用工',
                        active:false,
                        value: ''
                    },
                    {
                        label:'境外就业',
                        active:false,
                        value: '海外',
                        prop:'workplace'
                    },
                    {
                        label:'企业（央国企）自招',
                        active:false,
                        value: '中央企业,国有企业',
                        prop:'qualitative'
                    },
                ],
                citysList: [
                {
                    label: '境外',
                    active:false,
                    value:'海外'
                },
                {
                    label: '北京',
                    active:false,
                    value:'北京'
                },
                {
                    label: '上海',
                    active:false,
                    value: '上海'
                },
                {
                    label: '广州',
                    active:false,
                    value: '广州'
                },
                {
                    label: '深圳',
                    active:false,
                    value: '深圳'
                },
                {
                    label: '成都',
                    active:false,
                    value: '成都'
                },
                {
                    label: '西安',
                    active:false,
                    value: '西安'
                },
                {
                    label: '南京',
                    active:false,
                    value: '南京'
                },
                {
                    label: '沈阳',
                    active:false,
                    value: '沈阳'
                },
                {
                    label: '杭州',
                    active:false,
                    value: '杭州'
                },
                ],
                isLogin: false,
                mobile: '',
                formInline: {
                    keyword: "",
                    zwnature: "",
                },
                // 判断是否吸顶
                headerFixed: 0,
                jobTypeList: [
                    {codeId: '', name: "全部职位"},
                    {codeId: '社招', name: "社招职位"},
                    {codeId: '校招', name: "校招职位"}
                ],
                // hotJobList: [
                //     {id: 20001, name: "法务"},
                //     {id: 20002, name: "IOS"},
                //     {id: 20003, name: "产品经理"},
                //     {id: 20004, name: "大数据"}
                // ],
                categoryData: [],
                bannerList: [], // 轮播图
                bannerReady: false,
                adData: [], // 广告
                specialAdData: [], // 专题广告
                tabList1: [
                    {label: "热招职位", name: "hotPosts"},
                    {label: "最新职位", name: "newPosts"}
                ],
                tabList2: [
                    {label: "热门公司", name: "hotCompanies"},
                    // {label: "央国企", name: "centralStateOwnedEnterprises"}
                ],
                compName1: "hotPosts",
                compName2: "hotCompanies",
                link: '',
                warningDialogVisible: false
            }
        },
        async mounted() {
            const category = await getDictByKey(CIIC_DICT_KEY.职位类别);
            this.categoryData = arrayToTree(category, "ZWLB");
            this.getAdvertise();
            this.getHotJob();
            this.getQueryByTypeTZGS();
        },
        filters: {
            filterTime(time) {
                return time?new Date(time).Format("yyyy-MM-dd"):''
            },
            filterCity(city) {
                return city? city.replace(/-/g, '|'):'';
            }
        },
        methods: {
            getQueryByTypeTZGS() {
                // 获取通知公示
                Axios.get('/api/consult/getQueryByTypeTZGS?channel=0').then((res) => {
                    if (res.code == 0) {
                        this.noticeList = res.result.slice(0, 5);
                    }
                })
            },
            selectCity(item) {
                this.citysList.map((value) => {
                    value.active = false
                })
                this.cityValue = item.value
                item.active = true
                if (this.currTabName === '热招') {
                    this.getHotJob()
                } else if (this.currTabName === '最新') {
                    this.getNewJob()
                } else {
                   this.getSearch() 
                }
            },
            positionTab(item) {
                this.tabList.map((value) => {
                    value.active = false;
                })
                this.citysList.map((cvalue) => {
                    cvalue.active = false;
                })
                this.cityValue = '';
                item.active = true;
                this.currTabName = item.label;
                this.currTabValue = item.value;
                if (item.label === '热招') {
                    this.getHotJob()
                } else if (item.label === '最新') {
                    this.getNewJob()
                } else if (item.label === '灵活用工') {
                    this.zplbList = []
                } else {
                   this.getSearch() 
                }
            },
            getSearch() {
                let nature, qualitative;
                let workplace = this.cityValue;
                if (['社招','校招'].includes(this.currTabName)) {
                    nature = this.currTabValue;
                    qualitative = '';
                } else if (['企业（央国企）自招'].includes(this.currTabName)) {
                    nature = '';
                    qualitative = this.currTabValue;
                } else if (['境外就业'].includes(this.currTabName)) {
                    if (this.cityValue)
                        workplace = this.cityValue + ',' + this.currTabValue;
                    else
                        workplace = this.currTabValue;
                }
                Axios.post('/api/position/search',{"page":1,"size":6,"keyword":"","workplace":workplace,"industry":"","jobcate":"","qualitative":qualitative,"education":"","salary":"","scale":"","workexp":"","attr":"","disability":"","nature":nature,"toppingcity":"","id":"","orgid":"","orgcity_or":null,"workplace_or":null}).then((res) => {
                    if (res.code == 0) {
                        res.result.result.map((item) => {
                            item.tempHls = item.highlights_show?item.highlights_show.split(','):[]
                            item.highlights_show = item.highlights_show?item.highlights_show.split(',').splice(0,3):[]
                            item.isEllipsis = item.tempHls.length>3?true:false
                        })
                        this.zplbList = res.result.result;
                    }
                    
                })
            },
            gotoPcLink(item) {
                if (item.istojump_show == '1'&&item.pclink_show) {
                    this.link = item.pclink_show;
                    this.warningDialogVisible = true;
                } else {
                    window.openPage('/position/detail?uuid='+item.id)
                }
            },
            getNewJob() {
                Axios.get("/api/recruit/getNewJob?city="+this.cityValue).then(res => {
                    if (res.code == 0 && res.result) {
                    res.result.map((item) => {
                        Object.keys(this.propModifyName).map((itemC) => {
                            if (this.propModifyName[itemC] === 'highlights_show') {
                                item.tempHls = item[itemC]?item[itemC].split(','):[]
                                item[this.propModifyName[itemC]] = item[itemC]?item[itemC].split(',').splice(0,3):[]
                                item.isEllipsis = item.tempHls.length>3?true:false
                            } else {
                                item[this.propModifyName[itemC]] = item[itemC]
                            }
                           
                        })
                    })
                    this.zplbList = res.result&&res.result.length>1?res.result.splice(0,6):[];
                }
                }).catch(err => {
                    console.error("获取热门职位失败", err);
                })
            },
            getHotJob() {
                Axios.get("/api/recruit/getHotJob?city="+this.cityValue).then(res => {
                    if (res.code == 0 && res.result) {
                    res.result.map((item) => {
                        Object.keys(this.propModifyName).map((itemC) => {
                            if (this.propModifyName[itemC] === 'highlights_show') {
                                item.tempHls = item[itemC]?item[itemC].split(','):[]
                                item[this.propModifyName[itemC]] = item[itemC]?item[itemC].split(',').splice(0,3):[]
                                item.isEllipsis = item.tempHls.length>3?true:false
                            } else {
                                item[this.propModifyName[itemC]] = item[itemC]
                            }
                           
                        })
                    })
                    this.zplbList = res.result&&res.result.length>1?res.result.splice(0,6):[];
                }
                }).catch(err => {
                    console.error("获取热门职位失败", err);
                })
            },
          
            scrollEvent() {
                // 获取吸顶元素的dom
                const menu = this.$refs.homeSearch;
                const home = this.$refs.home;
                // 吸顶元素到top的距离
                this.offsetTop = menu.offsetTop;
                // 元素自身的高度
                this.offsetHeight = menu.offsetHeight;
                // 获取页面滚动的距离 兼容写法
                const scrollTop = home.scrollTop;
                // 判断页面的滚动距离是否大于吸顶元素的位置
                this.headerFixed =
                    scrollTop <= 0 ? false : scrollTop > this.offsetTop - this.offsetHeight;
            },
            //选择区域
            changeArea(val) {
                this.formInline.region = val;
            },
            //搜索
            onSubmit(value) {
                openPage('/position/list?keyword=' + encodeURIComponent(value.keyword) +
                    '&worknature=' + encodeURIComponent(value.zwnature), false);
            },
            //点击职职位跳转职位列表
            toProfession(val) {
                openPage('/position/list?jobcate=' + encodeURIComponent(val), false);
            },
            //全部职类跳转
            allProfession() {
                openPage('/position/list', false);
            },
            homeBannerClick(item) {
                // zhugeEventTrack('首页-顶部banner', {
                //     '主题名称': item.themeName,
                //     '广告位ID': item.id,
                // })
            },
            //热门企业 央国企 切换
            handleClick2(tab, event) {
                this.compName2 = tab.name;
                console.log('this.compName2', this.compName2);
            },
            // hotJobItemClick(item) {
                // zhugeEventTrack('首页-推荐企业', {
                //     '企业类型': '热门企业',
                //     '企业ID': item.tenantId,
                //     '企业名称': item.tenantName
                // })
            // },
            // tenantNameClick() {
            //
            // },
            //热招职位，最新职位切换
            handleClick1(tab, event) {
                this.compName1 = tab.name;
            },
            postNameClick(uuid, isToJumpShow, pcLinkShow) {
                if (isToJumpShow == '1' && pcLinkShow) {
                    this.link = pcLinkShow;
                    this.warningDialogVisible = true;
                } else {
                    openPage('/position/detail?uuid=' + uuid, false);
                }
            },
            getAdvertise() {
                Axios.get('/api/content/pageInfoCache?pageNo=homepagePC').then(res => {
                    // console.log('pageNo=/index', res)
                    if (res.code == 0 && res.result && res.result.areaInfoMap) {
                        // 头部banner
                        if (res.result.areaInfoMap['focuspicturepc01']) {
                            let tmpList = [];
                            res.result.areaInfoMap['focuspicturepc01'].blankInfos.map(item => {
                                if (item.propertyMap) {
                                    let banner = item.propertyMap;
                                    tmpList.push(banner);
                                }
                            });
                            this.bannerList = tmpList;
                            this.bannerReady = true;
                        }

                        // 腰部广告
                        if (res.result.areaInfoMap['bannerpc02pc06']) {
                            let tmpList2 = [];
                            res.result.areaInfoMap['bannerpc02pc06'].blankInfos.map(item => {
                                if (item.propertyMap) {
                                    let ad = item.propertyMap;
                                    tmpList2.push(ad);
                                } else {
                                    tmpList2.push({});
                                }
                            });
                            this.adData = tmpList2.filter((item, i) => {return i<=2 || (i>=5 && i<=7) || (i>=10 && i<=12) || (i>=15 && i<=17);});
                            this.specialAdData = tmpList2.filter((item, i) => {return i==3 || i==4 || i==8 || i==9 || i==13 || i==14 || i==18 || i==19;});
                        }
                        // console.log(this.adData);
                        // console.log(this.specialAdData);
                    }
                })
            },
            onCompanyClick(uuid) {
                if (uuid) {
                    openPage('/company/companyDetail?companyUUid=' + uuid, false);
                }
            }
        }
    })
</script>



