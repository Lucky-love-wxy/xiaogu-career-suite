<script type="text/javascript">

    var getProvinceAciton = "/wt/crpharma/web/index/webPositionN300!getProvince";
    var getCityInfoByProvinceAction = "/wt/crpharma/web/index/webPositionN300!getCityInfoByProvince";
    var getworkPlaceInfoByCode = "/wt/crpharma/web/index/webPosition210!getworkPlaceInfoByCode";

    $(document).ready(function() {

        $(".chooseDiv").click(function() {
            var _this = $(this);
            var index = _this.attr("data-index");
            $(".chooseDiv").removeClass("cfff").addClass("c333");
            _this.removeClass("c333").addClass("cfff");
            $(".pNavContent-1").hide();
            $(".pNavContent-2").hide();
            $(".pNavContent-3").hide();
            $(".pNavContent-"+index).show();

            if (index==1) {

                $("#province").hide();
                $("#cityEle").hide();

                $("#currentCity").hide();
                $("#currentCity").html("");
                $("#currentCity").attr("data-value", "");

                var provinceList = $(".provinceList");
                $.each(provinceList,function(){
                    this.style="";
                });

            } else if(index==2){

                $("#cityEle").hide();

                $("#currentCity").show();
                $("#currentCity").html("当前选择" + "：" + _this.html());
                $("#currentCity").attr("data-value", _this.attr("data-value"));
            }

        });
        $(".chooseDiv").eq(0).click();

        $(".LocalDataUIC").mouseover(function(event){
            event.stopPropagation();
        });
    });

</script>
    
