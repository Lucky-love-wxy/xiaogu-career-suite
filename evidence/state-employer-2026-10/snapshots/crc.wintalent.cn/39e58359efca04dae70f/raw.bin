                            <img class="fl ml10 border" id="validateImg_pwd" align="middle"
                                src="/wt/crpharma/web/index/webUserLogin!genValidateCodeNew?code2=&operational=4600ccb0d4b1cc000c1051575e586114a82cbb192bb1a4bc3f54f2787edacc6f8caf60c976d93f50dd36bd1dbdf4260cd1b7e4f1edc5cd7b96a2429f1952d78b1cde47e79e2de07f0398bb2640f297b05f77c478463ec0fb"
                                width="70" height="35" border=0 />
                        </div>
                    </div>
                    <a class="bg_btn_orange bg_btn_big lh40 w282 tc block mt20 cfff f18 ml105" id="btn_resetPwd" style="cursor:pointer;margin-bottom: 15px;">确定</a>
                </div>
            </div>

            
            
        
        <!-- 二维码 -->
        
        
