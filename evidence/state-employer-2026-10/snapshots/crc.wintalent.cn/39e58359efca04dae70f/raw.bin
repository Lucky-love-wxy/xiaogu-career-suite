<script type="text/javascript">

    var recruitTypeStr = '1';

        function searchPost() {
            var v_useForm = "";//用工形式
            var v_trademark = 0;//品牌
            var v_kw = "";//关键字
            var v_pn = "";//职位名称
            var v_p = "";//地点
            var v_pt = 0;//职位类型
            var v_t = 0;//招聘时间
            var v_recruitType = 0;//招聘类型
            var lanType = 1;//lanuage
            var brandCode = document.getElementById("brandCode").value;//网站品牌
            var v_cp = "";
            var v_scp = "";
            var v_xj="";
            var v_st="";

            if(null != document.getElementById("siteId")){
                v_st = document.getElementById("siteId").value;
            }
            if (null != document.getElementById("xuanJiangStr")) {
                v_xj = document.getElementById("xuanJiangStr").value;
            }
            if (null != document.getElementById("useFormV")) {
                v_useForm = document.getElementById("useFormV").value;//用工形式
            }
            if (null != document.getElementById("tradeMarkV")) {
                v_trademark = document.getElementById("tradeMarkV").value;//品牌
            }
            if (null != document.getElementById("keyWordV")) {
                if (document.getElementById("keyWordV").value != document.getElementById("keyWordV").title) {
                    v_kw = document.getElementById("keyWordV").value;//关键字
                }
            }
            if (null != document.getElementById("positionNameV")) {
                if (document.getElementById("positionNameV").value != document.getElementById("positionNameV").title) {
                    v_pn = document.getElementById("positionNameV").value;//职位名称
                }
            }
            if (null != document.getElementById("workPlaceNameV")) {
                if (document.getElementById("workPlaceNameV").value != document.getElementById("workPlaceNameV").title) {
                    v_p = document.getElementById("workPlaceNameV").value;//地点
                }
            }

            if (null != document.getElementById("positionTypeV") ) {
                v_pt = document.getElementById("positionTypeV").value;//职位类型
            }
            if (null != document.getElementById("comPartV")) {
                v_cp = document.getElementById("comPartV").value;//公司部门
            }
            if (null != document.getElementById("sicCorpCodeV")) {
                v_scp = document.getElementById("sicCorpCodeV").value;//corpCode企业名
            }
            if (null != document.getElementById("dateV")) {
                v_t = document.getElementById("dateV").value;//招聘时间
            }
            v_recruitType = document.getElementById("recruitType").value;//招聘类型
            if (typeof (v_recruitType) == "undefined") {
                v_recruitType = 0;
            }
            v_pn = encodeURIComponent(v_pn);
            v_p = encodeURIComponent(v_p);
            v_kw = encodeURIComponent(v_kw);

            var surl = "/wt/crpharma/web/json/position/list?operational=4600ccb0d4b1cc000c1051575e586114d3548c5bcccbe179f3509f5a9e5c77fa57a80fd0b74a58d364c6b052c98177b6215ca4e09896a3cc131fd8c4813f8d7c"
                  + "&positionType=" + v_pt
                  + "&comPart=" + v_cp
                  + "&sicCorpCode=" + v_scp
                  + "&brandCode=" + brandCode
                  + "&releaseTime=" + v_t
                  + "&trademark=" + v_trademark
                  + "&useForm=" + v_useForm
                  + "&recruitType=" + v_recruitType
                  + "&projectId="
                  + "&lanType=" + lanType
                  + "&positionName=" + encodeURIComponent(v_pn)
                  + "&workPlace=" + encodeURIComponent(v_p)
                  + "&keyWord=" + encodeURIComponent(v_kw)
                  + "&xuanJiangStr="+v_xj
                  + "&site="+v_st
                  + "&page=" + _currentPage;

            

            getPostList(surl, _currentPage);
        }

        function chooseWorkPlaceAll(obj){

        	var children_a = jQuery(obj).parent().children("a");
            children_a.removeClass("theme_color");
            children_a.removeClass("cfd8d56");
            children_a.removeClass("c333");
            children_a.addClass("c333");

            
            
               $(obj).addClass("cfd8d56");
            

            $(obj).removeClass("c333");

            jQuery("#workPlaceNameV").val("");
            if(null != document.getElementById("xuanJiangStr")){
                jQuery("#xuanJiangStr").val("");
            }
            _currentPage = 1;
            searchPost();
        }

        function chooseWorkPlace(obj){

        	var children_a = jQuery(obj).parent().children("a");
        	children_a.removeClass("theme_color");
        	children_a.removeClass("cfd8d56");
        	children_a.removeClass("c333");
        	children_a.addClass("c333");

            
            
              $(obj).addClass("cfd8d56");
            

            $(obj).removeClass("c333");

            jQuery("#workPlaceNameV").val(jQuery(obj).attr("data-value"));
            if(null != document.getElementById("xuanJiangStr")){
                jQuery("#xuanJiangStr").val("");
            }
            _currentPage = 1;
            searchPost();
        }

        function chooseSiteAll(_this){

            $("#showSecondSite").hide();

            var $_this = $(_this);

            $_this.parent().children("a").attr("class","c333 mr12");
            
            
                $_this.attr("class","cfd8d56 mr12");
            
            $("#siteId").val("");
            $("#siteIdTemp").val("");
            _currentPage = 1;
            searchPost();

        }

        function chooseSite(obj){

            var $_this = $(obj);

            $_this.parent().children("a").attr("class","c333 mr12");
            
            
                $_this.attr("class","cfd8d56 mr12");
            

            var site = $_this.attr("data-value");
            $("#siteId").val(site);
            $("#siteIdTemp").val(site);
            _currentPage = 1;
            searchPost();

            var childArea = $_this.find("input");
            var childSiteTemp = "";
            $.each(childArea, function (index,_this) {

                childSiteTemp += ('<span style="cursor:pointer;"' + ' onclick="chooseChildSite(this)" data-value="'+_this.id+'">' + _this.value+'</span>');


            });

            if(childSiteTemp!=""){
                $("#showSecondSite span").html($_this.find("span").html());
                $("#showSecondSite div").html(childSiteTemp);
                $("#showSecondSite").show();
            } else {
                $("#showSecondSite").hide();
            }


        }

        function closeSiteLevel2 (_this){

            var $_this = $(_this);
            $_this.parent().hide();

            var siteId = $("#siteIdTemp").val();
            $("#siteId").val(siteId);
            _currentPage = 1;
            searchPost();
        }


        function choosePostTypeAll(obj){
            jQuery(obj).parent().children("a").attr("class","c333 mr12");
             
            
              jQuery(obj).attr("class","cfd8d56 mr12");
            
            jQuery("#positionTypeV").val("");
            if(null != document.getElementById("xuanJiangStr")){
                jQuery("#xuanJiangStr").val("");
            }
            _currentPage = 1;
            searchPost();

            if($("#showPostType").css("display")=="block"){
            	$("#showPostType").css("display","none");
        	}else {
        		return "";
        	}
        }

        function choosePostType(obj){
            jQuery(obj).parent().children("a").attr("class","c333 mr12");
             
            
              jQuery(obj).attr("class","cfd8d56 mr12");
            
            jQuery("#positionTypeV").val(jQuery(obj).attr("data-value"));
            if(null != document.getElementById("xuanJiangStr")){
                jQuery("#xuanJiangStr").val("");
            }

            _currentPage = 1;
            searchPost();
            var brandCode = document.getElementById("brandCode").value;
            var postTypeCode = jQuery(obj).attr("data-value");
            var url = "/wt/crpharma/web/index/webPositionN300!getPostType?postTypeCode="+postTypeCode+"&brandCode="+brandCode;
        	$("#showPostType span").html(jQuery(obj).html());
        	$.ajax({
        		type:"POST",
        		dataType:"json",
        		url:url,
        		success:function (jsonStr) {
        			var obj = document.getElementById("showPostType");
        			if(jsonStr.length!=0){
        				       obj.style.display= "block";
        		               var ruleListTemp ="";

        		                $.each(jsonStr, function (n, value) {

        		                   ruleListTemp += ("<span"+" style=\"cursor:pointer;\""+ " onclick=\"chooseChildPostType(this)\" data-value=\""+value.code +"\" href=\"javascript:void(0);\">" + value.name+"</span>");


        		               });

        		               // ruleListTemp += "</div>";

        		               $("#showPostType div").html(ruleListTemp);
        		               set_sec_positions_width();
        			}else{
        				obj.style.display= "none";
        			}


        	 }
        	});

        }

        function closeLevel2 (obj){
        	if(obj.parent().css("display")=="block"){
        		obj.parent().css("display","none");
        	}else {
        		return "";
        	}

        	var postType = $("#positionTypeV").val();
            if(postType!=""){
                var postTypeArr = postType.split("/");
                if(postTypeArr.length>3){
                    postType = postTypeArr[0]+"/"+postTypeArr[1]+"/"+postTypeArr[2];
                    $("#positionTypeV").val(postType);
                    _currentPage = 1;
                    searchPost();
                }
            }
        }

        function set_sec_positions_width() {
        	var sec_title_width = $(".sec_title").width();
            var total_width = $(".listPostType").width();
            $(".search-bar div").width(total_width - sec_title_width - 50);
        }
        function set_sec_site_width() {
            var sec_title_width = $(".sec_title").width();
            var total_width = $(".listSite").width();
            $(".search-bar div").width(total_width - sec_title_width - 50);
        }

        function chooseChildPostType(obj){
        	jQuery(obj).parent().children("span").attr("class","c333 mr12");
            
           
             jQuery(obj).attr("class","cfd8d56 mr12");
           
           jQuery("#positionTypeV").val(jQuery(obj).attr("data-value"));
           if(null != document.getElementById("xuanJiangStr")){
               jQuery("#xuanJiangStr").val("");
           }
           _currentPage = 1;
           searchPost();
        }

        function chooseChildSite(_this){

            var $_this = $(_this);

            $_this.parent().children("span").attr("class","c333 mr12");
            
            
                $_this.attr("class","cfd8d56 mr12");
            
            $("#siteId").val($_this.attr("data-value"));
            _currentPage = 1;
            searchPost();
        }

        function chooseCompanyAll(obj){
        	jQuery(obj).parent().children("a").attr("class","c333 mr12 showOrg");
            
            
              jQuery(obj).attr("class","cfd8d56 mr12 showOrg");
            
            jQuery("#comPartV").val("");
            jQuery("#sicCorpCodeV").val("");
            if(null != document.getElementById("xuanJiangStr")){
                jQuery("#xuanJiangStr").val("");
            }
            _currentPage = 1;
            searchPost();
        }

        function chooseCompany(obj){
        	jQuery(obj).parent().children("a").attr("class","c333 mr12 showOrg");
        	
            
              jQuery(obj).attr("class","cfd8d56 mr12 showOrg");
            
            jQuery("#sicCorpCodeV").val("");
            jQuery("#comPartV").val(jQuery(obj).attr("data-value"));
            if(null != document.getElementById("xuanJiangStr")){
                jQuery("#xuanJiangStr").val("");
            }
            _currentPage = 1;
            searchPost();
        }

        function chooseCorpCode(obj){
            jQuery(obj).parent().children("li").attr("class","c333 mr12");
             
            
              jQuery(obj).attr("class","cfd8d56 mr12");
            
            jQuery("#comPartV").val("");
            jQuery("#sicCorpCodeV").val(jQuery(obj).attr("data-value"));
            if(null != document.getElementById("xuanJiangStr")){
                jQuery("#xuanJiangStr").val("");
            }
            _currentPage = 1;
            searchPost();
        }

        function Trim(strValue){
            return strValue.replace(/^\s*|\s*$/g,"");
        }
</script>

<script type="text/javascript">
var _currentPage = 1;
var _maxPage;
var columnId = '1';
var projectId = '';
function postDetail(obj){
	var url = "/wt/crpharma/web/index/webPositionN300!getOnePosition";
	url += "?postId="+$(obj).attr("data-postId")+"&recruitType="+$(obj).attr("data-recruitType")+"&brandCode=1&columnId=" + columnId;
    var imPost=$(obj).attr("importPost");
       if(imPost!=null && imPost!=undefined && imPost!='undefined'){
		   url+= "&importPost=" +imPost;
	   }

	if(projectId!=""){
		url += "&projectId=" + projectId;
	}

    window.open(url,"_blank");
}

var url = "/wt/crpharma/web/json/position/list"
		+ "?positionType="
        + "&comPart="
        + "&sicCorpCode="
        + "&brandCode=1"
        + "&releaseTime="
        + "&trademark=1"
        + "&useForm="
        + "&recruitType=" + recruitTypeStr
        + "&projectId="
        + "&lanType=1"
        + "&positionName="
        + "&workPlace="
        + "&page=1"
        + "&site=";
var wholeKeyWord = "";
if(wholeKeyWord!=null && wholeKeyWord!=""){
	wholeKeyWord = encodeURIComponent(wholeKeyWord);
	url += "&keyWord=" + wholeKeyWord;
}else{
	url += "&keyWord=";
}



function htmlEncode(html) {
    var temp = document.createElement ("div");
    (temp.textContent != undefined ) ? (temp.textContent = html) : (temp.innerText = html);
    var output = temp.innerHTML;
    temp = null;
    return output;
}


function getPostList(action,currentPage){
	$.getJSON(action,function(json){
		if(json!=null && json!=undefined){
    		var html = "";

    		var colPoitionName = 'a';
    		var positionNameLength = '150';

    		var colPositionType = 'b';
    		var positionTypeLength = '100';

    		var colPositionCompany = 'c';
    		var postionCompanyLength = '250';

    		var colPostionDeptOrg = '';
            var positionDeptOrgLength = '';

    		var colPostionRecruit = 'd';
    		var positionRecruitLength = '120';

    		var colPositionWorkPlace = 'e';
    		var positionWorkPlaceLength = '100';

    		var colPostionWorkType = '';
            var positionWorkTypeLength = '';

            var colPostionEndTime = '';
            var positionEndTimeLength = '';

    		var colPostionReleaseTime = '';
    		var postionReleaseTimeLength = '';

    		var positionColUseDefault = '1';
    		var corpCode = 'crpharma';
            if (json.postList == null || json.postList == "") {
                //TODO
                html += '<img src="/wt/images/web/noposition.png" style="display:block;margin:20 auto" valign="top" />';
                html += '<div style="text-align:center;color:#9A9A9A">暂无岗位，敬请期待！</div>';
            }
    		$.each(json.postList,function(i,obj){
    			var row = "<ul class=\"overhidden c333 mt20 lh24\">";
    			if(corpCode == "nfh"){
    				row += "<li class=\"fl ml8 width_270\" style=\"width: 400px\">";
	    			var positionName = htmlEncode(obj.postName);
	    			if(positionName.length>18){
	    				positionName = positionName.substring(0,18)+"...";
	    			}
	    			row += "<input type=\"checkbox\" class=\"middle\" value=\""+obj.postId+"\"><span class=\"ml10 middle hand\" data-postId=\""+obj.postId+"\" data-recruitType=\""+obj.recruitType+"\" onclick=\"postDetail(this)\"" + "importPost=\"" + obj.importPost + "\" title=\"" + htmlEncode(obj.postName) + "\">"+positionName+"</span>";
	    			if (obj.importPost == 1) {
	      			   row += '<img src="/wt/images/web/import_post.png" title="重要职位" width="18px" height="15px" valign="top" />';
	      			}
	    			row += "</li>";
        			if(obj.workPlace.length>7){
        				var workPlace = obj.workPlace.substring(0,7)+"...";
        				row += "<li class=\"fl	 w100 tl\" style=\"width: 200px\" title=\""+obj.workPlace+"\">"+workPlace+"</li>";
        			}else{
                        var temp = obj.workPlace;
                        if(temp==""){
                             temp = "&nbsp;";
                        }
                        row += "<li class=\"fl w100 tl\" style=\"width: 200px\" >"+temp+"</li>";
                   }
        			row += "<li class=\"fl w100 tl\" style=\"width: 150px\">"+obj.publishDate+"</li>";
    			}
    			else if(positionColUseDefault==0){
    				row += "<li class=\"fl ml8 width_270\" >";
	    			var positionName = htmlEncode(obj.postName);
	    			
	    			
	    			  
	    			  
	    			     row += "<input type=\"checkbox\" class=\"middle fl\" value=\""+obj.postId+"\"><span class=\"ml10 middle fl hand postNameC cfd8d56 \" data-postId=\""+obj.postId+"\" data-recruitType=\""+obj.recruitType+"\" onclick=\"postDetail(this)\"" + "importPost=\"" + obj.importPost + "\" title=\"" + htmlEncode(obj.postName) + "\" style=\" max-width:220px;\">" + positionName+"</span>";
	    			  
	    			

                    if (obj.importPost == 1) {
                        row += '<img src="/wt/images/web/import_post.png" title="重要职位" width="18px" height="15px" valign="top" />';
                    }

	    			if(obj.outerRecruit == 0){
                        row += '<img src="/wt/images/web/bonus.png" title="人才推荐" width="18px" height="15px" valign="top" />';
	    			}

	    			row += "</li>";
	    			/*if(obj.recruitNum!=null && obj.recruitNum!=""){
	    				row += "<li class=\"fl w80 tl\">"+obj.recruitNum+"</li>";
	    			}else{
	    				row += "<li class=\"fl w80 tl\">"+'若干'+"</li>";
	    			}*/

                    row += "<li class=\"fl w80 tl\">"+obj.recruitNum+"</li>";

        			if(obj.postType!=undefined &&obj.postType!=null&&obj.postType.length>8){
        				var postType = obj.postType.substring(0,8)+"...";
        				row += "<li class=\"fl w80 tl\" title=\""+obj.postType+"\">"+postType+"</li>";
        			}else{
        				row += "<li class=\"fl w80 tl\">"+obj.postType+"</li>";
        			}
        			if(obj.workPlace.length>7){
        				var workPlace = obj.workPlace.substring(0,7)+"...";
        				row += "<li class=\"fl	 w100 tl\" title=\""+obj.workPlace+"\">"+workPlace+"</li>";
        			}else{
                        var temp = obj.workPlace;
                        if(temp==""){
                             temp = "&nbsp;";
                        }
                        row += "<li class=\"fl w100 tl\">"+temp+"</li>";
                   }
        			row += "<li class=\"fl w80 tl\">"+obj.publishDate+"</li>";
    			}else{
	    			if(colPoitionName!=null&&colPoitionName!=""){
	    				if(positionNameLength==""){
                            positionNameLength = 220;
                        }
	    				row += "<li class=\"fl ml8 w220\" style=\"width:"+positionNameLength+"px\">";
	    			}
	    			var positionName = htmlEncode(obj.postName);
	    			
	    			
                      
   			          
   			             row += "<input type=\"checkbox\" class=\"middle fl\" value=\""+obj.postId+"\"><span class=\"ml10 middle hand fl cfd8d56 postNameC\" data-postId=\""+obj.postId+"\" data-recruitType=\""+obj.recruitType+"\" onclick=\"postDetail(this)\"" + "importPost=\"" + obj.importPost + "\" title=\"" + htmlEncode(obj.postName) + "\" style=\"max-width:" + (positionNameLength-50) + "px;\">"+positionName+"</span>";
   			          
	    			



	    			if (obj.importPost == 1) {
                        row += '<img src="/wt/images/web/import_post.png" title="重要职位" width="18px" height="15px" valign="top" />';
	      			}

                    if(obj.outerRecruit == 0){
                        row += '<img src="/wt/images/web/bonus.png" title="人才推荐" width="18px" height="15px" valign="top" />';
                    }
	    			row += "</li>";
	    			if(colPostionRecruit!=null&&colPostionRecruit!=""){
		    			/*if(obj.recruitNum!=null && obj.recruitNum!=""){
		    				row += "<li class=\"fl w80 tl\" style=\"width:"+positionRecruitLength+"px\" >"+obj.recruitNum+"</li>";
		    			}else{
		    				row += "<li class=\"fl w80 tl\" style=\"width:"+positionRecruitLength+"px\" >"+'若干'+"</li>";
		    			}*/
                        row += "<li class=\"fl w80 tl\" style=\"width:"+positionRecruitLength+"px\" >"+obj.recruitNum+"</li>";
	    			}
	    			if(colPositionCompany!=null&&colPositionCompany!=""){
	    				var orgName = obj.orgName;
                        row += "<li class=\"fl w100 tl toe\" style=\"width:"+postionCompanyLength+"px\" title=\""+orgName+"\">"+orgName+"</li>";
	    			}
	    			if(colPostionDeptOrg!=null&&colPostionDeptOrg!=""){
                        var deptOrgName = obj.deptOrgName;
                        row += "<li class=\"fl w100 tl toe\" style=\"width:"+positionDeptOrgLength+"px\" title=\""+deptOrgName+"\">"+deptOrgName+"</li>";
                    }
	    			if(colPositionType!=null&&colPositionType!=""){
	    				var postType = obj.postType;
		    			row += "<li class=\"fl w100 tl toe\" style=\"width:"+positionTypeLength+"px\" title=\""+postType+"\">"+postType+"</li>";
	    			}
	    			if(colPositionWorkPlace!=null&&colPositionWorkPlace!=""){
	    	              var workPlace = obj.workPlace;
	    	              if(workPlace==""){
	    	            	  workPlace = "&nbsp;";
	    	                   row += "<li class=\"fl w80 tl\" style=\"width:"+positionWorkPlaceLength+"px\">"+workPlace+"</li>";
	    	              } else {
	    	            	   row += "<li class=\"fl w100 tl toe\" style=\"width:"+positionWorkPlaceLength+"px\" title=\""+workPlace+"\">"+workPlace+"</li>";
	    	              }
	    			}
	    			if(colPostionWorkType!=null&&colPostionWorkType!=""){
                        var workType = obj.workType;
                        if(workType!=null && workType!=""){
                        	row += "<li class=\"fl w100 tl toe\" style=\"width:"+positionWorkTypeLength+"px\" title=\""+workType+"\">"+workType+"</li>";
                        }else{
                        	row += "<li class=\"fl w100 tl toe\" style=\"width:"+positionWorkTypeLength+"px\" title=\""+'全职'+"\">"+'全职'+"</li>";
                        }
                    }
	    			if(colPostionReleaseTime!=null&&colPostionReleaseTime!=""){
	    				row += "<li class=\"fl w80 tl\" style=\"width:"+postionReleaseTimeLength+"px\" >"+obj.publishDate+"</li>";
	    			}
	    			var isLongTermRelease = obj.isLongTermRelease;

                    if(colPostionEndTime!=null&&colPostionEndTime!=""){
                        if(isLongTermRelease!=null&&isLongTermRelease==0){
                            row += "<li class=\"fl w80 tl\" style=\"width:"+positionEndTimeLength+"px\" >"+'长期发布'+"</li>";
                        }else{
                            if(colPostionEndTime!=null&&colPostionEndTime!=""){
                                row += "<li class=\"fl w80 tl\" style=\"width:"+positionEndTimeLength+"px\" >"+obj.endDate+"</li>";
                            }

                        }
                    }
    			}
    			row += "<li class=\"fl\"><a class=\"Clearfix icon bg11 w25 h7\" data-postId=\""+obj.postId+"\" data-recruitType=\""+obj.recruitType+"\" data-orgId=\""+obj.orgId+"\" href=\"javascript:void(0)\" onclick=\"getPostDetail(this)\"></a></li>";
    			row += "</ul>";
    			html += row;
    		})

    		_maxPage = json.pageCount;
    		$("#_maxPage").val(_maxPage);
    		$("#currentPage").val(currentPage);
    		$("#totalPosition").html("共&nbsp;"+json.rowCount+"&nbsp;条");
    		_currentPage = currentPage;
    		/**if(currentPage==json.pageCount){
    			$("#morePostDiv").hide();
    			$("#allPostDiv").show();
    		}**/
    		$("#postList").html(html);

    		$('#tableCheckAll').prop('checked', false);

    		if(_maxPage>1){
                $(".pagenation").show();
                pagenationInit(_currentPage,$("#_maxPage").val());
                $(".page").click(function(){
                    changePage($(this).html());
                });
            } else {
                $(".pagenation").hide();
            }
		}
	});
}
$(function(){
	getPostList(url,_currentPage);
});

function getPostDetail(obj){
	if(undefined!=$("#postList").find("#"+$(obj).attr("data-postId")).html()){
		//隐藏所有detail
		$("#postList").find(".kuang").hide();

		if($(obj).attr("class").indexOf("bg12")>-1){
    		//变更所有向上按钮图片
    		$("#postList").find(".Clearfix.icon").attr("class","Clearfix icon bg11 w25 h7");
    		//隐藏自身detail
			$("#postList").find("#"+$(obj).attr("data-postId")).hide();
		}else{
    		//变更所有向上按钮图片
    		$("#postList").find(".Clearfix.icon").attr("class","Clearfix icon bg11 w25 h7");
    		//改变自身向下按钮为向上按钮
    		$(obj).attr("class","Clearfix icon bg12 w25 h7");
    		//显示自身detail
    		$("#postList").find("#"+$(obj).attr("data-postId")).show();
		}
	}else{

        var orgIntroduction = "";

        var orgUrl = "/wt/crpharma/web/index/webPositionN300!ajaxGetOrgDetailedIntroduction";
        var dataStr = "orgId=" + $(obj).attr("data-orgid");

        $.ajax({
            type:"POST",
            dataType:"text",
            url:orgUrl,
            sync:true,
            data:dataStr,
            success: function(data){
                var result = eval("("+data+")");
                var retCode = result.retCode-0;
                var retResult = result.retResult;

                if(retCode=="0"){
                    orgIntroduction = retResult;
                }
            }
        });

    	var url = "/wt/crpharma/web/json/position/detail"+"?recruitType="+$(obj).attr("data-recruitType")+"&postId="+$(obj).attr("data-postId");
    	$.getJSON(url,function(json){
    		if(json!=null && json!=undefined){
    			var html = "<div class=\"kuang p20 pr mt10 ml10 mr10\" id=\""+$(obj).attr("data-postId")+"\">";
    			html += "<span class=\"Clearfix pa left20 top-8\"><img src=\"/wt/images/web/style300/arrow.jpg\"></span>";
    			html += "<div class=\"c333 mb10\">"+"职位描述"+"</div>";
    			html += "<p class=\"lh20 f12 c666\">"+json.postInfo.workConcet+"</p>";

    			if(json.postInfo.serviceCondition){
                    html += "<div class=\"c333 mt20 mb10\">"+"任职要求"+"</div>";
                    html += "<p class=\"lh20 f12 c666\">"+json.postInfo.serviceCondition+"</p>";
                }

    			var corpCode = 'crpharma';
    			if(json.postInfo.showSiteInfo && json.postInfo.siteStr!=null&&json.postInfo.siteStr!=''&&corpCode!='yutong'){
    			   html += "<div class=\"c333 mt20 mb10\">"+"招募站点"+"</div>";
    			   html += "<p class=\"lh20 f12 c666\">"+json.postInfo.siteStr+"</p>";
    			}
                if(orgIntroduction!=""){
                    html += "<div class=\"c333 mt20 mb10\">"+"所属机构"+"</div>";
                    html += "<p class=\"lh20 f12 c666\">"+orgIntroduction+"</p>";
                }
    			html += "<input type='hidden' id='submitUserId_"+json.postInfo.postId+"' class=\"lh20 f12 c666\" value='"+json.postInfo.postIdToken+"'/>";
    			html += "<div class=\"overhidden mt20 ml100\">";

                if(json.postInfo.hiddenSiteApply==1) {

                    
                    
                        html += "<a class=\"bg_btn_orange fl lh38 wp23 tc cfff f16 mrp bg_btn_big\" href=\"javascript:void(0)\" onclick=\"positionRegist(" + $(obj).attr("data-postId") + ")\">" + "投递此职位" + "</a>";
                    

                }




    			
    			  
    			  
	                
	                    html += "<a class=\"bg_btn_blue fl lh38 wp23 tc cfff f16 mrp bg_btn_big\" href=\"javascript:void(0)\" onclick=\"addAlternativePost("+$(obj).attr("data-postId")+")\">"+"收藏职位"+"</a>";
	                
	                
    			  
	            
    			html += "</div>";
    			//隐藏所有detail
    			$("#postList").find(".kuang").hide();
    			//变更所有向上按钮图片
    			$("#postList").find(".Clearfix.icon").attr("class","Clearfix icon bg11 w25 h7");
    			//改变自身向下按钮为向上按钮
    			$(obj).attr("class","Clearfix icon bg12 w25 h7");
    			//显示自身detail
    			$(obj).parent().parent().after(html);
    		}
    	});
	}
}

</script>

<script type="text/javascript">

	function initApplyPositionInfo(postId){
	    var url = "/wt/crpharma/web/index/webPositionN300!initApplyPositionInfo?operational=4600ccb0d4b1cc000c1051575e586114a82cbb192bb1a4bc59d9e1f59c27de5beab93e530b3292c925e04df1807ad098e19c8a211705a3579fe04381ac2e017f680d2ace542b1004907aa98225f547ec3f12d0b03fbc27e8"
	    var data = "postId=" + postId;
	    $.ajax({
	        type:"GET",
	        data:data,
	        url:url
	    });
	}

    //隐私声明
    function checkAcceptPrivacy(postId){
        //标记acceptPrivacyFlag
        $("#choosePostId").val(postId);
        var url = '/wt/crpharma/web/index/webPositionN300!showPrivacyContent?operational=4600ccb0d4b1cc000c1051575e586114a82cbb192bb1a4bc59d9e1f59c27de5b6c189cbd89ae64dcfa8bb3c1414d42d88d8c4de2a2d5bc7daa51604176b95eeb7fd401cf7a566ae5daf26f2009821770ee83f5630e280d61';
        url += "&brandCode=1";
        url += "&postId=" + postId;
        //location.href=url;
        window.showDialog(window, 'pickPrivacyWindow300', 640, 400, url);
    }

    //立即申请
    function positionRegist(postId){

        noticeParentIframe();

        setTimeout("checkPositionRegist(" + postId + ")", 1000);

    }
    function checkPositionRegist(postId){

    	if(isNoticeParentIframeFailed){
            return;
        }

        var url = document.getElementById("dispatchRegistForm").action;
        var submitUserId = document.getElementById("submitUserId_"+postId).value;
        var recruitType = "1";

        var readedPrivacy = $("#readedPrivacy").val();

        jQuery.post(url,{submitUserId:submitUserId,postId:postId,recruitType:recruitType},
                function(data){
                    var dataArray = data.split("_,,_");
                    var datamsg = dataArray[0];
                    var msg = dataArray.length>0? dataArray[1]: "";
                    if(datamsg==1 || datamsg==2){
                    	initApplyPositionInfo(postId);
                        showMsg_1(msg);
                    }else if(datamsg==3){
                    	initApplyPositionInfo(postId);
                        showMsg(msg);
                    }else if(datamsg==4){
                        showMsg("校园用户不能应聘社会职位！");
                    }else if(datamsg==5){
                        showMsg("社会用户不能应聘校园职位！");
                    }else if(datamsg==7){
                        showMsg("您初筛或测评已经失败，请不要在投递该职位！");
                    }else if(datamsg==9 || datamsg==10){
                        //alert("跳转到选择简历页面");
                        var url = "/wt/crpharma/web/index/applyPositionN300!chooseResume?brandCode=1&operational=4600ccb0d4b1cc000c1051575e586114ebd6386c91285ded4c1dd94a80067c4b0b23234e14fa21622a0e0d012ac497d4ba193b27868338badb085b53b47b0b503d8360a2e29b0bf77fd401cf7a566ae5daf26f2009821770ee83f5630e280d61"
                            + "&columnId="+'1';
                        if(readedPrivacy!=""){
                            url += "&readedPrivacy=" + readedPrivacy;
                        }
                        window.location = url;

                    }else if(datamsg==11){
                        showMsg("对不起，您已经应聘过该职位，不能重复投递！");
                    }else if(datamsg==32){
                    	$("#postIdTemp").val(postId);
                        $(".newUserDia").show();
                        genNewCode_pwd1();
                        $("#newUserDialog").show();
                    }else if(datamsg==33){
                        if(confirm("请求延迟，请尝试刷新页面再投递。")){
                            window.location.reload();
                        }
                    }else if(datamsg==31){
                    	showMsg(msg);
                    }else if(recruitType==1 && datamsg==180001){ 

                        var siteName = "";
                        if($.trim(msg)==""){
                            var msg1 = "只允许投递同一个站点下的职位，请重新选择站点";
                            var msg2 = "已投递站点";
                            msg = "<div style='text-align: center;'><span style='color:#000;'>"+msg1+"</span>" +
                                "<br><span style='font-weight: bolder;'>" + msg2 + "：" + siteName + "</span></div>";
                        }
                        layer.confirm(msg, {
                            skin: 'demo-class-confirm', //自定义样式类名
                            title: '温馨提示',
                            closeBtn:0,
                            btn: ['确定'],
                            offset: '15%',
                            area: ['auto', 'auto']
                        }, function(index, layero){
                            //确认按钮的回调
                            window.location= "/wt/crpharma/web/index/campus?brandCode=1";
                        });
                    }else{
                        showMsg(msg);
                    }
                });
    }

    function goCreateResume(){
        var url = "/wt/crpharma/web/index/primaryResumeN300!showPrimaryInputPage?brandCode=1&operational=4600ccb0d4b1cc000c1051575e586114b0cd7a14d1403e1aee47894dbdba0f385f4f1d8e8938770cf07a4bdf47ac94772299f1f81afa74dd0c82ac4abecfc0e4db085b53b47b0b503d8360a2e29b0bf77fd401cf7a566ae5daf26f2009821770ee83f5630e280d61"+"&currentPostId="+"&applyPostType=" +"&recruitType=" + recruitTypeStr;
        window.location.href=url;
    }

    function hideDiv(id){
        jQuery("#"+id).hide();
        $(".newUserDia").hide();
        //jQuery("#msgDialog .wincontent").hide();
    }

     function showMsg_1(msg){
        $(".newUserDia").show();
        $("#messageP1").html(msg);
        $("#messageDiv1").show();
        herf="#loginShow";
    }

    function closeShowDiv1(id){
        $(".newUserDia").hide();
        $("#"+id).hide();
    }

    function showMsg(msg){
        $(".tanchuang").attr("style","height:"+document.body.scrollHeight);
        $("#messageP").html(msg);
        $(".tanchuang").show();
        $("#messageDiv").show();
    }

    function closeShowDiv(id){
    	$(".tanchuang").hide();
    	$("#"+id).hide();
    }

    function chooseAllCheck(obj){
    	if($(obj)[0].checked){
	    	$("input[type='checkbox']").attr("checked",true);
    	}else{
    		$("input[type='checkbox']").attr("checked",false);
    	}
    }

    function trim(str) {
        return str.replace(/(^\s*)|(\s*$)/g, "");
    }

    function addAlternativePost(pid){
    	var anPostList = getCookie("AlternativePostList");
    	if(anPostList==undefined){
    		anPostList = "";
    	}else{
	    	anPostList = trim(anPostList);
    	}
    	pid = pid + "_" + recruitTypeStr;
    	if(anPostList.indexOf(pid)<0){
        	anPostList += pid + ",";
        	showMsg("职位收藏成功！");
        	setCookie("AlternativePostList",anPostList,1);
    	}else{
    		showMsg("请勿重复收藏职位！");
    	}
    }

    function addAlternativePostList(){
    	var anPostList = getCookie("AlternativePostList");
    	if(anPostList==undefined){
    		anPostList = "";
    	}else{
    		anPostList = trim(anPostList);
    	}
    	var pidList = $("#postList input:checked");
    	if(pidList.length==0){
            showMsg("请选择职位!");
            return;
        }

    	var pidLastPar = "_" + recruitTypeStr;
    	for ( var i = 0; i < pidList.length; i++) {
    		var curId = $(pidList[i]).val() + pidLastPar;
    		if(anPostList.indexOf(curId)<0){
    			anPostList += curId+",";
    		} else {
    			showMsg("部分职位已经被添加，请重新选择!");
                return;
    		}
		}

    	showMsg("职位收藏成功！");
    	setCookie("AlternativePostList",anPostList,1);
    }

    function addDataAlternativePost(pid){
    	pid = pid + "_" + recruitTypeStr;
    	var action = "/wt/crpharma/web/index/alternativePosition!addAlternativePost";
		var data = "postIdStr="+pid;
		$.ajax({
			type:"POST",
			url:action,
			data:data,
			success:function(_result){
				if(_result==0){
					showMsg("职位收藏成功！");
				}else{
					showMsg("请勿重复收藏职位！");
				}
			}
		});
    }

    function addDataAlternativePostList(){
    	var anPostList = "";
    	var pidList = $("#postList input:checked");
    	if(pidList.length==0){
    		showMsg("请选择职位!");
    		return;
    	}
    	for ( var i = 0; i < pidList.length; i++) {
    		var curId = $(pidList[i]).val() + "_" + recruitTypeStr;
    		if(anPostList.indexOf(curId)<0){
    			anPostList += curId+",";
    		}
		}

    	var action = "/wt/crpharma/web/index/alternativePosition!initAlternativePost";
		var data = "postIdStr="+anPostList;
		$.ajax({
			type:"POST",
			url:action,
			data:data,
			success:function(_result){
				if(_result==0){
					showMsg("职位收藏成功！");
				}else{
					showMsg("部分职位已经被添加，请重新选择!");
				}
			}
		});
    }

    //clearCookie("AlternativePostList");

</script>

