});

function checkIsShowPubMessage() {

    
}
var pwdEncryptionType = 1;
function encrypt(str) {
    var isSystemTesting = false;
    if(isSystemTesting){
        return $.trim(str);
    }
    if(pwdEncryptionType==3){
        return sm4Encrypt_ECB(str,"3588538957232728");
    }else{
        var key = CryptoJS.enc.Utf8.parse("3588538957232728");
        var encrypted = '';

        var srcs = CryptoJS.enc.Utf8.parse(str);
        encrypted = CryptoJS.AES.encrypt(srcs, key, {
            mode: CryptoJS.mode.ECB,
            padding: CryptoJS.pad.Pkcs7
        });
        return $.trim(encrypted.ciphertext.toString());
    }
}

function hideAll(){
	$("#loginDiv").hide();
	$("#registDiv").hide();
	$("#passwordDiv").hide();
