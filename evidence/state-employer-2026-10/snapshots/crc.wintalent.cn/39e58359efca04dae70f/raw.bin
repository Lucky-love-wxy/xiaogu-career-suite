        z-index: 9999;
        display: none;
        overflow-y: auto;
    }
    .privacy_modal{
        margin: 70px auto;
        z-index: 1000;
        width: 800px;
        height: 540px;
        background: #ffffff;
        position: relative;
    }
    .import_privacy_modal_close{
        display: block;
