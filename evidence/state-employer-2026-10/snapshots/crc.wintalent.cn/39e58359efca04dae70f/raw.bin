<script type="text/javascript">

    function changePage(objvalue){
    	if(objvalue==-1){
    		if($("#currentPage").val()<=1){
    			_currentPage = 1;
                searchPost();
    		}else{
    			var pageUp = parseInt($("#currentPage").val())-1;
    			_currentPage = pageUp;
                searchPost();
    		}
    	}else if(objvalue==-2){
    			if($("#_maxPage").val()==$("#currentPage").val()){
    				_currentPage = $("#_maxPage").val();
                    searchPost();
    			}else{
    				var pageDown = parseInt($("#currentPage").val())+1;
    				_currentPage = pageDown;
                    searchPost(pageDown);
    			}
    	}else{
    		_currentPage = parseInt(objvalue);
            searchPost();
        }

    }

