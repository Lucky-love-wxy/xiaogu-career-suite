    $(function () {
        var showLoginType = getQueryString("showLoginType");
        if(showLoginType == "login"){
            mouseClickLogin();
        }else if(showLoginType == "regist"){
            mouseClickRegist();
        }
    });

    /***js获取请求参数***/
    function getQueryString(name) {
        var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)");
        var r = window.location.search.substr(1).match(reg);
        if (r != null) return unescape(r[2]);
        return null;
    }

    function initSearchInputTypeName(){
    	var recruitType = $("#recruitType").val();
    	var userType = document.getElementsByName("registerUserType");
    	$.each(userType, function(index){
    		if(this.value == recruitType){
    			var dest = $("#searchInputTypeArea");
    			var source = $("#recruitType_"+ recruitType +"");
    			if(typeof (source) != 'undefined' && typeof (source.attr("data-value")) != 'undefined'){
                    if(source.attr("data-value").length>6){
                        var	typeName = source.attr("data-value").substring(0,6)+"...";
                        dest.text(typeName);
                    }else{
                        dest.text(source.attr("data-value"));
                    }
                    dest.attr("title",source.attr("data-value"));
                }
    			return false;
    		}
    	});
    }
