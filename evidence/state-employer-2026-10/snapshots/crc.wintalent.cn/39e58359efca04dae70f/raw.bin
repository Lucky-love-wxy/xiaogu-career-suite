      /*定义滚动条高宽及背景 高宽分别对应横竖滚动条的尺寸*/
        .listOrg::-webkit-scrollbar
		{
		    width: 7px;
		    height: 12px;
		    background-color: #F5F5F5;
		}

		/*定义滚动条轨道 内阴影+圆角*/
		.listOrg::-webkit-scrollbar-track
		{
		    -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.3);
		    border-radius: 10px;
		    background-color: #F5F5F5;
		}

		/*定义滑块 内阴影+圆角*/
		.listOrg::-webkit-scrollbar-thumb
		{
		    border-radius: 10px;
		    background-color: rgba(153, 153, 153, 0.46);
		}
		.bg_btn_colo_extend{
		     background-color:;
		     opacity:1.0;
		     filter:alpha(opacity=100);
		}
		.theme_color{
		    color:;
		}

		.postColor{
		    color:;
		}

		.siteIcon {
         background-image: url(/wt/images/web/style300/siteIcon.png);
         background-repeat: no-repeat;
		}

		.taikangorg #companyAll {
			display:none;
			float:left;
		}
		.taikangorg a {
			display:inline-block;
			padding: 6px 12px;
			background-color:lightgray;
			margin-bottom:10px;
			color:black;
		}
		.w80 {
			width:85px;
		}

		/*改变搜索框高度*/
		.h50 {
			height:40px;
		}
		.lh50 {
			line-height:40px;
		}
		.bp10 {
			background-position:20px -168px;
		}
		.border_red {
			border:1px solid #fd8d56;
		}
		.taikangorg {
			width:700px !important;
		}
		/*PM-22391增加2级联动*/
		.search-bar {
			margin-top:6px;
			position:relative;
			border:1px solid lightgray;
			overflow: hidden;
		}
		.search-bar .sec_title {
		    float: left;
   			margin-top: 8px;
   			margin-left: 8px;
   			display: inline-block;
   			padding: 2px 4px;
   			background: #999;
   			border-radius: 4px;
   			color: white;
   			margin-right: 10px;
		}
		.search-bar img {
			position:absolute;
			top:6px;
			right:10px;
			width:10px;
		}
		.search-bar div {
			padding:5px;
			box-sizing:border-box;

			overflow:hidden;
			position:relative;
			float:left;
		}
		.search-bar div span {
			padding:1px 3px;
			margin-right:8px;
			white-space:nowrap;
			color:#333;
			float:left;
			line-height: 25px;
		}
		.search-bar div .theme_color {color: #fd8d56;}
		.search-bar div .cfd8d56{color:#fd8d56;}
		#rocket {
			width:50px;
			height:50px;
			background-color:#fd8d56;
			position:fixed;
			right:10px;
			bottom:90px;
			opacity:0;
			cursor:pointer;
			transition:all 1s;
			line-height:50px;
			text-align:center;
			color:white;
		}
		.hideEle { display: none!important; }
		.postNameC {
			width:fit-content !important;
			/* max-width: 190px !important; */
			text-overflow: ellipsis;
			overflow: hidden;
			white-space: nowrap;
			display: block;
			margin-top: -5px;
		}

		.pagenation{
            width: 94%;
            height: 40px;
            line-height: 40px;
            bottom: 24px;
            left: 3%;
            /* border-radius: 3px; */
            background: #F2F2F2;
            text-align: center;
            margin: 20px auto 0;
            margin-bottom: 24px;
        }
        .pagenation span{
          padding: 5px 11px;
          color: #777;
          cursor: pointer;
          margin:0 5px;
        }

        .pagenation span:hover{
          background: #fd8d56;
            color: #fff !important;
        }

        .page{
          color: #333 !important;
          background: #e9ebed;
        }
        .present{
            background-color: transparent;
        }
        

      .chinalife_color{color: #009b62;}
      #slideContainer{position: relative; height: 250px;}
      #slidesImgs li{
          height:250px;
          background-repeat: no-repeat;
          background-size: cover;
          background-position: center;
      }
      .slidebar {
          top: unset;
          bottom: 20px;
      }
      @media screen and (min-width: 1401px ) and (max-width: 1600px ) {
          #slideContainer, #slidesImgs li{
              height:210px;
          }
      }
      @media screen and (max-width: 1400px ) {
          #slideContainer, #slidesImgs li{
              height:180px;
          }
      }

</style>

<style type="text/css">
