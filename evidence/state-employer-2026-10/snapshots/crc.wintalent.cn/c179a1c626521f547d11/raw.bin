    function checkLoadSource(option){
        if(!!option && option.isTc){
            return true
        }
        if(!!option && option.forceLoad){
            return true
        }
        return (!!option && option.flag && (option.flag === "interviewDetail"
            || option.flag === "interviewDetailTemplate"
            || option.flag === "interviewDetailPreviewProgressTemplate"
            || option.flag === "interviewDetailHistoryOperateTemplate"
            || option.flag === "interviewDetailViewDetailListThirdTemplate"
            || option.flag === "interviewDetailArrangeInfoAdjuDetailTemplate"
            || option.flag === "interviewDetailCancelReasonTemplate"
            || option.flag === "createInterviewLink"
            || option.flag === "newVersionSequenceForAE"
            || option.flag === "newVersionAddCandidatesSequence"
            || option.flag === "newVersionSelectShareObjectSequence"
            || option.flag === "NVSTemplate" //面试看板-详情页，没有候选人左侧导航，但仍需要按需加载拆分；简历详情页的生成面评链接；现场叫号-新增/修改场次
            || option.flag === "singleInterview"  // 面试安排拆分
            || option.flag === "multipleInterview"   // 面试安排拆分
            || option.flag === "singleSequence"   // 面试安排拆分
            || option.flag === "multipleSequence"   // 面试安排拆分
            || option.flag === "changeInterviewer"   // 修改面试官
            || option.flag === "quickEvaluate"   // 快速面试评价
            || option.flag === "importInterviewEVBatch"   // 面试评价导入 - 只有批量
            || option.flag === "userList"   // 快速面试评价面试官组件
    ))
    }

    window.loadJavascriptArr = []
    window.loadJavascript = function(jsPath, cb, option){
        if(window.loadJavascriptArr.indexOf(jsPath) == -1 && (splitRecruitType == '0' || (typeof candidatesLefts !== 'undefined') || checkLoadSource(option))){
            window.loadJavascriptArr.push(jsPath)
            // 批量操作加载资源的时候存在批量operateObjStr被清空的情况
            var operateObjStrVal = $('#operateObjStr').val()

            $.ajaxSetup({
                cache: true
            });
            $.getScript(new Function('return JS_'+jsPath)(), function(res, status){
                $.ajaxSetup({
                    cache: false
                });
                if(status === 'success'){
                    $('#operateObjStr').val(operateObjStrVal)
                    typeof cb === 'function' && cb()
                }else{
                    console.log('loading ' + jsPath + ' failed!')
                }
            });
        }else{
            typeof cb === 'function' && cb()
        }
    }

    window.loadCssArr = []
    window.loadCss = function(cssPath, cb, option){
        if(window.loadCssArr.indexOf(cssPath) == -1 || checkLoadSource(option)){
            // 批量操作加载资源的时候存在批量operateObjStr被清空的情况
            var operateObjStrVal = $('#operateObjStr').val()
            var cssTag = document.getElementById('CSS_'+cssPath);
            var head = document.getElementsByTagName('head').item(0);
            if(cssTag) head.removeChild(cssTag);
            css = document.createElement('link');
            css.href = new Function('return CSS_'+cssPath)();
            css.rel = 'stylesheet';
            css.type = 'text/css';
            css.id = 'CSS_'+cssPath;
            css.onload = function(){
                typeof cb === 'function' && cb()
            }
            head.appendChild(css);

        }else{
            typeof cb === 'function' && cb()
        }
    }

    window.loadSource = function(sourceTag, cb, option){
        // 批量操作加载资源的时候存在批量operateObjStr被清空的情况
        var sourceTagMap = {
            ckeditor: function(cb){
                window.loadJavascript('ckeditor', function(){
                  window.loadJavascript('ckeditorZh', function(){
                    window.loadJavascript('ckeditorPk', function(){
                        window.loadCss('ckeditor', function(){
                            typeof cb === 'function' && cb()
                        },option)
                    },option)
                  },option)
                },option)
            },
            _interviewerSchedule: function(cb){
                window.loadJavascript('chooseUserv10', function () {
                    window.loadJavascript('interviewSelect', function (){
                        window.loadJavascript('timezone', function(){
                            window.loadJavascript('interviewPop', function () {
                                window.loadJavascript('timzoneModal', function () {
                                    window.loadCss('timzoneModal', function () {
                                        window.loadCss('chooseUserv10', function () {
                                            typeof cb === 'function' && cb()
                                        },option)
                                    },option)
                                },option)
                            },option)
                        },option)
                    },option)
                },option)
            },
            showOutcall: function(cb){
                window.loadJavascript('showOutcall', function () {
                    typeof cb === 'function' && cb()
                },option)
            },
            interviewDetail: function(cb){
                window.loadJavascript('interviewDetail', function () {
                    typeof cb === 'function' && cb()
                }, option)
            }
        }
        sourceTagMap[sourceTag](cb)
    }
</script>



          




