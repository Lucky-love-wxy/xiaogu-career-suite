    var wechatLoginCheckStatus = '/wt/wechatLogin!checkStatus?operational=3ab0ad5a4e51dcd2bd0a79821f4a265750c5bc45a02b42e234daadde3b98522bd21bf18f3ea5c4c5c5137f5b1019c86b8eb1c4d79e5ac29a';
    var forceLogout = '/wt/forceLogout.s?type=force&operational=7e55ad7065d76717a7cdceadb2a788f7f10e19c934a5c4ca7f4da026e71b67ef165876aa4d426225d7de5fa95953b823da45cdbf9caaee62';
    var wechatLogin = '/wt/wechatLogin?operational=3ab0ad5a4e51dcd23e1c57925517fbcf2ec6a81dafe13e55cc2f1016d89e19d105cf04c70be83718';
    var getVerificationCode = '/wt/getVerificationCode?operational=5f68d13c3031d4b3fa55760b6c86818e5f41f8d5d3dc19ae2ec6a81dafe13e55cc2f1016d89e19d105cf04c70be83718';
    var loginInfoApiUrl = '/wt/loginInfo';


    /*切换登录方式相关 end*/
    //浏览器版本过低提示
    (function () {
        var lessThenIE9 = function () {
            var UA = navigator.userAgent,
                isIE = UA.indexOf('MSIE') > -1,
                v = isIE ? /\d+/.exec(UA.split(';')[1]) : 'no ie';
            return v < 9;
        };

        if (lessThenIE9()) {
            $("#wt-browser-panel").show();
            $("#browser-close").click(function () {
                $("#wt-browser-panel").hide();
            })
        }
        getLoginInfo()
    })();
    $(".qrCodeIcon").on("click",function(){
        $(this).hide();
        $(".accountNumber").show();
        $(".erweima").hide();
        $(".computerIcon").show();
    });
    $(".computerIcon").on("click",function(){
        $(this).hide();
        $(".erweima").show();
        $(".accountNumber").hide();
        $(".qrCodeIcon").show();
    });
    //账号，二维码切换登陆
    $(".swichChangeNumber").on("click",function(){
        $(".erweima").fadeOut(360);
        $(".accountNumber").fadeIn(360);
    });
    $(".swichChangeErweima").on("click",function(){
        $(".accountNumber").fadeOut(360);
        $(".erweima").fadeIn(360);
    });
    /////////////////////////////////点击显示密码明文//////////////////////////////

    function passwordchange (ee) {
        //console.log(ee.target.value)
        if(ee.target) {
            if(ee.target.value) {
                $("#passwordView").attr("style", "display:block;width: 20px;height: 14px;");
            }else{
                $("#passwordView").attr("style", "display:none;width: 20px;height: 14px;");
            }
        }else{
            $("#passwordView").attr("style", "display:block;width: 20px;position: absolute;font-size: 14px;height: 14px;");
        }
        setLoginBtnState()
    }

    function inputchange (ee){
        setLoginBtnState()
    }

    // $(".passwordCon").on("click", ".passwordView", function () {
    //     if($("#password").attr("type") === 'password') {
    //         $("#password").attr("type", "text");
    //         $("#passwordView").removeClass('icon-ats-yincang').addClass('icon-ats-chakan');
    //     } else {
    //         $("#password").attr("type", "password");
    //         $("#passwordView").removeClass('icon-ats-chakan').addClass('icon-ats-yincang');
    //     }
    // });
    $(".passwordCon").on("mousedown", "#passwordView", function () {
        $("#password").attr("type", "text");
        $("#passwordView").removeClass('icon-ats-yincang').addClass('icon-ats-chakan');
    });

    $(".passwordCon").on("mouseup", "#passwordView", function () {
        $("#password").attr("type", "password");
        $("#passwordView").removeClass('icon-ats-chakan').addClass('icon-ats-yincang');
    });
    ////////////////////////////////////////////////////////////////////////////
    $(function () {
        $(document.body).on("keydown", function (event) {
            var e = event || window.event || arguments.callee.caller.arguments[0];
            var currKey = e.keyCode || e.which || e.charCode;
            if (currKey == 13) {
                if (document.getElementsByClassName('wt-modal-panel').length == 0) {
                    doLogin();
                }
            }
        });
    })
    $(function () {
        //ATS-33175
        //  控制login box 显示隐藏
        function changeShowLoginBox (isShow) {
            var $login = $('.login');
            isShow? $login.show():$login.hide();
        }
        // 控制 已登录 box 显示隐藏
        function changeShowOtherLoginBox(isShow) {
            var $otherLogin = $('.other-login');
            isShow? $otherLogin.show():$otherLogin.hide();
        }


        //如果要强制登录 显示继续登录box 隐藏原本的login box
        


        function bindOtherEvent() {
            // 使用其他账号登录 点击事件
            $('.other-login-returnBtn').on('click',function () {
                // changeShowLoginBox(true);
                // changeShowOtherLoginBox(false);
                location.href = '/wt/login'
            });
            // 继续登录
            $('.other-login-btn').on('click',function () {
                var url = $(this).attr('data-url');
                location.href = url;

            });

        }
        bindOtherEvent();

    })
    // 替换备案号 begin
    function replaceBeiAn(){
        var host = location.host;
        var _arr = [
            'wintalent.com',
            'wintalent.net',
            // 'localhost:8080'
        ];
        var _obj = {
            'wintalent.com':'沪ICP备10000326号-7',
            'wintalent.net':'沪ICP备10000326号-8',
            // 'localhost:8080':'yuluoceshi'
        }
        for(var i = 0; i < _arr.length;i++){
            var item = _arr[i];
            if(host.includes(item)){
                $('#beianId').text(_obj[item]);
                return;
            }
        }
    }
    $(function (){
        var flag = localStorage.getItem("privaryCheckFlag")
        if(flag == 0){
            // document.getElementById('privaryCheckbox').checked = true;
        }
    })
    replaceBeiAn();
    // 替换备案号 end

    function handleInnerHeight() {
        var windowHeight = window.innerHeight;
        
    }

    window.addEventListener('resize', function() {
        handleInnerHeight();
    });
    document.addEventListener('DOMContentLoaded', function(event) {
        handleInnerHeight();
    });
</script>
