<script type="text/javascript">
    (typeof baseContextPath=="undefined")  &&(baseContextPath = "/wt")
    // resolve dialog zIndex conflict
    var commonDialogIndex = 1024,_wtCurrentLang_ = 'zh_CN';
    var getCommonDialogIndex = function () {
        return ++commonDialogIndex;
    }

    var getCookie = function (name){
        var name = escape(name);
        //è¯»cookieå±æ§ï¼è¿å°è¿åææ¡£çææcookie
        var allcookies = document.cookie;

        //æ¥æ¾åä¸ºnameçcookieçå¼å§ä½ç½®
        name += "=";
        var pos = allcookies.indexOf(name);

        //å¦ææ¾å°äºå·æè¯¥åå­çcookieï¼é£ä¹æåå¹¶ä½¿ç¨å®çå¼
        if (pos != -1){
            var start = pos + name.length;
            var end = allcookies.indexOf(";",start);
            if (end == -1) end = allcookies.length;
            var value = allcookies.substring(start,end);
            return unescape(value);
        }
        else return "";
    }


if (!window.isInitLocale) {
    var translationMessagesList = null;
    var localeMap = {
        1: 'zh',
        2: 'en',
        3: 'yue',
        100: 'in',  // å°å°¼è¯­
        101: 'vi', // è¶åè¯­
        102: 'es', // è¥¿ç­çè¯­
        103: 'pt', // è¡èçè¯­
        104: 'de', // å¾·è¯­
        105: 'tr', // åè³å¶è¯­
        106: 'ja', // æ¥è¯­
    };
    try {
        var $locale = getCookie('wintalent3.locale');
        var isTraditional = getCookie('isTraditional');

        window.wtspeLocale = localeMap[$locale];

        if ($locale === '1' && isTraditional === 'Y') {
            window.wtspeLocale = 'yue';
        }

        

        window.wtspeLocale = window.wtspeLocale || 'zh';
        localStorage.setItem('tlf_locale', window.wtspeLocale);
        window.isInitLocale = true;
    } catch (e) {
        window.wtspeLocale = 'zh';
        localStorage.setItem('tlf_locale', window.wtspeLocale);
    }


    try {
        var xhr = new XMLHttpRequest();
        xhr.open('GET', '/wt/languages/' + window.wtspeLocale + '.json', false); // ç¬¬ä¸ä¸ªåæ°è®¾ç½®ä¸ºfalseè¡¨ç¤ºåæ­¥è¯·æ±
        xhr.send();

        if (xhr.status === 200) {
            console.log('æåå è½½è¯­è¨: ', window.wtspeLocale);
            // console.log(xhr.responseText); // å¤çååº
            translationMessagesList = JSON.parse(xhr.responseText);
            window.translationMessagesList = translationMessagesList;
        } else {
            console.error('è¯·æ±å¤±è´¥ï¼ç¶æç ï¼', xhr.status);
        }
    }catch (e) {
        console.error("AJAXè¯·æ±å¤±è´¥");
    }


    try {
        var render = (template, data) => template.replace(/\{(.*?)\}/g, (match, key) => data[key]);
        function T(chName, key, context, useCh) {
            let msg = '';

            if (useCh) {
                msg = chName;
            } else {
                if (!translationMessagesList) {
                    console.log('------error:T----');
                } else {
                    msg = translationMessagesList[key];
                }
                msg = msg || chName;
            }

            if (!context || Object.keys(context).length === 0) {
                return msg;
            }

            msg = render(msg, context);
            return msg;
        }
        window.T = T;
    } catch (e) {

    }
}

</script>
