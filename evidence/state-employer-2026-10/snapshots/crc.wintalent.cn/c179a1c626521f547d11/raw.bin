<script>
    // 主体颜色
    window.themeMainColor = '';
    var themeStyle = getSharedParams('themeStyle');
    (!themeStyle || themeStyle.themeColor !== themeMainColor) && window.setSharedParams('themeStyle', {themeColor: window.themeMainColor});
    var _getCookie = function(name){
        var name = escape(name);
        //读cookie属性，这将返回文档的所有cookie
        var allcookies = document.cookie;

        //查找名为name的cookie的开始位置
        name += "=";
        var pos = allcookies.indexOf(name);

        //如果找到了具有该名字的cookie，那么提取并使用它的值
        if (pos != -1) {
            var start = pos + name.length;
            var end = allcookies.indexOf(";", start);
            if (end == -1) end = allcookies.length;
            var value = allcookies.substring(start, end);
            return unescape(value);
        } else return "";
    }
    window.themeMainColor && window.setSharedParams("tlf_theme_color", {themeColor: window.themeMainColor});
    var langStr = "zh-cn";
    // cookie-corpCode
    if(_getCookie('corpCode') === '') {
        setTempCookie('corpCode', '')
    }
</script>
