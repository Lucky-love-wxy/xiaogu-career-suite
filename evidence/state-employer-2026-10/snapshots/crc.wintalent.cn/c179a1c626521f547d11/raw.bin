            corpIdPlaceholder = "请输入企业号",
            VerificationCode = "获取验证码"




        var isFirefox = false,
            isSafari = false,
            isCamino = false,
            isMozilla = false;

        $(document).ready(function () {
            $.ajax({
                url: "/wt/console/config/illustration/now?operational=d6d6f96f59d584bbda24d5fa1c653b3e0c66a84d0db6865c021040a8867fdd1a7e64a71b5ef9d726d21bf18f3ea5c4c5c5137f5b1019c86b8eb1c4d79e5ac29a",
                type: "post",
                dataType: "json",
                data: null,
                success: function (result) {
                    if (result) {
                        if ( (typeof result.imgUrl !== 'undefined') && result.imgUrl) {
                            var img = "/wt/console/config/illustration/file?imgUrl=" + result.imgUrl;
                            $(".logoBg").css("background-image", 'url(' + img + ')');
                        } else {
