                $('.login-subtitle-rtext').html('TRM.AI 2.0')
                // setTempCookie("wintalent3.locale", 1);
                $("#password").css("padding-right", "120px");
            }
        });
        function getOs() {
            var OsObject = "";
            if (navigator.userAgent.indexOf("MSIE") > 0) {
                return "MSIE";
            }
            if (isFirefox = navigator.userAgent.indexOf("Firefox") > 0) {
                return "Firefox";
            }
            if (isSafari = navigator.userAgent.indexOf("Safari") > 0) {
                return "Safari";
            }
            if (isCamino = navigator.userAgent.indexOf("Camino") > 0) {
                return "Camino";
            }
            if (isMozilla = navigator.userAgent.indexOf("Gecko/") > 0) {
                return "Gecko";
            }
        }

        function is_iPad() {
            var ua = navigator.userAgent.toLowerCase();
            if (ua.match(/iPad/i) == "ipad") {
                return true;
            }
            else {
                return false;
            }
        }

        function loadOs() {
            var vOs = getOs();
            var ipadFlag = is_iPad();
            if (ipadFlag) {
                var contentObj = document.getElementById("content");
                contentObj.style.left = "128px";
            }
        }

        function fTrim(str) {
            return str.replace(/(^\s*)|(\s*$)/g, "");
        }
        var corpDefaultText = "企业名";
        var userNameDefaultText = "用户名";
        var requiredText = "“{0}”是必须录入项！"
        var verifyCodeText = "验证码"
        var mobilePhoneLabel =  "手机号码"



        function loadCookie() {
            // //cookie取值
            var username = $.cookie('username');
            var corpCode = $.cookie('corpCode');
            var phoneNum = $.cookie("phoneNum");
            var verification = $.cookie("verification");

            //将获取的值填充入输入框中
            $('#userName').val(username);
            $('#corpCode').val(corpCode);
            $('#phoneNum').val(phoneNum);
            $('#verification').val(verification);
            if(username != null && username != '' && corpCode != null && corpCode != ''){
                //选中保存秘密的复选框
                $("#rememberMe").attr('checked',true);
            }


            var corpInput = document.getElementById("corpCode");
            var userInput = document.getElementById("userName");
            if (corpInput.value == "" || corpInput.value == corpDefaultText) {
                corpInput.focus();
            } else if (userInput.value == "" || userInput.value == userNameDefaultText) {
                userInput.focus();
            } else if (document.getElementById("password").value == "") {
                document.getElementById("password").focus();
            } else if (document.getElementById("verifyCode") != null && document.getElementById("verifyCode").value == "") {
                document.getElementById("verifyCode").focus();
            }
        }

        document.onkeydown = keyDown;
        function keyDown(e) {
            e = e || event;
            var currKey = e.keyCode || e.which || e.charCode;

            if (currKey == 13) {
                if(document.getElementsByClassName('wt-modal-panel').length==0){
                    doLogin();
                }
            }
        }

        function wtspeModalWarning(text){
            window.top.Wtspe.wtspeModalWarning({
                html: text,
                onOk: {
                    enable: true,
                    callback: function(destroy){
                        destroy()
                    }
                },
            })
        }

        var checkNum = 0;
        var localeType = 1;
        function formatCurrentDate() {
            var date = new Date();
            var year = date.getFullYear();
            var month = String(date.getMonth() + 1).padStart(2, '0'); // 月份从0开始需+1
            var day = String(date.getDate()).padStart(2, '0');
            return year + '-' + month + '-' + day;
        }
        var currentDate = formatCurrentDate();
        function doLogin() {//v2.0

            if($(".isCodeImgLogin").is(":visible") || $(".isWecomLoginCorp").is(":visible")){
                getCodeImgFn();
                return;
            }

            // 清空localstorage
            var candidatesLeftsSwitchStatus = localStorage.getItem("candidatesLeftsSwitchStatus") || JSON.stringify({
                1: 1,
                2: 1,
                3: 1
            })
            var type = $(".loginItem.active").attr('type'); // 登录方式
            var dateUnitFlag = localStorage.getItem('dateUnitFlag')||"";//保留的上一次的日历单位操作
            var AIProcessShowedFlag = localStorage.getItem('AIProcessShowed')||"";//保留的上一次AI提醒框
            var dateUnitFlag = localStorage.getItem('dateUnitFlag')||"";//保留的上一次的日历单位操作
            var uidValue=localStorage.getItem('uidCorpkey');
            var tlf_locale = localStorage.getItem('tlf_locale')
            var dt_corpCode = localStorage.getItem('dingtalkCorpCode-146954')
            // 获取智能推荐 采纳当天是否显示
            var getNoCardReminderStorageKey = localStorage.getItem('smart_recommend_boss_no_card_'+ currentDate) ||"";//保留的上一次的日历单位操作

            // 缓存 table 列宽 列/表 双模式
            var resizeColumnsCache = localStorage.getItem('resizeColumnsCacheKey');
            var resizeColumnsCaches = [];
            for (let i = 0; i < localStorage.length; i++) {
                const k = localStorage.key(i);
                if (k.startsWith('resizeColumnsCacheKey-') || k.startsWith('screeningRequirementsKey')) {
                    resizeColumnsCaches.push([k, localStorage.getItem(k)]);
                }
            }
            localStorage.clear();
            localStorage.setItem('dingtalkCorpCode-146954',dt_corpCode);
            localStorage.setItem('uidCorpkey',uidValue);
            localStorage.setItem('JudgementRepeatResumeFlag','1')//判断重复简历只在登陆后显示一次
            localStorage.setItem('JudgementDueResumeFlag','1')//判断到期简历只在登陆后显示一次
            localStorage.setItem('JudgementOrgRemindMsgFlag','1')//判断定制化 机构编制强控制文案只提示一次
            localStorage.setItem('JudgementRepeatRemindFlag','1')//判断重复简历合并提示只在登陆后显示一次
            localStorage.setItem('tlf_locale',tlf_locale)//判断重复简历合并提示只在登陆后显示一次
            sessionStorage.removeItem('ATS_TOKEN');
            localStorage.setItem("AIProcessShowed", AIProcessShowedFlag);
            localStorage.setItem("candidatesLeftsSwitchStatus", candidatesLeftsSwitchStatus);
            localStorage.setItem('smart_recommend_boss_no_card_'+ currentDate,getNoCardReminderStorageKey);//保留上一次的日历单位操作
            localStorage.setItem('isLoginFromLoginPage','true') // 从登录页登录进来
            if(dateUnitFlag) localStorage.setItem('dateUnitFlag',dateUnitFlag);//保留上一次的日历单位操作
            // 缓存 table 列宽 列/表 双模式
            resizeColumnsCache && localStorage.setItem('resizeColumnsCacheKey', resizeColumnsCache);
            if (resizeColumnsCaches.length) {
                resizeColumnsCaches.forEach(([k, v]) => {
                    localStorage.setItem(k, v);
            });
            }


            var corpInput = document.getElementById("corpCode");
            if(false){
                corpInput.value = '企业名';
            }
            var userInput = document.getElementById("userName");
            var corpName = fTrim(corpInput.value);
            var userName = fTrim(userInput.value);
            if (corpName == corpDefaultText) {
                // alert(requiredText.replace("{0}", corpDefaultText));
                wtspeModalWarning(requiredText.replace("{0}", corpDefaultText))
                corpInput.focus();
                return;
            }


            /* if(document.getElementById('privaryCheckbox').checked ==false){
                 // alert('请先阅读并勾选隐私协议')
                 Wtspe.wtspeModalWarning({type:'mini', duration: 2000,html:'<div>请勾选隐私协议</div>'})
                 return;
             }*/


            if(type === 'sms'){
                var phoneNumObj = document.getElementById("phoneNum");
                var verificationObj = document.getElementById("verification");
                phoneNum = fTrim(phoneNumObj.value);
                verification = fTrim(verificationObj.value);

                $("#loginMode").val(1)

                if (phoneNum == mobilePhoneLabel||phoneNum=='' && $("#phoneNum").is(":visible")) {
                    In_errorToast({
                        contentText: requiredText.replace("{0}", mobilePhoneLabel),
                    });
                    phoneNumObj.focus();
                    return;
                }

                if (verification == verifyCodeText||verification=='') {
                    In_errorToast({
                        contentText: requiredText.replace("{0}", verifyCodeText),
                    });
                    verificationObj.focus();
                    return;
                }

            } else {
                if (userName == userNameDefaultText) {
                    // alert(requiredText.replace("{0}", userNameDefaultText));
                    wtspeModalWarning(requiredText.replace("{0}", userNameDefaultText))
                    userInput.focus();
                    return;
                }
            }

            // add by yuluo 个保协议增加
            // 判断是否同意标识 以及是否需要展示
            // 如果不同意且需要展示
            // 短信登录不调用这个接口
            if(!recruitmentPolicy.options.isAgree && recruitmentPolicy.options.isDispaly && type !== 'sms'){
                // todo api调用
                // 接口判断是否需要展示  如果需要展示 显示个保窗口， 不需要  修改isdisplay=false;
                recruitmentPolicy.methods.validatePrivacy(function(res){
                    if(res.code != 0){
                        recruitmentPolicy.options.isDispaly = false;
                        doLogin();
                        return;
                    }else{
                        recruitmentPolicy.options.confirmAfter = function(){
                            recruitmentPolicy.options.isAgree = true;
                            $('#infoType').val(recruitmentPolicy.options.infotypeArr.join(','));
                            $('#loginConfirmationInfo').val(true);

                            // 再次执行dologin
                            doLogin()
                        }
                    }
                })
                // 不执行下面逻辑
                return;
            }
            // 如果同意  或者不需要展示，则不执行上述程序
            // end by yuluo 个保协议增加
            if (type !== 'sms') {
                var validateFlag = document.getElementById("form1").onsubmit();
            } else {
                var validateFlag = true;
                
                
                
                
                
                
                
                
            }

            if (validateFlag) {
                localStorage.setItem("privaryCheckFlag", 0);
                
                // ATS-96099
                $.ajax({
                    cache: false,
                    type: "POST",
                    data: {corpCode:corpName},
                    // async: false,
                    url: '/wt/loginInfo?r='+Math.random(),
                    error: function (request) {
                        // alert("Connection error");
                        wtspeModalWarning("Connection error")
                    },
                    success: function (datas) {
                        //debugger;
                        // console.log("datas:"+datas);
                        var ts = datas.time;
                        document.getElementById("timeSign").value= fTrim(ts);
                        localStorage.setItem('atsPassType',datas.atsPassType);
                        localStorage.setItem('atsPassKey',datas.atsPassKey);
                        // document.getElementById("timeSign").value= fTrim(ts);
                        // Add by Y.Z. on 2011-11-27 14:46:44. Start.
                        //saveCookie();
                        document.getElementById("remremberMeInput").value = document.getElementById("remremberMe").checked;
                        // encryption();
                        if (type !== 'sms') {
                            encryption(function () {
                                checkNum = 0;
                                // if(!checkPasswod()) {
                                //     return;
                                // }
                                document.getElementById("loginImg").onclick = "#";
                                document.getElementById("form1").submit();
                                $.cookie("phoneNum", '',{ expires: 7 });
                                $.cookie("verification", '',{ expires: 7 });
                                //存入cookie中
                                if ($("#remremberMe").attr("checked")) {
                                    $.cookie("rmbUser", "true",{ expires: 7 });
                                    $.cookie("username", userName,{ expires: 7 });
                                    $.cookie("corpCode", corpName,{ expires: 7 });
                                }
                                else {
                                    $.cookie("rmbUser", "false", { expire: -1 });
                                    $.cookie("username", "", { expires: -1 });
                                    $.cookie("corpCode", "", { expires: -1 });
                                }
                            })
                        } else {
                            encryptionPhone(function (phone, code) {
                                checkNum = 0;
                                // if(!checkPasswod()) {
                                //     return;
                                // }
                                document.getElementById("loginImg").onclick = "#";
                                var verificationInput = $('<input>', {
                                    'name': 'phoneNum',
                                    'value': phone,
                                    'type': 'hidden'
                                });
                                var phoneNumInput = $('<input>', {
                                    'name': 'verification',
                                    'value': code,
                                    'type': 'hidden'
                                });
                                $('#form1').append(verificationInput);
                                $('#form1').append(phoneNumInput);
                                document.getElementById("form1").submit();

                                var phoneInp = document.getElementById('phoneNum');
                                var codeInp = document.getElementById('verification');
                                //存入cookie中
                                if ($("#remremberMe").attr("checked")) {
                                    $.cookie("rmbUser", "true",{ expires: 7 });
                                    $.cookie("phoneNum", fTrim(phoneInp.value),{ expires: 7 });
                                    $.cookie("verification", fTrim(codeInp.value),{ expires: 7 });
                                    $.cookie("corpCode", corpName,{ expires: 7 });
                                }
                                else {
                                    $.cookie("rmbUser", "false", { expire: -1 });
                                    $.cookie("phoneNum", '',{ expires: 7 });
                                    $.cookie("verification", '',{ expires: 7 });
                                    $.cookie("corpCode", "", { expires: -1 });
                                }
                            })
                        }
                    }
                });
            }
        }

        function checkPasswod() {
            checkNum++;
            // var pwd = document.getElementById("password").value;
            var pwd = document.getElementById("hidden-pwd").value;
            if(pwd.length != 32) {
                // if(checkNum > 50) {
                // if(checkNum > 50) {
                //     alert("使用浏览器记录的密码无法登录，请再次点击登录按钮尝试，或重新输入密码登录！");
                //     return false;
                // }
                // encryption();
                encryption(function () {
                    return checkPasswod();
                });
                // return checkPasswod();
            }
            return true;
        }
        function encryptionPhone(cb) {
            var atsPassType = localStorage.getItem("atsPassType");
            var atsPassKey = localStorage.getItem("atsPassKey");
            var phoneInp = document.getElementById('phoneNum');
            var codeInp = document.getElementById('verification');
            var phone = fTrim(phoneInp.value);
            var code = fTrim(codeInp.value);
            if(atsPassType==3){
                phone = sm4Encrypt_ECB(phone,atsPassKey);
                code = sm4Encrypt_ECB(code,atsPassKey);
            }else{
                var key = CryptoJS.enc.Utf8.parse(atsPassKey);
                var srcsPhone = CryptoJS.enc.Utf8.parse(phone);
                var srcsCode = CryptoJS.enc.Utf8.parse(code);
                var encryptedPhone = CryptoJS.AES.encrypt(srcsPhone, key, {
                    mode: CryptoJS.mode.ECB,
                    padding: CryptoJS.pad.Pkcs7
                });
                var encryptedCode = CryptoJS.AES.encrypt(srcsCode, key, {
                    mode: CryptoJS.mode.ECB,
                    padding: CryptoJS.pad.Pkcs7
                });
                phone = encryptedPhone.ciphertext.toString();
                code = encryptedCode.ciphertext.toString();
            }
            ( typeof cb === 'function' ) && cb(phone, code);
        }
        function encryption(cb) {
            // var sign = getServerTime();
            //document.getElementById("timeSign").value= sign;
            // var sign = document.getElementById("timeSign").value;
            var atsPassType = localStorage.getItem("atsPassType");
            var atsPassKey = localStorage.getItem("atsPassKey");
            var pwdInput = document.getElementById("password");
            var hiddenPwdInput = document.getElementById("hidden-pwd");
            var pwd = fTrim(pwdInput.value);
            if(atsPassType==3){
                pwd = sm4Encrypt_ECB(pwd,atsPassKey);
            }else{
                var key = CryptoJS.enc.Utf8.parse(atsPassKey);
                var encrypted = '';
                var srcs = CryptoJS.enc.Utf8.parse(pwd);
                encrypted = CryptoJS.AES.encrypt(srcs, key, {
                    mode: CryptoJS.mode.ECB,
                    padding: CryptoJS.pad.Pkcs7
                });
                pwd = encrypted.ciphertext.toString();
            }
            // pwd = hex_md5(pwd,1);
            // pwd = hex_md5(pwd+"+"+sign,1);
            pwdInput.focus();
            // pwdInput.value= pwd;
            hiddenPwdInput.value = pwd;
            ( typeof cb === 'function' ) && cb();
        }

        function getSysteTime() {
            $.ajax({
                cache: false,
                type: "POST",
                async: false,
                url: '/wt/systemTime?r='+Math.random(),
                error: function (request) {
                    // alert("Connection error");
                    wtspeModalWarning("Connection error")
                },
                success: function (datas) {
                    document.getElementById("timeSign").value= fTrim(datas);
                }
            });
        }

        var i = 1;
        function changeVerifyCode() {
            i = i + 1;
            var validateFlag = document.getElementById("verifyCodeImg");
            validateFlag.src = "/wt/img/verifyCode" + "?type=Corp&" + i;
        }
        function forceLogout(url) {
            // 清理缓存
            clearCookie()
            if (confirm('是否将已登录的该用户强制退出？')) {
                document.location = url;
            }
        }

        function openFindPassword(){
            var url = '/wt/tlf/forget-password/forget';
            var username = $('#userName').val();
            var corpCode = $('#corpCode').val();
            window.open(url + '?username='+username+'&corpcode='+corpCode)

        }

        function clearCookie() {
            var keys = document.cookie.match(/[^ =;]+(?=\=)/g);
            if (keys) {
                for (var i = keys.length; i--;) {
                    document.cookie = keys[i] + '=0;path=/;expires=' + new Date(0).toUTCString();//清除当前域名下的
                    document.cookie = keys[i] + '=0;path=/;domain=' + document.domain + ';expires=' + new Date(0).toUTCString();//清除当前域名下的
                }
            }
        }
        var needHidden = true;

        function inputOnblur(defaultValue, obj, spanId) {
            var value = obj.value;
            // if (value == "") {
            //     obj.value = defaultValue;
            // }
            if (needHidden) {
                $("#" + spanId).css("display", "none");
                //needHidden=false;
            }
            // 企业code 失焦时判断是否为扫码登录，如果是请求二维码接口

            setTimeout(function(){
                setLoginBtnState()
                if(spanId === 'corpCodeSpan'){
                    if(value.trim() === '' && currentCodeImgLoginType){
                        In_errorToast({
                            contentText: corpIdPlaceholder,
                        });
                    } else if(spanId === 'corpCodeSpan' && $(".isCodeImgLogin").is(":visible")){
                        getCodeImgFn();
                    }
                }
            }, 100);

            return;
        }
        function inputOnFocus(defaultValue, obj, spanId) {
            var value = obj.value;
            if (value == defaultValue) {
                var a = obj.createTextRange();
                a.moveStart('character', 0);
                a.collapse(true);
                a.select();
            }
            //$("#"+spanId).css("display","");
            needHidden = true;
            $("#" + spanId).css("display", "block");
        }
        function inputOnKeyDown(defaultValue, obj) {
            var value = obj.value;
            if (value == defaultValue) {
                obj.value = "";
            }
        }

        function clearInput(inputId) {
            //alert("111");
            $("#" + inputId).val("");

            $("#" + inputId + "Span").css("display", "none");
            needHidden = true;
        }
        function clearPwd(flg, inputId) {
            setLoginBtnState()
            if (flg == 'in') {
                // $("#"+inputId).css("display","");
                $("#" + inputId).css("display", "block");
                needHidden = true;
            } else {
                if (needHidden) {
                    $("#" + inputId).css("display", "none");
                }
            }
        }

        function spanMouseOver() {
            needHidden = false;
        }
        function spanMouseOut() {
            needHidden = true;
        }
        function changelocale(lang, locale = 'zh_CN') {
            setTempCookie("wintalent3.locale", lang);
            var link = "/wt/login!input?operational=8465e1e115636bdd3d1f78de7cf351762ec6a81dafe13e55cc2f1016d89e19d105cf04c70be83718";
            link += (link.indexOf('?') > -1 ? '&' : '?') + "request_locale=" + locale;

            document.location = link;
        }
        var validatePrivacyLoginUrl = '/wt/common/getLoginConfirmationInfo';
    </script>
