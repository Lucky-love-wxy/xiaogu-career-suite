                                var img = '/wt/v9/static/assets/loginbg_default_changhong_min.png';
                            } else {
                                var img = '/wt/v9/static/assets/loginbg_default.jpg';
                            }
                            $(".logoBg").css("background-image", 'url(' + img + ')');
                        }
                        //图片跳转链接
                        if( (typeof result.imgLinkUrl !== 'undefined') && result.imgLinkUrl){
                            $(".logoBg").click(function(e){
                                if(e.target == this){
                                    window.open(result.imgLinkUrl)
                                }
                            })
                        }
                        if( (typeof result.videoUrl !== 'undefined') && result.videoUrl){
                            $(".logoBg").html('<video class="video-box" controls="controls"  playsinline="true" webkit-playsinline="true" x5-playsinline="true" x5-video-orientation="portraint" x5-video-player-fullscreen="true" x5-video-player-type="h5">'+
                                '<source src="'+ result.videoUrl +'" /></video>')
                        }


                        /* if ( (typeof result.logoUrl !== 'undefined') && result.logoUrl) {
                            var logoImg = "/wt/console/config/illustration/file?imgUrl=" + result.logoUrl;
                            $("#logoImg").attr("src", logoImg);
                        } */

                        if ( (typeof result.sloganUrl !== 'undefined') && result.sloganUrl) {
                            var sloganImg = "/wt/console/config/illustration/file?imgUrl=" + result.sloganUrl;
                            $("#sloganImg").attr("src", sloganImg);
                        }

                        if(!result.imgUrl && !result.videoUrl) {
                            $(".loginBg").addClass('loginBg-no-data');
                        } else {
                            $('.loginBg').css('border-top-right-radius', '0px');
                            $('.loginBg').css('border-bottom-right-radius', '0px');
                            $('.banner').css('border-top-left-radius', '0px');
                            $('.banner').css('border-bottom-left-radius', '0px');
                        }
                    }
                }, error: function (XMLHttpRequest, textStatus, errorThrown) {
                }
            });
        });

        function GetQueryString(name){
            var reg = new RegExp("(^|&)"+ name +"=([^&]*)(&|$)");
            var r = window.location.search.substr(1).match(reg);
            if(r!=null)return  unescape(r[2]); return null;
        };
        $(function(){    //根据登录页面url参数初始化cookies值
            if (isChangHong) {
                $('.footer_login').hide()
                document.title = changHongTitle;
                $('.login-subtitle-ltext').html(changHongTitle)
                $('.login-subtitle-rtext').html('')
                $("#password").css("padding-right", "120px");
            } else if(GetQueryString("request_locale") == "en" || GetQueryString("request_locale") == "in_ID"
                || GetQueryString("request_locale") == "vi_VN"
                || GetQueryString("request_locale") == "es_ES"
                || GetQueryString("request_locale") == "pt_PT"
                || GetQueryString("request_locale") == "de_DE"
                || GetQueryString("request_locale") == "tr_TR"
                || GetQueryString("request_locale") == "ja_JP"){
                $('.login-subtitle-ltext').html('云招聘系统')
