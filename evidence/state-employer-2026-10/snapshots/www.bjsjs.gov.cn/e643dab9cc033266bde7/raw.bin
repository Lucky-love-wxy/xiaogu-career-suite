</div>

<div class="dialog_mask">&nbsp;</div>
<script type="text/javascript">
			let locationHref = ''
		$(function(){

			$('a').click(function(e){
				// 判断点击的是否是A标签
				if(e.target.nodeName === 'A'){
					locationHref = e.target.href
				}else{
					locationHref = $(e.target).parents('a').attr('href')
				}
				if (locationHref && (locationHref.indexOf('http://www.bjsjs.gov.cn/')===-1) && locationHref.indexOf('.gov.cn')===-1) {
					if (locationHref.indexOf('http://')!==-1 || locationHref.indexOf('https://')!==-1) {
						// 阻止默认事件
						e.preventDefault()
						// 阻止冒泡
						e.stopPropagation()
						// 保存外链地址
						//locationHref = e.target.href
						// 获取滚动条距顶部的距离
						const winTop = $(window).scrollTop()
						// 显示遮罩
						$('.dialog_mask').css({
							'top':winTop+'px'
						}).show()
						// 禁止页面滚动
						$('body').css({
							overflow: 'hidden'
						})
						// 显示弹窗
						$('.dialog_other_link').stop().animate({
							top: 100+winTop+'px'
						},300)
					}
				}
			})
			// 关闭按钮
			$('.btn_fq,.dialog_other_link .close,.dialog_mask').click(function(){
				$('.dialog_other_link').stop().animate({
					top:'-270px'
				},300)
				$('.dialog_mask').hide()
				$('body').css({
					overflow: 'auto'
				})
			})
			// 继续访问
			$('.btn_jxfw').click(function(){
				//window.location.href = locationHref
                                  window.open(locationHref)
                                $('.dialog_other_link').stop().animate({
					top:'-270px'
				},300)
				$('.dialog_mask').hide()
				$('body').css({
					overflow: 'auto'
				})   
			})
			
		});


		
	</script>

    <script src="./images/swiper-3.4.2.min.js"></script>
    <script>
        //中央要闻/北京新闻
        $.ajax({
            url: "https://www.beijing.gov.cn/shouye/tltt/pushCommitteeNews_33256.js",
            dataType: "jsonp",
            scriptCharset: "UTF-8",
            jsonp: "pushInfoJsCallBack",
            jsonpCallback: "pushInfoJsCallBack",
            success: function (res) {
                var data = res.data1[0];
                var xhtml = '';
                var zyhtml = '';
                var bjhtml = '';
                xhtml += '<a href="' + data.link + '" title="' + data.title + '" target="_blank">' +
                    '    <h3>' + data.title + '</h3>' +
                    '    <h3>' + data.subtitle + '</h3>' +
                    '</a>' +
                    '<p class="more"><a href="https://www.beijing.gov.cn/ywdt/dzyjs/index.html" target="_blank">更多>></a></p>';
                $(".headline_news").html(xhtml);
                var data1 = res.data2
                for (var i = 0; i < 7; i++) {
                    zyhtml += '<li><a href="' + data1[i].link + '" target="_blank">' + data1[i].title + '</a></li>'
                }
                $('#zyyw').html(zyhtml)
                var data2 = res.data3
                for (var i = 0; i < 7; i++) {
                    bjhtml += '<li><a href="' + data2[i].link + '" target="_blank">' + data2[i].title + '</a></li>'
                }
                $('#bjxw').html(bjhtml)
            },

        });
        //表单提交开始
        // 头部搜索
        // 头部搜索
        $('#search').submit(function () {
            var type = $('#search .tit').text().trim()
            if (type == '站内搜索') {
                window.open('https://www.bjsjs.gov.cn/so/s?qt=' + $('#search input[name="qt"]').val() + '&siteCode=1101070001')
            } else if (type == '一网通查') {

                window.open('https://www.beijing.gov.cn/so/s?qt=' + $('#search input[name="qt"]').val() + '&sourceCode=1101070001')
            }
        })
        // 法人搜索
        $('#frSearch').click(function () {
            var adx = $('#frAdx').text().trim()
            var asmzq = $('#frAsmzq').text().trim()
            var href = 'https://www.beijing.gov.cn/zhengce/zcdh?type=1&adx=' + adx + '&asmzq=' + asmzq
            window.open(href)
        })
        //个人搜索
        $('#grSearch').click(function () {
            var adx = $('#grAdx').text().trim()
            var asmzq = $('#grAsmzq').text().trim()
            var href = 'https://www.beijing.gov.cn/zhengce/zcdh?type=0&adx=' + adx + '&asmzq=' + asmzq
            window.open(href)
        })
        // 表单提交结束
        $('.searchTit .tit').click(function () {
            $(this).next().toggle()
            $(this).toggleClass('on')
        })

        $('#search .options li').click(function () {
            $(this).addClass('on').siblings().removeClass('on')
            $('#search .options').toggle()
            $('#search .searchTit .tit span').text($(this).text())
            $('#search .searchTit .tit').removeClass('on')
        })
        $('.topMenu>li').mouseenter(function () {
            $('.menu_secondary').hide();
            $('.topMenu>li>a').removeClass('on');
            $(this).find('.menu_secondary').show();
            $(this).children('a').addClass('on');
        });

        $('.topMenu>li').mouseleave(function () {
            $('.menu_secondary').hide();
            $('.topMenu>li>a').removeClass('on');
        });
        var topSwiper = new Swiper('.top-swiper', {
            pagination: '.top-pagination',
            paginationClickable: true,
        })

        var infoSwiper = new Swiper('.info-swiper', {
            autoHeight: true,
            onSlideChangeStart: function (swiper) {
                $('.infoNav li').eq(swiper.activeIndex).addClass('on').siblings().removeClass('on')
            },
            onInit: function (swiper) {
                $('.infoNav li').eq(swiper.activeIndex).addClass('on')
            }

        })
        $('.infoNav li').hover(function () {

            if ($(this).index() < infoSwiper.slides.length) {
                infoSwiper.slideTo($(this).index())
            }

        })
        $(".zzc-swiper .input").on("click", function (event) {
            event.stopPropagation();
            $(this).next().toggle()
            $(this).toggleClass("on")

        })
        $("body").on("click", function (event) {
            if ($(".zzc-swiper .input").hasClass("on")) {
                $(".zzc-swiper ul").hide();
                $(".zzc-swiper .input").removeClass("on");
            }
        });
        $('.zzc-swiper li').click(function () {
            var $this = $(this)
            $this.addClass('on').siblings().removeClass('on')
            $this.parent().toggle()
            $this.parent().prev().children('.con').text($this.text())
            $this.parent().prev().removeClass('on')
        })
        var zzcSwiper = new Swiper('.zzc-swiper', {
            onSlideChangeStart: function (swiper) {
                $('.zzcNav li').eq(swiper.activeIndex).addClass('on').siblings().removeClass('on')
            }
        })
        $('.zzcNav li').click(function () {
            zzcSwiper.slideTo($(this).index())
        })
        $('.zcSearch .tit').click(function () {
            $(this).children('ul').toggle()
            $(this).toggleClass('on')
        })
        $('.zcSearch li').click(function () {
            $(this).addClass('on').siblings().removeClass('on')
            $('.zcSearch .tit span').text($(this).text())

        })
        var midSwiper = new Swiper('.mid-swiper', {
            autoHeight: true,
            onSlideChangeStart: function (swiper) {
                $('.midNav li').eq(swiper.activeIndex).addClass('on').siblings().removeClass('on')
            }

        })
        $('.midNav li').click(function () {
            midSwiper.slideTo($(this).index())
        })

        var zcSwiper = new Swiper('.zc-swiper', {
            onSlideChangeStart: function (swiper) {
                $('.zcHed li').eq(swiper.activeIndex).addClass('on').siblings().removeClass('on')
                if(swiper.activeIndex==0){
                   $('.zcBox .more').attr('href','https://www.bjsjs.gov.cn/gongkai/zcwjk/')
                }else{
                   $('.zcBox .more').attr('href','https://www.bjsjs.gov.cn/gongkai/zcwjk/zcjd25/')
                }
            }
        })
        $('.zcHed li').hover(function () {
            zcSwiper.slideTo($(this).index())
        })
        var yjsSwiper = new Swiper('.yjs-swiper', {
            pagination: '.yjs-pagination',
            paginationClickable: true,
            nextButton: '.yjs-next',
            prevButton: '.yjs-prev'

        })
        var fwSwiper = new Swiper('.fw-swiper', {
            onSlideChangeStart: function (swiper) {
                $('.fwBox .hedNav li').eq(swiper.activeIndex).addClass('on').siblings().removeClass('on')
            }
        })
        $('.fwBox .hedNav li').click(function () {
            $('.fwBox .hedNav .hk').css('left', $(this).position().left)
            fwSwiper.slideTo($(this).index())
        })
        var zcwdkSwiper = new Swiper('.zcwdk-swiper', {
            nextButton: '.zcwdk-next',
            prevButton: '.zcwdk-prev'
        })
        var dclxSwiper = new Swiper('.dclx-swiper', {
            onSlideChangeStart: function (swiper) {
                $('.dclxNav li').eq(swiper.activeIndex).addClass('on').siblings().removeClass('on')
                if(swiper.activeIndex==0){
                   $('.dclxNav .more').attr('href','https://www.bjsjs.gov.cn/zmhd/dczj/')
                }else{
                   $('.dclxNav .more').attr('href','https://sjswd.bjsjs.gov.cn/hudong/xinxiang/bjsjs/sindex/xx-bjsjs.html')
                }
            }

        })

        $('.dclxNav li').click(function () {
            dclxSwiper.slideTo($(this).index())
        })


        $('.rightMenu h3').click(function(){

            $(this).next().toggleClass('on')

        })

        var ybsftSwiper = new Swiper('.ybsft-swiper', {
            pagination:'.ybsft-pagination',
            paginationClickable: true,
            
        })
        //处理一件事折行
        $('.yjs-swiper .swiper-slide li').each(function(){
            var el  = $(this).find('.tit')
            var tit = el.text().trim()
            if(tit.indexOf('“一件事”')>-1){
                el.html(tit.replace(/“一件事”/g,'<br>“一件事”'))
            }else{
                el.html(tit)
            }
        })
        // 横向无缝滚动实现 - 兼容IE版本
        function initHorizontalScroll() {
            var scrollContainer = document.querySelector('.column-scroll-container');
            var scrollList = document.querySelector('.scroll-list');
            var listItems = scrollList.querySelectorAll('li');
            if (!scrollContainer || !scrollList || listItems.length === 0) return;
            // 克隆列表项以实现无缝循环
            var cloneList = scrollList.cloneNode(true);
            cloneList.className = 'scroll-list clone-list'; // 添加克隆标识
            scrollContainer.appendChild(cloneList);
            
            // 计算总宽度 - 使用实际元素尺寸
            var itemWidth = listItems[0].offsetWidth; 
            console.log(itemWidth)
            //右边距
            let computedStyle = window.getComputedStyle(listItems[0])
            //20px转换成20
            var itemMargin = parseFloat(computedStyle.marginRight); // li 右边距

            var totalWidth = (itemWidth + itemMargin) * listItems.length;
            // 设置容器样式 - IE兼容方式
            scrollList.style.width = totalWidth + 'px';
            scrollList.style.left = '0px';
            cloneList.style.width = totalWidth + 'px';
            cloneList.style.left = '0px';
            var currentPos = 0;
            var speed = 1; // 滚动速度
            var isScrolling = true;
            var animationId;
            // 初始化克隆列表位置
            if (cloneList.style.transform !== undefined) {
                cloneList.style.transform = 'translateX(' + totalWidth + 'px)';
            } else {
                cloneList.style.left = totalWidth + 'px';
            }
            // 滚动动画函数
            function scrollAnimation() {
                if (isScrolling) {
                    currentPos -= speed;
                    // 当第一个列表完全移出视野时，重置位置
                    if (Math.abs(currentPos) >= totalWidth) {
                        currentPos = 0;
                    }
                    // 使用transform或left属性（IE8+兼容）
                    if (scrollList.style.transform !== undefined) {
                        scrollList.style.transform = 'translateX(' + currentPos + 'px)';
                        cloneList.style.transform = 'translateX(' + (currentPos + totalWidth) + 'px)';
                    } else {
                        // IE8及以下版本使用left属性
                        scrollList.style.left = currentPos + 'px';
                        cloneList.style.left = (currentPos + totalWidth) + 'px';
                    }
                }
                
                // 使用requestAnimationFrame或setTimeout兼容IE
                if (window.requestAnimationFrame) {
                    animationId = requestAnimationFrame(scrollAnimation);
                } else {
                    animationId = setTimeout(scrollAnimation, 16); // 约60fps
                }
            }
            
            // 开始滚动
            scrollAnimation();
            // 鼠标事件处理 - IE兼容
            function addEvent(element, event, handler) {
                if (element.addEventListener) {
                    element.addEventListener(event, handler, false);
                } else if (element.attachEvent) {
                    element.attachEvent('on' + event, handler);
                }
            }
            
            // 鼠标悬停暂停滚动
            addEvent(scrollContainer, 'mouseenter', function() {
                isScrolling = false;
            });
            
            // 鼠标离开继续滚动
            addEvent(scrollContainer, 'mouseleave', function() {
                isScrolling = true;
            });
        }
        // 页面加载完成后初始化滚动 - IE兼容
        initHorizontalScroll()
    </script>
</body>

</html>