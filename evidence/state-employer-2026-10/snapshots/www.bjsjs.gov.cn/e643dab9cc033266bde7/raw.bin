                                                                       document.write('<a  href="'+html+'" target="_blank" class="jggs">结果公示</a>')
                                                                    }
                                                                    document.write('<div class="yjs">已结束</div>');
								} 
                                                </script>
					  
					
                                </li>
                             

                            </ul>
