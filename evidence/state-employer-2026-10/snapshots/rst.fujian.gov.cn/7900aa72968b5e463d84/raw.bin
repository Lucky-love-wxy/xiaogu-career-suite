			var slideH = 356 * _w / 633;
			$slideBox.height(slideH);
			//   slideImg.height(slideH);
			slideLi.height(slideH);
			$("#slideBox").slide({
				titCell: ".hd ul",
				mainCell: ".bd ul",
				autoPage: "<li></li>",
				effect: "left",
				autoPlay: true,
				vis: 1
			});
			//网上调查、意见征集
			$('#tabWsdc').slide({
				titCell: ".hd li",
				mainCell: ".bd",
				effect: "left",
				titOnClassName: "actt",
			});
			$('#tabZxwj').slide({
				titCell: ".hd li",
				mainCell: ".bd",
				effect: "left",
				titOnClassName: "actt",
			});
			$('#tabXsfc').slide({
				titCell: ".hd li",
				mainCell: ".bd",
				effect: "left",
				titOnClassName: "actt",
			});
			$('#tabZcjd').slide({
				titCell: ".hd li",
				mainCell: ".bd",
				effect: "left",
				titOnClassName: "actt",
			});
			$('#tsfw_tab').slide({
				titCell: ".hd li",
				mainCell: ".bd",
				effect: "left",
				titOnClassName: "actt",
			});
			// 网上调查
			pollList({
				objId: 'wsdc',
				listCheck: { chnlIds: { required: false } },
				listApi: {
					url: '/staticitp/rst/N_772/1.json?r=' + Math.random(), type: "get", pageName: '', prepageName: ''

				},
			});

			// 意见征集
			adviceList({
				objId: 'yjzj',
				listCheck: { chnlIds: { required: false } },
				listApi: {
					url: '/staticitp/rst/D_604/1.json?r=' + Math.random(), type: "get", pageName: '', prepageName: ''

				},
			});
			//专题专栏
			var vis = 4,
				width = $(window).width();
			if (width < 1001 && width > 499 || $.cookie("BFree") == "2") {
				vis = 2;
			}
			if (width < 500) {
				vis = 1;
			}
			$("#focusBox1").slide({
				mainCell: ".leftscroll",
				effect: "left",
				autoPlay: true,
				autoPage: true,
				scroll: 1,
				vis: vis,
				delayTime: 500,
				trigger: "click"
			});
			$(".txtMarquee-left").slide({
				mainCell: ".bd ul",
				autoPlay: true,
				effect: "leftMarquee",
				vis: 2,
				interTime: 50
			});

			$(".jt-btn1").mouseover(function () {
				$(this).addClass("bluebg");
			});
			$(".jt-btn2").mouseover(function () {
				$(this).addClass("bluebg");
			});
			$(".jt-btn1").mouseleave(function () {
				$(this).removeClass("bluebg");
			});
			$(".jt-btn2").mouseleave(function () {
				$(this).removeClass("bluebg");
			});

			$(".djtc").click(function () {
				$(".tc").show();
			}).mouseout(function () {
				$(".tc").hide();
			});

		})
		// 无障碍tab切换

		setTimeout(function () {
			tabWza('#tabTabqh', '#tabTabqh-bd .rsgb-yw-list');
			tabWza('#tabWsdc', '#tabWsdc-bd .tabWsdc-bd-list');
		}, 2000)


		tabWza('#tabZxwj', '#tabZxwj-bd .rsgb-yw-list');
		tabWza('#tabXsfc', '#tabXsfc-bd .rsgb-yw-list');
		tabWza('#tabZcjd', '#tabZcjd-bd .tabZcjd-bd-list');


		(function (jQuery) {
			jQuery.fn.imgFloat = function (options) {
				var own = this;
				var xD = 0;
				var yD = 0;
				var i = 1;
				var settings = {
					speed: 10,
					xPos: 0,
					yPos: 0
				};
				jQuery.extend(settings, options);
				var ownTop = settings.xPos;
				var ownLeft = settings.yPos;
				own.css({
					position: "absolute",
					cursor: "auto"
					//cursor: "pointer"
				});

				function imgPosition() {
					var winWidth = jQuery(window).width() - own.width();
					var winHeight = jQuery(window).height() - own.height();
					if (xD == 0) {
						ownLeft += i;
						own.css({
							left: ownLeft
						});
						if (ownLeft >= winWidth) {
							ownLeft = winWidth;
							xD = 1;
						}
					}
					if (xD == 1) {
						ownLeft -= i;
						own.css({
							left: ownLeft
						});
						if (ownLeft <= 0) xD = 0;
					}
					if (yD == 0) {
						ownTop += i;
						own.css({
							top: ownTop
						});
						if (ownTop >= winHeight) {
							ownTop = winHeight;
							yD = 1;
						}
					}
					if (yD == 1) {
						ownTop -= i;
						own.css({
							top: ownTop
						});
						if (ownTop <= 0) yD = 0;
					}
				}
				var imgHover = setInterval(imgPosition, settings.speed);
				own.hover(function () {
					clearInterval(imgHover);
				},
					function () {
						imgHover = setInterval(imgPosition, settings.speed);
					});
			}
		})(jQuery);



		// jQuery('#img_float2').imgFloat({
		//   speed: 30,
		//   xPos: 150,
		//   yPos: 10
		// });

	</script>
