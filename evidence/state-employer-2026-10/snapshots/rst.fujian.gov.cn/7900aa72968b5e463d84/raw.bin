<script src="/public/images/Fjtran.js"></script>
	<!-- 全站嵌套 end-->
	<script>
		require(["shangjizhuanzai", "list2.advice", "list2.poll", "jquery"], function (shangjizhuanzai, adviceList, pollList, $) {
			//国务院、省政府
			shangjizhuanzai({
				gwyxx: true,
				gwyxxNum: 9,
				szfxx: true,
				szfxxNum: 9,
				szfxxUrl: 'https://www.fujian.gov.cn/szfxx?callback=pushInfoJsonpCallBackfj'
			});
			//省局要闻选项卡切换
			$('#tabTabqh').slide({
				titCell: ".hd li",
				mainCell: ".bd",
