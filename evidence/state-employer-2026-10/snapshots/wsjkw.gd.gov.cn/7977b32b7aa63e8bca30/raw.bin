<script>
$(function() {

    $("body a").click(function () {
        var url = $(this).attr("href");
        var nowUrl = window.location.href;
        if (url.indexOf("javascript:void(0)") > -1) {
            return true;
        } else if ($.trim(url).substr(0, 2).indexOf("./") > -1 || url.indexOf("gov.cn") > -1 || $.trim(url)
            .substr(0, 1).indexOf("#") > -1) {
            return true;
        } else {
            checkUrl(url);
            return false;
        }
    });

    var jumpInterval;
    $(".layui-layer-btn0").click(function () {
        var url = $(".layui-layer-btn0").attr("data-url");
        //window.location.href = url;
        clearInterval(jumpInterval);
        //window.open(url);
        var tempwindow = window.open('about:blank', '_blank'); // 先打开页面
        tempwindow.location = url; // 后更改页面地址
        $(".filter").hide();
        $(".aTips").hide();
    });

    $(".layui-layer-btn1").click(function () {
        $(".filter").hide();
        $(".aTips").hide();
        clearInterval(jumpInterval);
    });

    function checkURL(url) {
        if (url.indexOf("javascript:void(0)") > -1) {
            return true;
        } else if (url.indexOf("gd.gov.cn") > -1 || $.trim(url).substr(0, 2).indexOf("./") > -1 || url.indexOf(
            "gov.cn") > -1 || $.trim(url).substr(0, 1).indexOf("#") > -1) {        
            var tempwindow = window.open('about:blank', '_blank'); // 先打开页面
            tempwindow.location = url; // 后更改页面地址
            return true;
        } else {
            checkUrl(url);
            return false;
        }
    }

    function checkUrl(url) {
        $(".filter").show();
        $(".aTips").show();
        $(".layui-layer-btn0").attr("data-url", url);
        jumpInterval = setInterval(function () {
            autoJump(url);
        }, 3000);
    }

    function autoJump(url) {   
        var tempwindow = window.open('about:blank', '_blank'); // 先打开页面
        tempwindow.location = url; // 后更改页面地址
        $(".filter").hide();
        $(".aTips").hide();
        clearInterval(jumpInterval);
    }  
    
})
</script>

