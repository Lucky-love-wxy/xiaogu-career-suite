<script>
    // 政声传递
    $.ajax({
        url: "https://app.gd.gov.cn/xxts/pushinfo_json.php",
        dataType: 'jsonp',
        data: '',
        jsonp: 'callback',
        jsonpCallback: 'pushInfoJsonpCallBack',
        success: function (result) {

            $("#zscd_pushDataInfo").empty();
            var content = "";
            var font_style =
                'style="overflow: hidden; text-overflow:ellipsis;white-space: nowrap;"';

            for (var i = 0; i < 8; i++) {
                //alert(result[i].title);
                var timer = result[i].pubDate.substring(0, 12);
                var title = result[i].title;
                var link = result[i].link;
                var t_len = title.length;
                
                content = content + "<li><a " + font_style + " href=\"" + link + "\" target='_blank'>" +  title + "</a><span>" + timer + "</span></li>";
                

            }
            
            $("#zscd_pushDataInfo").append(content);
            // $("#zscd_pushDataInfo>li:nth-child(1)").addClass("list-tis")
        },
    });

    // $('#frame-sgs').attr('src','https://xdba.gdhealth.net.cn/wjwdc/V8Page.m?type=desktop&pid=sgs_gy&sessionId=FIXED999');

    $('#frame-sgs').attr('src','https://zwfw.gdswjw.cn/public/V8.m?uecdt=0@2c2Vzc2lvrbklkPrUZeJWEVEOTk5JnR5cvGU9sZGVza3RvcCZweaWQ9c2dzX2d5.32.44.8.29.15.13');

    // 切换增强
    bindArrow({
        // 切换页头
        tabs: '#tab .tab a',
        // 切换内容
        tabsPanel: '#tab .tab_contain',
        // 子节点如果存在a、button，需写上
        // childNode: 'a',
        // 切换高亮
        active: 'cur'
    })

    // 切换增强
    bindArrow({
        // 切换页头
        tabs: '#tab1 .tab1 a',
        // 切换内容
        tabsPanel: '#tab1 .tab_contain1',
        // 子节点如果存在a、button，需写上
        // childNode: 'a',
        // 切换高亮
        active: 'cur1'
    })

    function bindArrow(obj) {
        var $tabs = $(obj.tabs)
        var $index = 0

        //初始化
        init()

        function init() {
            var initCount = 0
            if (obj.childNode) {
                setChildNode(initCount)
            }
            $tabs.attr(
            {
                tabindex: '-1',
                'aria-selected': 'false'
            }).removeClass(obj.active)

            $($tabs.get($index)).attr(
            {
                tabindex: '0',
                'aria-selected': 'true'
            }).addClass(obj.active)
        }

        $tabs.bind(
        {
            keydown: function(ev){
                var LEFT_ARROW = 37;
                var UP_ARROW = 38;
                var RIGHT_ARROW = 39;
                var DOWN_ARROW = 40;

                var k = ev.which || ev.keyCode;

                if (k >= LEFT_ARROW && k <= DOWN_ARROW){
                    if (k == LEFT_ARROW || k == UP_ARROW){
                        if ($index > 0) {
                            $index--;
                        }
                        else {
                            $index = $tabs.length - 1;
                        }
                    }
                    else if (k == RIGHT_ARROW || k == DOWN_ARROW){
                        if ($index < ($tabs.length - 1)){
                            $index++;
                        }
                        else {
                            $index = 0;
                        }
                    }
                    setFocus($index)
                    ev.preventDefault();
                }
            }
        })
        
        function setFocus($index) {
            $tabs.attr(
            {
                tabindex: '-1',
                'aria-selected': 'false'
            }).removeClass(obj.active)

            $($tabs.get($index)).attr(
            {
                tabindex: '0',
                'aria-selected': 'true'
            }).addClass(obj.active).focus()
            $(obj.tabsPanel).hide()

            $($(obj.tabsPanel).get($index)).show()
            setChildNode($index)
        }

        function setChildNode($index) {
            $tabs.find(obj.childNode).attr(
            {
                tabindex: '-1',
                'aria-selected': 'false'
            })

            $($tabs.get($index)).find(obj.childNode).attr(
            {
                tabindex: '0',
                'aria-selected': 'true'
            })
        }
    }   

  
</script>