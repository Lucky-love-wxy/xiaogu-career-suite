<script type="text/javascript">
	function getdates() {
		var w_array = new Array("星期天", "星期一", "星期二", "星期三", "星期四", "星期五", "星期六");
		var d = new Date();
		var year = d.getFullYear();
		var month = d.getMonth() + 1;
		var day = d.getDate();
		var week = d.getDay();
		if (month < 10) month = "0" + month;
		if (day < 10) day = "0" + day;
		var name = "今天是：" + year + "年" + month + "月" + day + "日" + " " + w_array[week];
		document.getElementById("date").innerHTML = name;
		setTimeout("getdates()", 1000);
	};
	getdates();
	$('#search-btn').bind('click', function() {
		$(this).parents('form').submit()
	});
	$('.search-in').bind('keyup', function(event) {
		e = event ? event : (window.event ? window.event : null);
		if (e.keyCode == 13) {
			$(this).parents('form').submit()
		}
	});
	$('.search-form').submit(function() {
		var key = $(this).find('input[name="keywords"]').val();
		if (!key) {
			alert('请输入关键词！');
			$(this).find('input[name="keywords"]').focus();
			return false;
		}
	});
</script>
