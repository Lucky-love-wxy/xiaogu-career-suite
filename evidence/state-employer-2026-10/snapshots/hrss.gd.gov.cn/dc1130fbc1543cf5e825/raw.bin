	<script>
		$(function(){
			$(".bot_link_tem").hover(function(){
				$(this).addClass("active");
				$(this).siblings(".bot_link_tem").removeClass("active")
			},function(){
				$(this).removeClass("active");
			});
    
		});
		// $(document).on("click",function(){
        //     $(".frd_link .bot_link_list").hide();
        //     $(".bot_link_tem").removeClass("active");
        // })
        $(".frd_link .bot_link_list li a").on('click', function (e) {
            $(".bot_link_des").removeClass("active");
        });
        $(".frd_link .bot_link_tem .bot_link_des").on("click", function () {
            if (event.stopPropagation) {
                // 针对 Mozilla 和 Opera
                event.stopPropagation();
            } else if (window.event) {
                // 针对 IE
                window.event.cancelBubble = true;
            }
            // $(".frd_link .bot_link_tem .bot_link_des").removeClass("active");
            if ($(this).parent(".bot_link_tem").find(".bot_link_list").is(':visible')) {//如果可见
                $(this).removeClass("active");
                // $(this).parent(".bot_link_tem").find(".bot_link_list").slideUp();
            } else {
                $(this).addClass("active");
                // $(this).parent(".bot_link_tem").find(".bot_link_list").slideDown();
            }
        });

        // 下拉改造
        bindSelect({
            menus: ".bot_link_list",
            selectedItem: ".bot_link_tem"
        })

        function bindSelect(obj) {  
            var $selectedItem = $(obj.selectedItem)
            var $menus = $(obj.menus)
            var $index = 0     
            $selectedItem.attr(
            {
                tabindex: '0',
                role: 'menu'
            })
            $menus.attr(
            {
                role: 'menuitem'
            })
            $selectedItem.bind(
            {
                keydown: function(ev, inx) {
                    var SPACE = 32
                    var ESC = 27  
                    var ENTER = 13        
                    var k = ev.which || ev.keyCode;
                    if (k == SPACE || k == ENTER) {
                        setFocus(ev)
                    }
                    if (k == ESC) {
                        setClose(ev)
                    }

                }
            })

            function setClose(ev) {
                var target = $(ev.target)
                var selectedItem = target.closest(obj.selectedItem)
                var panel = selectedItem.find(obj.menus)
                panel.hide()
                selectedItem.focus()
            }

            function setFocus(ev) {
                var panel = $(ev.target).find(obj.menus)
                $menus.hide()
                panel.show()
            }
        }
    </script>
