@keyframes fadeInLeft
{
    from {
        opacity: 0;
        -webkit-transform: translate(-500px,0); 
        transform: stranslate(-500px,0); 
    }
    to {
        opacity:1;
        -webkit-transform: translate(10px,0); 
        transform: stranslate(10px,0); 
    }
}
 
@-webkit-keyframes fadeInLeft 
{
    from {
        opacity:0;
       -webkit-transform: translate(-500px,0); 
        transform: stranslate(-500px,0); 
    }
    to {
        opacity:1;
        -webkit-transform: translate(10px,0); 
        transform: stranslate(10px,0); 
    }
}
