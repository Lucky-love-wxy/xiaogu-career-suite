    var st_lang = sessionStorage.getItem("st_lang")
    String.prototype.tran = function () {					//字体切换的方法
        var s1, s2;
        if (zh_choose == 't') {
            s1 = zh_s;
            s2 = zh_t;
        } else if (zh_choose == 's') {
            s1 = zh_t;
            s2 = zh_s;
        } else {
            return this;
        }
        var a = '';
        var l = this.length;
        for (var i = 0; i < this.length; i++) {
            var c = this.charAt(i);
            var p = s1.indexOf(c)
            a += p < 0 ? c : s2.charAt(p);
        }
        return a;
    }

    function zh_tranBody(obj) {
        var o = (typeof (obj) == "object") ? obj.childNodes : document.body.childNodes;
        for (var i = 0; i < o.length; i++) {
            var c = o.item(i);
            if ('||BR|HR|TEXTAREA|SCRIPT|'.indexOf("|" + c.tagName + "|") > 0) continue;
            if (c.className == zh_class) {
                if (c.id == zh_class + '_' + zh_choose) {
                    c.setAttribute('style', zh_style_active);
                    c.style.cssText = zh_style_active;
                } else {
                    c.setAttribute('style', zh_style_inactive);
                    c.style.cssText = zh_style_inactive;
                }
                continue;
            }
            if (c.title != '' && c.title != null) c.title = c.title.tran();
            if (c.alt != '' && c.alt != null) c.alt = c.alt.tran();             //图片alt文字
            if (c.placeholder != '' && c.placeholder != null) c.placeholder = c.placeholder.tran();         //文本框placeholder文本
            if (c.tagName == "INPUT" && c.value != '' && c.type != 'text' && c.type != 'hidden' && c.type != 'password') c.value = c.value.tran();
            if (c.nodeType == 3) {
                c.data = c.data.tran();
            } else {
                zh_tranBody(c);
            }
        }
    }
    function zh_tran(go, type) {
        if (go) zh_choose = go;
        if (go == "n") {
            window.location.reload();
        } else {
            if (type !== 2) {
                sessionStorage.setItem("st_lang", go)
            }
            zh_tranBody();
        }
    }
    function addLoadEvent(func) {
        if (document.all) {
            window.attachEvent("onload", func)//对于IE
        }
        else {
            window.addEventListener("load", func, false);//对于FireFox
        }
    }
    if (st_lang) {
        addLoadEvent(function () {
            zh_tran(st_lang)
        })
    }
</script>
<script>
window.addEventListener('load', function(){
    const tabWrap = document.getElementById('fsD2');
    const btnList = document.querySelectorAll('#D1fBt01 a');
    const panelList = document.querySelectorAll('#D1pic2 .fcon');
    // 所有内部可点击卡片/链接
    const itemSelector = '.I_box_01, .rd_fw_list, .rd_fw_list li a, .I_box_01 a';
    let currentIndex = 0;
    let isAnim = false;
    // 统一切换函数
    function switchTab(index){
        if(isAnim || index === currentIndex) return;
        isAnim = true;
        btnList.forEach(btn => btn.classList.remove('current'));
        btnList[index].classList.add('current');
        panelList.forEach((panel, i)=>{
            panel.style.display = i === index ? 'block' : 'none';
        })
        currentIndex = index;
        setTimeout(()=>{
            isAnim = false;
        }, 220);
    }
    // 绑定页码按钮点击
    btnList.forEach((btn, idx)=>{
        btn.addEventListener('click', ()=>{
            switchTab(idx);
        })
        btn.addEventListener('touchstart', ()=>{
            switchTab(idx);
        });
    })
    function stopItemBubble() {
        const items = document.querySelectorAll(itemSelector);
        items.forEach(el => {
            el.addEventListener('touchstart', e => e.stopPropagation());
            el.addEventListener('touchmove', e => e.stopPropagation());
            el.addEventListener('touchend', e => e.stopPropagation());
            el.addEventListener('touchcancel', e => e.stopPropagation());
        });
    }
    stopItemBubble();
    // 滑动手势逻辑（只有点击空白区域才执行）
    let startX = 0, startY = 0;
    let moveX = 0, moveY = 0;
    const moveLimit = 60;
    tabWrap.addEventListener('touchstart', (e)=>{
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        moveX = 0;
        moveY = 0;
        // 如果点击的是卡片区域，直接终止手势流程
        const hitItem = e.target.closest(itemSelector);
        if(hitItem) return;
    }, {passive:true});
    tabWrap.addEventListener('touchmove', (e)=>{
        const hitItem = e.target.closest(itemSelector);
        if(hitItem) return;
        moveX = e.touches[0].clientX - startX;
        moveY = e.touches[0].clientY - startY;
        if(Math.abs(moveY) > Math.abs(moveX)) return;
        e.preventDefault();
    }, {passive:false});
    tabWrap.addEventListener('touchend', ()=>{
        if(isAnim) return;
        const hitItem = event.target.closest(itemSelector);
        if(hitItem) return;
        if(Math.abs(moveY) > Math.abs(moveX)) return;
        if(moveX > moveLimit && currentIndex > 0){
            switchTab(currentIndex - 1);
        }
        if(moveX < -moveLimit && currentIndex < panelList.length - 1){
            switchTab(currentIndex + 1);
        }
    }, {passive:true});
})
</script>
<style>
    .ban_title_new {
        font-size: 24px;
        color: #404040;
        font-weight: 400;
        padding-left: 3px;
        border-bottom: 4px solid #bd1a2d;
    }
    <style>