    }
    .fbg {
        text-align: center;
        padding: 6px 0;
        position: relative;
        z-index: 99;
    }
    /* 轮播容器禁止遮挡按钮 */
    #D1pic2 {
        position: relative;
        z-index: 1;
    }
    .banner {
        position: relative;
        z-index: 10;
    }
    .I_box_01, .rd_fw_list li, .rd_fw_list a {
        position: relative;
        z-index: 10;
        pointer-events: auto !important;
    }
    #D1pic2 .fcon {
        z-index: 1;
    }
    .fbg {
        z-index: 99;
        position: relative;
    }

    /* 新增适配 不修改fcon布局、不破坏轮播切换 */
    #D1pic2 {
      width: 100% !important;
      overflow: hidden;
    }
    /* 轮播分页容器清除左右内边距，释放宽度 */
    #D1pic2 .fcon {
      padding: 0 4px !important;
    }
    /* 只针对 I_box_01 服务卡片做两列自适应，rd_fw_list 完全不动 */
    .I_box_01.L_float {
      width: calc(50% - 8px) !important;
      margin: 4px 4px !important;
      padding: 8px 6px !important;
      box-sizing: border-box !important;
