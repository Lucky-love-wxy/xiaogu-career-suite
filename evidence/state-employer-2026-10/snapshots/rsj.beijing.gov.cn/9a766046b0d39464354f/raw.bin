@media screen and (min-width: 320px) and (max-width: 768px) {
    .y-carousel {
        min-width: auto !important;
        height: auto !important;
    }
    .y-carousel .focus_area.clearfix {
        padding: 10px 12px !important;
        padding-top: 10px !important;
    }
    .y-carousel .home_head_news.nes-wrapper {
        width: 100% !important;
        height: auto !important;
        margin-bottom: 15px;
    }
    .y-carousel .tab-hd {
        display: flex !important;
        overflow-x: auto;
        overflow-y: hidden;
        white-space: nowrap;
        padding-bottom: 6px;
    }
    .y-carousel .tab-hd::-webkit-scrollbar {
        height: 2px;
    }
    .y-carousel .tab-hd::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.35);
        border-radius: 2px;
    }
    .y-carousel .tab-hd li {
        margin-right: 0 !important;
        flex-shrink: 0;
        padding: 0 8px;
    }
    .y-carousel .tab-hd li a {
        font-size: 15px !important;
    }
    .y-carousel .tab-bd p,
    .y-carousel .tab-bd a {
        font-size: 14px;
        line-height: 1.7;
        margin: 4px 0;
    }

    /* 取消浮动，轮播独占一行，排版不乱 */
    .L_float.w50.block {
        float: none !important;
        width: 100% !important;
    }

    /* 轮播向下偏移 */
    #D1pic1 {
        margin-top: 50px !important;
        width: 100% !important;
    }
    /* 图片铺满放大 */
    #D1pic1 .fcon {
        width: 100% !important;
    }
    #D1pic1 .fcon img {
        height: 120px !important;
        display: block;
    }

    /* 分页圆点居中整齐 */
    .fbg {
        text-align: center !important;
        padding: 8px 0 0 !important;
    }
    .D1fBt a {
        display: inline-block !important;
        margin: 0 3px !important;
        width: 10px;
        height: 10px;
    }

    /* 给轮播父容器开启相对定位，作为箭头参照 */
    #fsD1.focus {
        position: relative !important;
    }

    /* 左右箭头垂直完全居中，解决偏上 */
    .prev, .next {
        position: absolute !important;
        top: 60% !important;
        transform: translateY(-50%) !important;
        margin-top: 0 !important;
        z-index: 9;
        width: 30px;
        height: 40px;
        line-height: 40px;
        text-align: center;
        background: rgba(0,0,0,0.25);
        color: #fff;
    }
    .prev {
        left: 5px;
    }
    .next {
        right: 5px;
    }
}
</style>
