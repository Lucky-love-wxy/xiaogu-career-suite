/*首页频道按钮*/
.home-head-list {
	overflow: hidden;
	width: 100%;
}

.home-head-list li {
	float: left;
	margin: 5px;
	transition: all .5s;
	background-color: rgba(255,255,255,0.5);
}

.sytpli {
	border: 3px solid #eee;
	width: 47%;
	padding-bottom: 10px;
}

.home-head-list li:hover {
	background: #bd1a2d;
}

.home-head-list li a {
	display: block;
	padding: 24px 0px 24px 64px;
	text-align: center;
	font-size: 16px;
	font-weight: 400;
	transition: all .25s;
	background: url(./ywsite/images/P020191221336990023973.png)no-repeat;
}

.home-head-list li a:hover {
	color: #fff;
}

.home-head-list li a.head-link-01 {
	background-position: 0px 0px;
}

.home-head-list li a.head-link-01:hover {
	background-position: -268px 0;
}

.home-head-list li a.head-link-02 {
	background-position: 14px -128px;
}

.home-head-list li a.head-link-02:hover {
	background-position: -268px -128px;
}

.home-head-list li a.head-link-03 {
	background-position: 14px -240px;
}

.home-head-list li a.head-link-03:hover {
	background-position: -268px -240px;
}

.home-head-list li a.head-link-04 {
	background-position: 14px -365px;
}

.home-head-list li a.head-link-04:hover {
	background-position: -268px -365px;
}

.home-head-list li a.head-link-05 {
	background-position: 0px -480px;
}

.home-head-list li a.head-link-05:hover {
	background-position: -268px -480px;
}

.home-head-list li a.head-link-06 {
