<script type="text/javascript">
 function checkUrl(url, title) {
    const allowedDomains = [
        "https://rsj.beijing.gov.cn",
        "http://rsj.beijing.gov.cn",
        "http://fuwu.rsj.beijing.gov.cn"
    ];

    const isAllowedDomain = allowedDomains.some(domain => url.indexOf(domain) === 0);

    if (isAllowedDomain) {
        window.open(url);
    } else {
        if (confirm("您即将离开北京市人力资源和社会保障局网，进入\"" + title + "\"")) {
            window.open(url);
        } else {
            return false; // 用户点击取消时阻止跳转
        }
    }

    return false; // 阻止 <a> 默认跳转
}
</script>
