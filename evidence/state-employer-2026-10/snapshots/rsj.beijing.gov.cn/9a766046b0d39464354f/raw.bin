<script src="./images/jquery-3.7.1.min.js"></script>
<script>
    window.onload = function() {
        const taScripts = document.querySelectorAll('script[src*="ta.trs.cn/c/js/ta.js"]');
        taScripts.forEach(script => {
            const newSrc = script.src.replace('http://ta.trs.cn', 'https://ta.trs.cn');
            script.src = newSrc;
            script.async = true;
        });
    }
</script>
<script type="text/javascript" src="./images/koala.min.1.5.js"></script>
<script>
    function turnoff(obj){
        document.getElementById(obj).style.display="none";
    }
</script>
