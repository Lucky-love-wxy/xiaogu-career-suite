  <script>
    (function () {
      var protocol = window.location.protocol;
      var temp = protocol == 'http:' ? 'https:' : 'http:';
      $('iframe').each(function (i, e) {
        var url = $(e).prop('src');
        if (url.indexOf('https:')) {
          var isSameProtocol = !url.indexOf(temp);
          if (isSameProtocol) {
            $(e).prop('src', url.replace(temp, protocol))
          }
        }
        //var isSameProtocol = !url.indexOf(temp);
        // if (isSameProtocol) {
        //   // console.log()
        //     $(e).prop('src', url.replace(temp, protocol))
        // }

      })
    })();

  </script>
