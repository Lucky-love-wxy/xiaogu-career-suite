        <script>
          function detectDevice() {
            const userAgent = navigator.userAgent.toLowerCase();
            const mobileKeywords = [
              'android',
              'iphone',
              'ipad',
              'ipod',
              'windows phone',
              'blackberry',
              'iemobile'
            ];
            for (let i = 0; i < mobileKeywords.length; i++) {
              if (userAgent.includes(mobileKeywords[i])) {
                return 'mobile';
              }
            }
            return 'desktop';
          }

          const deviceType = detectDevice();
          let views = deviceType == 'desktop' ? 3 : 2
          let navs = deviceType == 'desktop' ? {
            nextEl: ".right-swiper-button-next",
            prevEl: ".right-swiper-button-prev",
          } : {}
          let swiper01 = new Swiper('#swiperBox01', {
            speed: 500,
            loop: true,
            slidesPerView: views,
            spaceBetween: 18,
            observer: true,
            observeParents: true,
            autoplay: {
              delay: 3000,
              stopOnLastSlide: false,
              disableOnInteraction: false,
            },
            navigation: navs,
          });
        </script>
      </div>

