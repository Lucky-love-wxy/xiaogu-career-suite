            <script>
                redirectInterceptor(
                    "ywzl.hrss.henan.gov.cn",
                    "https://hrss.henan.gov.cn",
                    false,
                );
                $(function () {
                    window.headTool = {
                        init: function () {
                            var mode = this.getCookie("mode");
                            if (mode == 2) {
                                $("#toolbarOldman").text("关闭适老模式");
                                $("body").addClass("oldModel");
                                new Marquee(
                                    "marqueedivff8080816a8cc65c016ab4226ed91af7",
                                    0,
                                    1,
                                    1000,
                                    310,
                                    50,
                                    0,
                                    0,
                                );
                                $(".slideBox1").slide({
                                    mainCell: ".bd ul",
                                    autoPlay: true,
                                    effect: "left",
                                    interTime: 5000,
                                    trigger: "click",
                                });
                            } else {
                                $("#toolbarOldman").text("进入适老模式");
                                $("body").removeClass("oldModel");
                                new Marquee(
                                    "marqueedivff8080816a8cc65c016ab4226ed91af7",
                                    0,
                                    1,
                                    264,
                                    224,
                                    50,
                                    0,
                                    0,
                                );
                                $(".slideBox1").slide({
                                    mainCell: ".bd ul",
                                    autoPlay: true,
                                    effect: "left",
                                    interTime: 5000,
                                    trigger: "click",
                                });
                            }
                            return this;
                        },
                        switchOld: function () {
                            var mode = this.getCookie("mode");
                            if (mode == 2) {
                                this.setCookie("mode", 1);
                            } else {
                                this.setCookie("mode", 2);
                            }
                            window.location.reload();
                        },
                        getCookie: function (name) {
                            var arr,
                                reg = new RegExp(
                                    "(^| )" + name + "=([^;]*)(;|$)",
                                );
                            if ((arr = document.cookie.match(reg))) {
                                return String(arr[2]);
                            } else {
                                return null;
                            }
                        },
                        setCookie: function (name, value) {
                            var Days = 30;
                            var exp = new Date();
                            exp.setTime(
                                exp.getTime() + Days * 24 * 60 * 60 * 1000,
                            );
                            document.cookie =
                                name +
                                "=" +
                                escape(value) +
                                ";expires=" +
                                exp.toGMTString();
                        },
                    }.init();
                });
            </script>
