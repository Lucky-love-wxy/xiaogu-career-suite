			var iCur = 0;
			var atuokey = false;
			var btnbox = document.getElementById("xinzlh251121-btn");
			var picbox = document.getElementById("xinzlh251121-li");
			var pics = picbox.getElementsByTagName("li");
			var picwidth = pics[0].offsetWidth;
			for(var i = 0;i<pics.length;i++){
				var li = document.createElement("li");
				btnbox.appendChild(li);	
			 }			
			var btns = btnbox.getElementsByTagName("li");
			tab();
			for(var i = 0;i<pics.length;i++){
			    btns[i].index = i;
				btns[i].onmouseover = function(){		
				iCur = this.index;
				tab();
				atuokey = true;
			   }
			   btns[i].onmouseout = function(){	
				atuokey = false;
			   }	
			}
			function tab(){
    for(var k = 0;k<pics.length;k++){
       btns[k].className='xinzlh251121-btn-current'; 
       pics[k].classList.remove("xinzlh251121-li-show");
    }
    btns[iCur].className='xinzlh251121-btn-hover'; 
    pics[iCur].className='xinzlh251121-li-show';
   }
			setInterval(function() {
				if(atuokey) return false;
				++ iCur;
				if(iCur>=pics.length){
					iCur=0;
				}
				tab();
			},5000);			
		});
	</script>
