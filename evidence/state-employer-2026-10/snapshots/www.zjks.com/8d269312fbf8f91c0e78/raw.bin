<style type="text/css">    /* css 重置 */
    * {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    /* 本例子css */
    .slideBox1 {
        width: 355px;
        height: 180px;
        overflow: hidden;
        position: relative;
        z-index: 999;
    }

    .slideBox1 .hd {
        height: 34px;
        width: 42px;
        overflow: hidden;
        position: relative;
        position: absolute;
        bottom: 146px;
        right: -8px;
        z-index: 1;
        cursor: pointer;
    }

    .slideBox1 .bd img {
        width: 292px;
        height: 156px;
        display: block;
        margin-bottom: 16px;
    }

    #slideBox1 {
        padding: 40px 24px 0px 24px;
        /* background-color: #fff; */
        background: url(/cms_files/jcms1/web3820/site/picture/0/2206151451447234862.png) no-repeat center center;
        background-size: cover;
        box-shadow: 0 2px 15px 0 rgb(153 153 153 / 50%);
    }

    /* 下面是前/后按钮代码，如果不需要删除即可 */
    .slideBox1 .prev {
        position: relative;
        top: 16px;
        left: 29px !important;
    }

    .slideBox1 .next {
        position: relative;
        top: 16px;
        right: -180px !important;
    }

    .slideBox1 .prev,
    .slideBox1 .next {
        width: 48px;
        height: 40px;
        color: #fff;
        font-size: 14px;
    }

    .slideBox1 .next {
        left: auto;
        right: 3%;
        background-position: 8px 5px;
    }

    .slideBox1 .prev:hover,
    .slideBox1 .next:hover {
        filter: alpha(opacity=100);
        opacity: 1;
    }

    .slideBox1 .prevStop {
        display: none;
    }

    .slideBox1 .nextStop {
        display: none;
    }

    .guanbi {
        background: url(/cms_files/jcms1/web3820/site/images/43366/d4209dd3670840e9b8e7d368931250a5.png) no-repeat center center;
    }

    .banner_title {
        color: #333;
        font-size: 14px;
    }

    .ggtitle {
        display: inline-block;
        width: 100%;
        height: 100%;
        text-align: center;
        line-height: 35px;
        font-size: 20px;
        font-weight: bold;
        color: #333333;
    }

    .window-gg a {
        color: #fff;
        text-decoration: none;
    }

    .window-gg-gy {
        display: inline-block;
        line-height: 24px;
        font-size: 14px;
        text-indent: 32px;
    }
</style>

<div id="slideBox1" class="slideBox1" style="position:fixed;bottom:0;right:0;display: none;">
    <div class="hd guanbi"></div>
    <div class="bd">
        <ul>
            

        </ul>
    </div>

    <a class="prev text-tag" href="javascript:void(0)" tabindex="282">上一条</a>
    <a class="next text-tag" href="javascript:void(0)" tabindex="283">下一条</a>
</div>

<script type="text/javascript">
    $(function () {
        // 点击隐藏 自动切换
        if ($(".window-gg").length != 0) {
            $('#slideBox1').show();
        }

        if ($(".window-gg").length == 1) {
            $('.text-tag').hide();
        }

        $(".guanbi").click(function () {
            $('#slideBox1').hide();
        });
        jQuery(".slideBox1").slide({
            mainCell: ".bd ul",
            autoPlay: true,
            interTime: 8000
        });
    });
</script>

