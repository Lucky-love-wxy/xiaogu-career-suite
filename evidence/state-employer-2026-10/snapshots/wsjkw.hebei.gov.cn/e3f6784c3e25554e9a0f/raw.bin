function  news(obj,n)
{
	var lia = document.getElementById(obj).getElementsByTagName("li");
	var lialen=lia.length
	for(i=0; i<lialen; i++){
		lia[i].className = "";
	}
	lia[n-1].className = "active";	
	for (var i =1,j; j=document.getElementById(obj+'-'+i); i++){
		j.style.display="none";
	}
	document.getElementById(obj+'-'+n).style.display="block";
}
