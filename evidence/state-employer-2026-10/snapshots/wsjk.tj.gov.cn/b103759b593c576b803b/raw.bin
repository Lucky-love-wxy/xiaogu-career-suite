				var flagY = true;

				function moveY() {
					if(flagY) {
						y++;
						if(y > clientHeight - 200) {
							flagY = false;
						}
					} else {
						y--;
						if(y < 0) {
							flagY = true;
						}
					}
					obj.style.top = y + "px";
				}

				function moveX() {
					if(flagX) {
						x++;
						if(x > clientWidth - 300) {
							flagX = false;
						}
					} else {
						x--;
						if(x < 0) {
							flagX = true;
						}
					}
					obj.style.left = x + "px";
