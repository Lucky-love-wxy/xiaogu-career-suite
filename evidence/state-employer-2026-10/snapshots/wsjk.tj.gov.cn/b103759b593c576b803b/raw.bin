<script>
  // 获取顶层栏目
  var currentChannel = '';
  $('.nav1 ul li a').each(function (index) {
    // 当前栏目是站点，默认选中首页
    if (currentChannel === '' && index === 0) {
      $(this).addClass('active');
      return false;
    }
    if ($(this).text().replace(/(^\s*)|(\s*$)/g, "") === currentChannel) {
      $(this).addClass('active');
    }
  });
</script>
