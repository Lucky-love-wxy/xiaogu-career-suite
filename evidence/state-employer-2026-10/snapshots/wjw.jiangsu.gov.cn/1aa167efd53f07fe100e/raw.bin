                    <script type="text/javascript">
                        $(document).ready(function(){
                              var img_len = $(".focus_img_all .focus_img").length;
                              /*左右切换*/
                              var img_WH = $(".focus_img_all .focus_img").width();
                              $(".focus_img_all").css({width:img_len*img_WH,height:$(".focus_img_all .focus_img").height()});
                              for(f_index=0; f_index<img_len; f_index++){
                                    $(".focus_img_all .focus_img").eq(f_index).css({left:(f_index*img_WH)});
                              }
                              var f_index = 0;
                              function f_show(){
                                    $(".focus_point_main .focus_point").eq(f_index).addClass("On").siblings().removeClass("On");
                                    $(".focus_img_all").stop().animate({left:-f_index*img_WH},500); //左右:left,上下:top
                              }
                              f_show();
                              
                              //自动轮播，鼠标移入停止轮播
                              var f_play = setInterval(f_auto,4000);  //定时：4000ms
                              function f_auto(){
                                    f_index++;
                                    f_index %= img_len;
                                    f_show();
                              }
                              $(".focus_main").hover(function(){
                                    clearInterval(f_play);
                              },function(){
                                    f_play = setInterval(f_auto,4000);
                              });
                              
                              //焦点鼠标经过切换
                              $(".focus_point_main .focus_point").mouseover(function(){
                                    f_index = $(this).index();
                                    f_show();
                              });
                        });
                    </script></div>
