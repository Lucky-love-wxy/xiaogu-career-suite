                        .focus_img a{height: 45px;line-height: 45px;font-size:16px;color: #fff;display: block;z-index:10;}
                        .focus_title_main{width:555px; height:45px; overflow:hidden; position:absolute; bottom:0px; left:0px;}
                        .focus_title_all{width:auto; height:45px; overflow:hidden; position:absolute; top:0px; left:0px;margin: 0;padding: 0;}
