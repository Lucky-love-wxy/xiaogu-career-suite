<script>
      var tabsBox = document.getElementsByClassName("card-tabs")[0];
      var tabs = tabsBox.getElementsByTagName("li");
      var newsList = document.getElementsByClassName("card-news-list");
      var moreList = document
        .getElementsByClassName("card-more-box")[0]
        .getElementsByTagName("a");
      for (var i = 0; i < tabs.length; i++) {
        tabs[i].index = i;
        tabs[i].onmouseover = function () {
          if (tabsBox.classList.contains("bg-1") == true) {
            tabsBox.classList.remove("bg-1");
          }
          if (tabsBox.classList.contains("bg-2") == true) {
            tabsBox.classList.remove("bg-2");
          }
          if (tabsBox.classList.contains("bg-3") == true) {
            tabsBox.classList.remove("bg-3");
          }
          
          for (var j = 0; j < tabs.length; j++) {
            if (tabs[j].classList.contains("active") == true) {
              tabs[j].classList.remove("active");
            }
          }
          for (var j = 0; j < newsList.length; j++) {
            newsList[j].style.display = "none";
          }
          for (var j = 0; j < moreList.length; j++) {
            moreList[j].style.display = "none";
          }
          console.log(this.index)
          tabsBox.classList.add("bg-" + (this.index + 1));
          tabs[this.index].classList.add("active");
          newsList[this.index].style.display = "block";
          moreList[this.index].style.display = "inline";
        };
      }
    </script>

