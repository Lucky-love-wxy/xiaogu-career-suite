<!--中央要闻列表切换-->
<script>
    $(function () {
        $(".zyyw .zyywNav li").each(function (index) {
            $(this).on("mouseover", function () {
                $(this).addClass("active").siblings().removeClass("active");
                $(".zyyw .container .newsList").eq(index).stop().fadeIn(0).siblings().fadeOut(0);
            });
        });
    });
</script>
<!--矩阵平台切换-->
<script>
    function $get(id) {
        return typeof id == "string" ? document.getElementById(id) : id;
    }
    function checkBgStyleInJZ(num) {
        var lis = $get("jzpt").getElementsByTagName("a");
        for (i = 1; i < 5; i++) {
            document.getElementById("jz_item" + i).src = "https://www.gdzz.gov.cn/public/jz_" + i + ".png";
            lis[i - 1].style.backgroundColor = "#fdefee";
            
            if (i === 4) {
                lis[i - 1].style.backgroundImage = "none";
            } else {
                lis[i - 1].style.backgroundImage = "url(https://www.gdzz.gov.cn/public/jz_border.jpg)";
            }
        }
        document.getElementById("jz_item" + num).src =
            "https://www.gdzz.gov.cn/public/jz_" + num + "_active.png";
        lis[num - 1].style.backgroundColor = "#e52011";
        lis[num - 1].style.backgroundImage = "none";
    }
</script>
<style>
  
.main .spzl .swiper-gdzx{
    width: 1120px;
    margin: 0 auto;
    height: 228px;
}

.main .gdzx .section {
    height: 208px;
}
.main .gdzx .arrow-left {
    top: 148px;
}
.main .gdzx .arrow-right {
    top: 148px;
}
</style>
</body>
</html>
