    <script>
        var ifie = 0;
        function tipInfo() {
            var ua = navigator.userAgent.toLocaleLowerCase();
            var browserType = null;
            if (ua.match(/msie/) != null || ua.match(/trident/) != null) {
                browserType = "IE";
                browserVersion = ua.match(/msie ([\d.]+)/) != null ? ua.match(/msie ([\d.]+)/)[1] : ua.match(/rv:([\d.]+)/)[1];
                if (browserVersion < 10) {
                    Dialog.alert('为了更好的网站浏览体验，请使用IE9.0（包括360兼容模式IE9.0）以上的浏览器！')
                    ifie = 1
                }
            }
        }
        tipInfo()
        if (ifie == 1) {
            document.write('<link rel="stylesheet" href="/css/idangerous.swiper2.7.6.css"><script src="/js/idangerous.swiper2.7.6.min.js"><\/script>');
            $(function () {
                var mySwiper2 = new Swiper('.zyxw-swiper-container', {
                    loop: true,
                    autoplay: 5000,
                    observer: true,
                    observeParents: true,
                    pagination: '.zyxw_pagination',
                    paginationClickable: true,
                    onSlideChangeStart: function (swiper) {
                        $('.zxpd_szyw .index_news_con_scroll_con').eq(swiper.activeLoopIndex).addClass('show').siblings('.zxpd_szyw .index_news_con_scroll_con').removeClass('show');
                    },
                });
                var mySwiper3 = new Swiper('.gzdt-swiper-container', {
                    loop: true,
                    autoplay: 5000,
                    observer: true,
                    observeParents: true,
                    pagination: '.gzdt_pagination',
                    paginationClickable: true,
                    onSlideChangeStart: function (swiper) {
                        $('.zxpd_zyxw .index_news_con_scroll_con').eq(swiper.activeLoopIndex).addClass('show').siblings('.zxpd_zyxw .index_news_con_scroll_con').removeClass('show');
                    },
                });
                var mySwiperNew = new Swiper('.zxdt-swiper-container', {
                    loop: true,
                    autoplay: 5000,
                    observer: true,
                    observeParents: true,
                    pagination: '.zxdt_pagination',
                    paginationClickable: true,
                    onSlideChangeStart: function (swiper) {
                        $('.zxpd_zxdt .index_news_con_scroll_con').eq(swiper.activeLoopIndex).addClass('show').siblings('.zxpd_zxdt .index_news_con_scroll_con').removeClass('show');
                    },
                });
                $('.index_content .index-swiper-container').css('height', $('.index_content .index-swiper-container img').height())
                var mySwiper = new Swiper('.index-swiper-container', {
                    loop: true,
                    autoplay: 5000,
                    pagination: '.pagination',
                    paginationClickable: true,
                    navigation: {
                        nextEl: '.nextbanner',
                        prevEl: '.prevbanner',
                    },
                });
                var mySwiperSpecial = new Swiper('.index_special', {
                    slidesPerView: 4,
                    slidesPerGroup: 4,
                    spaceBetween: 13,
                    autoplay: false,
                    navigation: {
                        nextEl: '.nextbanner',
                        prevEl: '.prevbanner',
                    },
                });
                // mySwiper2.el.onmouseover = function () {
                //     mySwiper2.autoplay.stop();
                // }
                // mySwiper2.el.onmouseout = function () {
                //     mySwiper2.autoplay.start();
                // }
                // mySwiper3.el.onmouseover = function () {
                //     mySwiper3.autoplay.stop();
                // }
                // mySwiper3.el.onmouseout = function () {
                //     mySwiper3.autoplay.start();
                // }
                // mySwiper.el.onmouseover = function () {
                //     mySwiper.autoplay.stop();
                // }
                // mySwiper.el.onmouseout = function () {
                //     mySwiper.autoplay.start();
                // }
            })
        } else {
            document.write('<script src="/js/swiper-4.1.6.min.js"><\/script><link rel="stylesheet" href="/css/swiper-4.1.6.min.css">');
            $(function () {
                var mySwiper2 = new Swiper('.zyxw-swiper-container', {
                    loop: true,
                    autoplay: true,
                    observer: true,
                    observeParents: true,
                    pagination: {
                        el: '.zyxw_pagination',
                        clickable: true,
                    },
                    on: {
                        slideChangeTransitionStart: function () {
                            $('.zxpd_szyw .index_news_con_scroll_con').eq(this.realIndex).addClass('show').siblings('.zxpd_szyw .index_news_con_scroll_con').removeClass('show');
                        },
                    },
                });
                var mySwiper3 = new Swiper('.gzdt-swiper-container', {
                    loop: true,
                    autoplay: true,
                    observer: true,
                    observeParents: true,
                    pagination: {
                        el: '.gzdt_pagination',
                        clickable: true,
                    },
                    on: {
                        slideChangeTransitionStart: function () {
                            $('.zxpd_zyxw .index_news_con_scroll_con').eq(this.realIndex).addClass('show').siblings('.zxpd_zyxw .index_news_con_scroll_con').removeClass('show');
                        },
                    }
                });
                var mySwiperNew = new Swiper('.zxdt-swiper-container', {
                    loop: true,
                    autoplay: true,
                    observer: true,
                    observeParents: true,
                    pagination: {
                        el: '.zxdt_pagination',
                        clickable: true,
                    },
                    on: {
                        slideChangeTransitionStart: function () {
                            $('.zxpd_zxdt .index_news_con_scroll_con').eq(this.realIndex).addClass('show').siblings('.zxpd_zxdt .index_news_con_scroll_con').removeClass('show');
                        },
                    }
                });
                $('.index_content .index-swiper-container').css('height', $('.index_content .index-swiper-container img').height())
                var mySwiper = new Swiper('.index-swiper-container', {
                    loop: true,
                    autoplay: true,
                    pagination: {
                        el: '.pagination',
                        clickable: true,
                    },
                    navigation: {
                        nextEl: '.nextbanner',
                        prevEl: '.prevbanner',
                    },
                });
                mySwiper2.el.onmouseover = function () {
                    mySwiper2.autoplay.stop();
                }
                mySwiper2.el.onmouseout = function () {
                    mySwiper2.autoplay.start();
                }
                mySwiper3.el.onmouseover = function () {
                    mySwiper3.autoplay.stop();
                }
                mySwiper3.el.onmouseout = function () {
                    mySwiper3.autoplay.start();
                }
                mySwiperNew.el.onmouseover = function () {
                    mySwiperNew.autoplay.stop();
                }
                mySwiperNew.el.onmouseout = function () {
                    mySwiperNew.autoplay.start();
                }
                mySwiper.el.onmouseover = function () {
                    mySwiper.autoplay.stop();
                }
                mySwiper.el.onmouseout = function () {
                    mySwiper.autoplay.start();
                }
                var mySwiperSpecial = new Swiper('.index_special', {
                    slidesPerView: 4,
                    slidesPerGroup: 4,
                    spaceBetween: 13,
                    autoplay: false,
                    navigation: {
                        nextEl: '.nextbanner',
                        prevEl: '.prevbanner',
                    },
                    pagination: {
                        el: '.special-page',
                        clickable: true,
                    }
                });
            })
        }





