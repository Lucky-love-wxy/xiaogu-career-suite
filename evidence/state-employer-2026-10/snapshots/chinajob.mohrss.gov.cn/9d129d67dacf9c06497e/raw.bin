    <link rel="shortcut icon" href="/images/icon.png" type="images/x-icon" />
    <link rel="icon" href="/images/icon.png" type="images/png" />
    <link rel="stylesheet" type="text/css" href="/v3/css/responsiveslides.css" />
    <script src="/v3/js/responsiveslides.js"></script>
    <style>
        /*html{filter: grayscale(100%);-webkit-filter: grayscale(100%);-moz-filter: grayscale(100%);-ms-filter: grayscale(100%);-o-filter: grayscale(100%);filter:progid:DXImageTransform.Microsoft.BasicImage(grayscale=1);-webkit-filter: grayscale(1);}*/
        .index_content .banner {
            overflow: hidden;
        }

        .index_content .banner .swiper-slide {
            opacity: 0.3;
        }

        .index_content .banner .swiper-slide-active {
            opacity: 1;
        }

        .index-swiper-container {
            width: 1200px;
            margin: 0 auto;
            position: relative;
            height: 260px !important;
        }

        .index-swiper-container .mask_left {
            position: absolute;
            left: -1200px;
            top: 0px;
            width: 100%;
            height: 260px;
            background: #000;
            opacity: .7;
            z-index: 1;
        }

        .index-swiper-container .mask_right {
            position: absolute;
            right: -1200px;
            top: 0px;
            width: 100%;
            height: 260px;
            background: #000;
            opacity: .7;
            z-index: 1;
        }

        .index-swiper-container .pagination {
            z-index: 3;
            position: absolute;
            top: 220px !important;
            bottom: auto !important;
            left: 1050px !important;
            overflow: hidden;
        }

        .index-swiper-container .pagination span {
            width: 10px;
            height: 10px;
            /*background:rgba(255,255,255,0.8);*/
            float: left;
            margin-left: 5px;
            margin-right: 5px;
            border-radius: 5px;
            opacity: 0.4;
            background: #000;
        }

        .index-swiper-container .pagination span.swiper-pagination-bullet-active {
            background: #e80606;
            opacity: 1
        }

        .index-swiper-container .pagination span.swiper-active-switch {
            background: #e80606;
            opacity: 1
        }

        .zyxw-swiper-container,
        .gzdt-swiper-container,
        .zxdt-swiper-container {
            width: 320px;
            height: 205px;
            overflow: hidden;
            position: relative;
        }

        .zyxw_pagination,
        .gzdt_pagination,
        .zxdt_pagination {
            z-index: 3;
            position: absolute;
            left: 83% !important;
            bottom: 5px !important;
            overflow: hidden;
        }

        .zyxw_pagination span,
        .gzdt_pagination span,
        .zxdt_pagination span {
            width: 10px;
            height: 10px;
            background: rgba(255, 255, 255, 0.8);
            float: left;
            margin-left: 3px;
            margin-right: 3px;
            cursor: pointer;
            border-radius: 0;
        }

        .zyxw_pagination span.swiper-pagination-bullet-active,
        .gzdt_pagination span.swiper-pagination-bullet-active,
        .zxdt_pagination span.swiper-pagination-bullet-active {
            background: #e80606;
        }

        .zyxw_pagination span.swiper-active-switch,
        .gzdt_pagination span.swiper-active-switch,
        .zxdt_pagination span.swiper-active-switch {
            background: #e80606;
        }
    </style>
</head>

