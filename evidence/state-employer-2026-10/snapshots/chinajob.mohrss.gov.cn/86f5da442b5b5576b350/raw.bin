.web_state_warp ul{width:1000px;margin: 15px auto 50px;}
.web_state_warp ul li{color: #c0c0c0;font-size: 12px;height: 24px;line-height: 24px;padding-left: 12px;background: url(/images/list/list_bg1.png) left center no-repeat;}
.web_state_warp ul li a{color: #fff;font-size: 12px;}
.web_state_warp ul li.selected{position: relative;padding-left: 10px;padding-right: 5px;background: #101214;color: #f9d060;font-weight: bold;}
.web_state_warp ul li.selected a{color:#f9d060;}
.web_state_warp ul li.selected span{position: absolute;top: 0px;right: -10px;width: 10px;height: 24px;background: url(/images/list/list_bg2.png) 0 0 no-repeat;}
.web_state{width:1200px;margin:0px auto 50px;background:#fff;padding-top:;}
.web_state h4{font-size:24px;font-weight:bold;color:#333;text-align:center;margin-bottom:50px;padding-top:50px;}
.web_state div{font-size:16px;line-height:35px;min-height:205px;}
</style>
