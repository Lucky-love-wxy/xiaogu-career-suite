<script>
	$(function () {
		var navLi=$(".menu_list li ");
		navLi.mouseover(function () {
			$(this).find("a").addClass("current");
			$(this).find(".box").slideDown();
		})
		navLi.mouseleave(function(){
			$(this).find("a").removeClass("current");
			$(this).find(".box").stop().slideUp();
		})
		
		$('#qh_fj1 .zh_topic li,#qh_fj2 .zh_topic li,#qh_fj3 .zh_topic li,#qh_fj4 .small li').hover(function(){
			var Index = $(this).index();
			var fujiid = $(this).parent().parent().attr("id");
			if(fujiid == "qh_fj4"){
				$(this).addClass('active_qwd').siblings().removeClass('active_qwd');
			}else{
				$(this).addClass('active').siblings().removeClass('active');
			}
			$('#'+fujiid+' #dfdx').children('div').eq(Index).show().siblings('div').hide();
	   });
	})
</script> 
