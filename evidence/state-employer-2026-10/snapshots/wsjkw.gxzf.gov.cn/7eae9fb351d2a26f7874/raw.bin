</body>
<script src="https://wsjkw.gxzf.gov.cn/material/js/zntj.js"></script>
<script type="text/javascript">
    var json = 'https://wsjkw.gxzf.gov.cn/zntj/index.json';
    $.getJSON(json, function (res) {
        var arr = randomArray(res, 7); //json数组，展示个数
        appEnd(arr);
    });
    //智能推送
    $(".zntj").hover(function () {
        $(".bottom_news").css("display", "block");
        $(".con-tab-bg").stop().animate({ width: '400px' }, 500);
    },
        function () {
            $(".con-tab-bg").stop().animate({ width: '0px' }, 500, function () {
                $(".bottom_news").css("display", "none");
            });
        });
</script>

