												}
											}
										});
										// $(".swiper-slide-end-l").html(res.object[0].remarks);
										swiper.on("transitionEnd", function(e) {
											//console.log(e, 99999999999999, e.realIndex)
											var slideIndex = e.realIndex;
											//console.log("I'm on slide no: " + slideIndex);
											$(".active-num").html(slideIndex + 1);
											//console.log(res.object[slideIndex].remarks);
											// $(".swiper-slide-end-l").html(res.object[slideIndex].remarks);
										});
									} else {

										var swiper = new Swiper('.banner1', {
											slidesPerView: 1,
											loop: true,
											autoplay: 5000,
											prevButton: '.swiper-button-next',
											nextButton: '.swiper-button-prev',
											pagination: '.pagination9',
											paginationClickable :true,
										});
										// $(".swiper-slide-end-l").html(res.object[0].remarks);
										swiper.on("transitionEnd", function(e) {
											var slideIndex = e.realIndex;
											$(".active-num").html(slideIndex + 1);
											// $(".swiper-slide-end-l").html(res.object[slideIndex].remarks);
										});
									}
								},
								error: function(error) {
									//console.log("发生错误：" + error)
								}
							});
						}
