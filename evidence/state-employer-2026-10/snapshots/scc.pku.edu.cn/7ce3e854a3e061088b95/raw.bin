		<style>
			.robot_box{
				width: 164px;
				height: 60px;
				position: fixed;
				top: 800px;
				right: -100px;
				background: url(/frontpage/pku/images/schoolImg/bg-qa-hover.png) no-repeat;
				background-size: auto 100%;
				z-index: 1000;
				padding: 15px 20px;
				box-sizing: border-box;
			}
			.robot_box img{
				width: 34px;
				height: 30px;
				float: left;
			}
			.robot_box span{
				font-family: PingFangSC, PingFang SC;
				font-weight: 500;
				font-size: 20px;
				color: #FFFFFF;
				margin-left: 10px;
				float: left;
			}
			.robot-all {
				position: fixed;
				right: 170px;
				bottom: 150px;
				z-index: 11000;
				width: 156px;
				height: 199px;
				z-index: 20000;
			}

			.robot-all a {
				width: 100%;
				height: 100%;
				background: url(/frontpage/pku/images/schoolImg/img-robot.png) no-repeat;
				background-size: 100% 100%;
				display: block;
			}
			.robot-all a:hover{
				background: url(/frontpage/pku/images/schoolImg/img-robot-hover.png) no-repeat;
				background-size: 100% 100%;
			}
		</style>
		<script>
			
			$(".robot_box").hover(function() {
				$(this).stop().animate({
					right: '0px'
				});
			}, function() {
				$(this).stop().animate({
					right: '-100px'
				});
			});
			
			
			var startLeft = 0, //定义位置初始变量
				startTop = 0;
			window.onload = function() {
				var img = document.getElementById("robot-all");
				// dragImg(img);
			};

			function dragImg(obj) {
				 
				obj.onmousedown = function(event) {
					// 阻止事件冒泡
					 event.preventDefault();
					 
					startLeft = event.clientX; //记录初始位置
					startTop = event.clientY;

					event = event || window.event;
					var ox = event.clientX - obj.offsetLeft;
					var oy = event.clientY - obj.offsetTop;
					document.onmousemove = function(event) {
						// 阻止事件冒泡
						 event.preventDefault();
						 
						event = event || window.event;
						var left = event.clientX - ox;
						var top = event.clientY - oy;
						obj.style.left = left + "px";
						obj.style.top = top + "px";
					};
					document.onmouseup = function(event) {
						// 阻止事件冒泡
						 event.preventDefault();
						 
						document.onmousemove = null;
						document.onmouseup = null;
						obj.releaseCapture && obj.releaseCapture();
					};
					return false;
				};
				obj.onclick = function(e) {
					// 阻止事件冒泡
					 e.preventDefault();
					if (e.clientX !== startLeft || e.clientY !== startTop) {
						startLeft = 0, //位置发生变化为拖拽
							startTop = 0;
						return;
					} else {
						//console.log(11111)
						window.location.href="/f/robot/forwardRobot"
					}
				}
			}
			// $('.a1').click(function(){
			// 	window.location.href="/f/robot/forwardRobot"
			// })
