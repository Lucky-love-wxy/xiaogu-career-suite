<!DOCTYPE html>
<html lang="zh-cn">

	<head>
		<title></title>
		<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
		<meta name="keywords" content="">
		<meta name="description" content="">
		<meta name="viewport" content="width=1440">
		<meta http-equiv="X-UA-Compatible" content="edge" />
		<!-- <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> -->
		<link rel="stylesheet" type="text/css" href="/frontpage/pku/js/swiper-3.4.2.min.css" />
		<!-- <link rel="stylesheet" type="text/css" href="../css/index.min.css" /> -->
		<!-- <link rel="stylesheet" type="text/css" href="../css/index_1.min.css" /> -->
		<link rel="stylesheet" type="text/css" href="/frontpage/pku/css/index_1.css?v=1.2" />
		<script src="/frontpage/pku/js/j3.js"></script>
		<script type="text/javascript" src="/frontpage/pku/js/swiper-3.4.2.min.js"></script>
		<link rel="shortcut icon" href="/frontpage/pku/images/frontPage/favicon.ico" type="image/x-icon">
		<script src="/frontpage/pku/js/pc_mobile_skip.js"></script>
		<script type="text/javascript" src="/frontpage/pku/js/init.js?v=4.6"></script>
		<script type="text/javascript" src="/frontpage/pku/js/artTemplate.js"></script>
		<script type="text/javascript" src="/frontpage/pku/js/util.js"></script>
		<script type="text/javascript" src="/frontpage/pku/js/tplt.js"></script>
		<script src="/frontpage/pku/js/newDateFrontIndex.js"></script>
		<script type="text/javascript" src="/frontpage/pku/js/index.js?v=1.1"></script>
		<link rel="stylesheet" href="/frontpage/pku/iconfont/iconfont.css" />
		<!-- <link rel="stylesheet" type="text/css" href="../css/hb.min.css" /> -->
		<link rel="stylesheet" type="text/css" href="/frontpage/pku/css/headerCss.css?v=9.23" />
		<link rel="stylesheet" type="text/css" href="/frontpage/pku/plugins/select2/select2.min.css" />
		<script type="text/javascript">
			template.helper('urlAddDomain', function(url) {
				if (window._config.domain) {
					return window._config.domain + url;
				} else {
					return '/' + url;
				}
			});
			template.helper('typeToName', function(type) {
				var names = {
					'3': '空中宣讲会',
					'4': '视频宣讲会',
					'5': '校外云宣讲'
				}
				return names[type];
			});
			template.helper('isNeedShowZBBtn', function(value, user) {
				if (value.fairType == '3') {
					var isAllowWatch = $.out(value, 'recruitmentFairVideo.isAllowWatch');
					var allowRepaly = $.out(value, 'recruitmentFairVideo.allowRepaly');
					if (isAllowWatch == '1' || allowRepaly == '1') {
						if (user.loginStatus == '1' && user.userType == '4') {
							return false;
						}
						return true;
					}
				}
				return false;
			});
		</script>
		<style>
			/* .header3 .nav3>li {
			width: 108px;
		}

		.header3 .nav3>li>a {
			width: 108px;
		} */

		.topImg_1 {
			position: absolute;
			top: 0;
			right: 0;
			width: 29px;
			height: 29px;
			background-image: url('/frontpage/pku/images/frontPage/icon_top.png');
		}

		.page_index .sec_2>.l_con .module_1 .page .list>li {
			position: relative;
			/* float: left; */
			/* padding: 0 18px; */
			box-sizing: border-box;
			margin-bottom: 15px;
			background: #F0F6F0;
			width: 100%;
			padding-left: 10px;
		}

		.list-first-div-date {
			background: none;
		}

		.list-first {
			height: 75px;
		}

		.page_index {
			background: rgba(255, 255, 255, 1) !important;
			    max-width: 1920px;
			    margin: 0 auto;
				overflow: hidden;
		}

		
		.ab-lunbo {
			position: absolute;
			left: 0;
			bottom: -7px;
			width: 100%;
			z-index: 999;
			height: 200px;
			/* background: url('/frontpage/pku/images/schoolImg/cuc-ending1.png') no-repeat center center; */
		}

		.gray-color {
			position: absolute;
			left: 0;
			bottom: -19px;
			width: 100%;
			z-index: 99;
			height: 81px;
			background-image: linear-gradient(180deg, #e0e6ed 0%, #ecf0f5 57%, #f7f9fc 100%);
		}
		.pagination9{
			position: absolute;
			bottom: 36px!important;
			left: 0!important;
			right: 0!important;
			display: flex;
			justify-content: center;
		}
		.pagination9 .swiper-pagination-bullet{
			width: 14px;
			height: 8px;
			background: rgba(255,255,255,0.4);
			border-radius: 4px;
		}
		.pagination9 .swiper-pagination-bullet-active{
			width: 30px;
			height: 8px;
			background: #FFFFFF;
			border-radius: 4px;
		}
		#erji_header{
			position: absolute;
			    z-index: 1000;
			    top: 0;
			    left: 0;
			    width: 100%;
		}
		.banner1{
			margin-top: 115px;
		}
		.icon_solid{
			position: absolute;
			    width: 0;
			    height: 2px;
			    background: #990000;
			    left: 104px;
			    bottom: 0;
			    position: absolute;
				z-index: 2;
		}
		.hot_box{
					position: absolute;
					    width: 20px;
					    height: 20px;
					    background-color: #C02F2F;
					    right: 4px;
					    bottom: 4px;
						z-index: 2;
						background-image: url(/frontpage/pku/images/schoolImg/icon-hot-white.png);
						background-size: 9px 12px;
						background-position: center;
						border-radius: 50%;
						background-repeat: no-repeat;
				}
		.information_left .list-first::before{
			left: 104px;
			right: initial;
		}
	</style>
	</head>

	<body>
		<div class="wrapper page_index">
			<div id="erji_header"></div>
			<script>
				$("#erji_header").load("/frontpage/pku/html/erji_header.html?ts=" + new Date().getTime());
			</script>
			<div class="body" style="position:relative;">
				<div id="bannerPlace">
					<script id="banner" type="text/html">
						{{if !isEmpty(bannerList)}}
					<div class="swiper-container10 banner" style="display: none;">
						<ul class="swiper-wrapper">
							{{each bannerList as value index}}
							<li class="swiper-slide">
								{{if !isEmpty(value.linkurl)}}
								<a href="{{value.linkurl}}" target="_blank" style="position: relative;display: block;height: 100%;">
									<img src="{{value.pictureOne}}" class="toe" />
								</a>
								{{else}}
								<a href="" target="_blank" onclick="return false;" style="position: relative;display: block;height: 100%;">
									<img src="{{value.pictureOne}}" class="toe" />
								</a>
								{{/if}}
							</li>
							{{/each}}
						</ul>
					</div>
					{{else}}
					<div class="swiper-container10 banner" style="display: none;">
						<ul class="swiper-wrapper">
							<li class="swiper-slide">
								<a href="" onclick="return false;" style="position: relative;display: block;height: 100%;">
									<img src="/frontpage/pku/images/schoolImg/cuc-home-bann.png" class="toe" />
								</a>
							</li>
						</ul>
					</div>
					{{/if}}
				</script>
				</div>
				<div id="banner1Place">
					<script id="banner1" type="text/html">
						{{if !isEmpty(bannerList)}}
						<div class="swiper-container banner1">
							<ul class="swiper-wrapper">
								{{each bannerList as value index}}
								<li class="swiper-slide">
									{{if !isEmpty(value.linkurl)}}
									<a href="{{value.linkurl}}" target="_blank" style="position: relative;display: block;height: 100%;">
										<img src="{{value.pictureOne}}" class="toe" />
									</a>
									{{else}}
									<a href="" target="_blank" onclick="return false;" style="position: relative;display: block;height: 100%;">
										<img src="{{value.pictureOne}}" class="toe" />
									</a>
									{{/if}}
								</li>
								{{/each}}
							</ul>
							<div class="pagination9"></div>
						</div>
						{{else}}
						<div class="swiper-container banner1">
							<ul class="swiper-wrapper">
								<li class="swiper-slide">
									<a href="" onclick="return false;" style="position: relative;display: block;height: 100%;">
										<img src="/frontpage/pku/images/schoolImg/banner.png" class="toe" />
									</a>
								</li>
							</ul>
							<div class="pagination9"></div>
						</div>
						{{/if}}
					</script>
				</div>

				<script language="javascript">
					function bannerFun() {
					var bannerNum = {
						num: 20,
						type: 'pc_type'
					}
					$.ajax({
						type: 'post',
						url: $.url('f/ajaxHome/ajax_IndexSwiper'),
						data: bannerNum,
						dataType: "json",
						beforeSend: function (xhr) {
							//xhr.setRequestHeader("token",window._config.token);
						},
						success: function (res) {
							//console.log(res, '轮播1111')
							tplt.draw('banner', {
								bannerList: $.out(res, 'object') || []
							});
							// tplt.draw('bannerw', {
							// 	bannerListw: $.out(res, 'object') || []
							// });
							if (parseInt($.IE.getVersion()) < 10) {
								// var swiper = new Swiper('.swiper-container', {
								// 	slidesPerView: 1,
								// 	loop: true,
								// 	autoplay: 5000,
								// 	spaceBetween: 10,
								// 	pagination: '.pagination',
								// 	paginationClickable: true,
								// 	autoplayDisableOnInteraction: false,
								// 	prevButton: '.ri-rr',
								// 	nextButton: '.ri-ll',
								// 	on: {
								// 		slideChangeTransitionEnd: function () {
								// 			$(".active-num").html(this.realIndex + 1);
								// 		}
								// 	},
								// 	onSlideChangeEnd: function () {
								// 		if (this.resizeFix) {
								// 			this.resizeFix();
								// 		}
								// 	}
								// });
								// swiper.stopAutoplay();

								var swiper = new Swiper('.swiper-container10', {
									slidesPerView: 1,
									loop: true,
									autoplay: 5000,
									// prevButton: '.ri-rr',
									// nextButton: '.ri-ll',
									prevButton: '.swiper-button-next',
									nextButton: '.swiper-button-prev',
									onSlideChangeEnd: function () {
										if (this.resizeFix) {
											this.resizeFix();
										}
									}
								});
								// $(".swiper-slide-end-l").html(res.object[0].remarks);
								swiper.on("transitionEnd", function (e) {
									//console.log(e, 99999999999999, e.realIndex)
									var slideIndex = e.realIndex;
									//console.log("I'm on slide no: " + slideIndex);
									$(".active-num").html(slideIndex + 1);
									//console.log(res.object[slideIndex].remarks);
									// $(".swiper-slide-end-l").html(res.object[slideIndex].remarks);
								});
							} else {
								// var swiper = new Swiper('.swiper-container', {
								// 	slidesPerView: 'auto',
								// 	loop: true,
								// 	autoplay: 5000,
								// 	spaceBetween: 10,
								// 	pagination: '.pagination',
								// 	paginationClickable: true,
								// 	autoplayDisableOnInteraction: false,
								// 	prevButton: '.ri-rr',
								// 	nextButton: '.ri-ll',
								// 	on: {
								// 		slideChangeTransitionEnd: function () {
								// 			$(".active-num").html(this.realIndex + 1);
								// 		}
								// 	},
								// 	onSlideChangeEnd: function () {
								// 		if (this.resizeFix) {
								// 			this.resizeFix();
								// 		}
								// 	}
								// });
								// swiper.stopAutoplay();

								var swiper = new Swiper('.swiper-container10', {
									slidesPerView: 1,
									loop: true,
									// autoplay: 5000,
									prevButton: '.swiper-button-next',
									nextButton: '.swiper-button-prev',
									pagination: '.pagination9',
									paginationClickable :true,
								});
								// $('.banner .pagination .swiper-pagination-switch').on('click',
								// 	function () {
								// 		var len = $(this).prevAll('.swiper-pagination-switch').length;
								// 		swiper.swipeTo(len, 700, false);
								// 	});
								// $(".swiper-slide-end-l").html(res.object[0].remarks);
								swiper.on("transitionEnd", function (e) {
									// //console.log(e, 99999999999999, e.realIndex)
									var slideIndex = e.realIndex;
									// //console.log("I'm on slide no: " + slideIndex);
									$(".active-num").html(slideIndex + 1);
									// //console.log(res.object[slideIndex].remarks);
									// $(".swiper-slide-end-l").html(res.object[slideIndex].remarks);
								});
							}
						},
						error: function (error) {
							//console.log("发生错误：" + error)
						}
					});
				}
			</script>
				<div class="information">
					<div class="l_con">
						<div class="information_left">
							<div class="information_title">
								<div class="label_box">
									<p>消息<span>中心</span></p>
									<i></i>
								</div>
								<!-- <span>INFORMATION</span> -->
							</div>
							<ul class="m_tit">
								<li class="active li1">重点推荐</li>
								<li class="li2">新闻热点</li>
								<li class="li3">通知公告</li>
								<a href="/frontpage/pku/html/recruitmentFairList.html?fairType=1">
									<li>招聘日历</li>
								</a>
								<li class="li4">招聘信息</li>
								<li class="li5">实习信息</li>
								<a href="/frontpage/pku/html/college_information.html">
									<li>职通专区</li>
								</a>
							</ul>
							<ul class="page">
								<li id="onePlace"></li>
								<li id="twoPlace"></li>
								<li id="threePlace"></li>
								<li id="recruitmentPlace"></li>
								<li id="practicePlace"></li>
							</ul>
							<script type="text/html" id="one">
								<li class="page_one" style="display: block;">
								<a class="see_more" href="/frontpage/pku/html/newsList_zdtj.html?id=4e0ccc2319c14e93b1688f229516a3d3" target="_blank">
									<!-- <div class="see_more-l">MORE</div>
									<div class="see_more-r"></div> -->
								</a>
								<ul class="list">
									<div class="swiper-container banner3">
										<ul class="swiper-wrapper">
											{{each list as value index}}
												<li class="swiper-slide">
													{{each value as value1 index1}}
													<div class="list-first">
														<a href="{{value1.url}}" target="_blank">
															<div class="list-first-div">
																<div class="list-first-div-date">
																	<div class="list-first-div-date-t">{{dateFormate(value1.releaseDate,'MM-dd')}}</div>
																	{{if value1.keywords}}
																		<div class="label_title label_title1">{{value1.keywords}}</div>
																	{{/if}}
																</div>
																<div class="icon_solid"></div>
																<div class="hot_box"></div>
																<div class="list-first-div1">
																	{{value1.title}}
																</div>	
															</div>
														</a>
													</div>
													{{/each}}
												</li>
											{{/each}}
										</ul>
										<div class="pagination3"></div>
									</div>	
									<div class="swiper-button-prev3"></div>
									<div class="swiper-button-next3"></div>
								</ul>
									
								</li>
							</script>
							<script type="text/html" id="two">
								<li class="page_two" style="display: none;">
									<a class="see_more" href="/frontpage/pku/html/newsList.html?id=13" target="_blank">
										<!-- <div class="see_more-l">MORE</div><div class="see_more-r"></div> -->
									</a>
									<ul class="list">
										{{each list}}
										{{if $index < 6}}
										<li class="list-first">
											<a href="{{$value.url}}" target="_blank">
												<div class="list-first-div">
													<div class="list-first-div-date">
														<div class="list-first-div-date-t">{{dateFormate($value.releaseDate,'MM-dd')}}</div>
													</div>
													<div class="icon_solid"></div>
													<div class="list-first-div1">
														{{$value.title}}
													</div>	
												</div>
											</a>
										</li>
										{{/if}}
										{{/each}}
									</ul>
								</li>
							</script>
							<script type="text/html" id="three">
								<li class="page_three" style="display: none;">
									<a class="see_more" href="/frontpage/pku/html/newsList.html?id=12" target="_blank">
										<!-- <div class="see_more-l">MORE</div><div class="see_more-r"></div> -->
									</a>
									<ul class="list">
										{{each list}}
										{{if $index < 6}}
										<li class="list-first">
											<a href="{{$value.url}}" target="_blank">
												<div class="list-first-div">
													<div class="list-first-div-date">
														<div class="list-first-div-date-t">{{dateFormate($value.releaseDate,'MM-dd')}}</div>
													</div>
													<div class="icon_solid"></div>
													<div class="list-first-div1">
														{{$value.title}}
													</div>	
												</div>
											</a>
										</li>
										{{/if}}
										{{/each}}
									</ul>
								</li>
							</script>
							<script type="text/html" id="recruitment">
								<li class="page_four" style="display: none;">
									<a class="see_more" href="/frontpage/pku/html/recruitmentinfoList.html?type=1" target="_blank">
										<!-- <div class="see_more-l">MORE</div><div class="see_more-r"></div> -->
									</a>
									<ul class="list">
										{{each recruitment}}
										{{if $index < 6}}
										<li class="list-first">
											<a href="{{$value.url}}" target="_blank">
												<div class="list-first-div">
													<div class="list-first-div-date">
														<div class="list-first-div-date-t">{{dateFormate($value.startTime,'MM-dd')}}</div>
													</div>
													<div class="icon_solid"></div>
													<div class="list-first-div1">
														{{$value.title}}
													</div>	
												</div>
											</a>
										</li>
										{{/if}}
										{{/each}}
									</ul>
								</li>
							</script>
							<script type="text/html" id="practice">
								<li class="page_five" style="display: none;">
									<a class="see_more" href="/frontpage/pku/html/recruitmentinfoList.html?type=2" target="_blank">
										<!-- <div class="see_more-l">MORE</div><div class="see_more-r"></div> -->
									</a>
									<ul class="list">
										{{each practice}}
										{{if $index < 6}}
										<li class="list-first">
											<a href="{{$value.url}}" target="_blank">
												<div class="list-first-div">
													<div class="list-first-div-date">
														<div class="list-first-div-date-t">{{dateFormate($value.startTime,'MM-dd')}}</div>
													</div>
													<div class="icon_solid"></div>
													<div class="list-first-div1">
														{{$value.title}}
													</div>	
												</div>
											</a>
										</li>
										{{/if}}
										{{/each}}
									</ul>
								</li>
							</script>
							<script>
								$(function() {
									$('.information').on('click', '.information_left .m_tit>.li1', function() {
										if (!$(this).hasClass('active')) {
											$(this).parent().find('.active').removeClass('active');
											var ind = $(this).addClass('active').index();
											// $('.information .information_left .page>li').hide().eq(ind).fadeIn();
											$('.information .information_left .page>li').hide();
											$('.information .information_left .page>#onePlace').show();
										}
									});
									$('.information').on('click', '.information_left .m_tit>.li2', function() {
										if (!$(this).hasClass('active')) {
											$(this).parent().find('.active').removeClass('active');
											var ind = $(this).addClass('active').index();
											// $('.information .information_left .page>li').hide().eq(ind).fadeIn();
											$('.information .information_left .page>li').hide();
											$('.information .information_left .page>#twoPlace').show();
										}
									});
									$('.information').on('click', '.information_left .m_tit>.li3', function() {
										if (!$(this).hasClass('active')) {
											$(this).parent().find('.active').removeClass('active');
											var ind = $(this).addClass('active').index();
											// $('.information .information_left .page>li').hide().eq(ind).fadeIn();
											$('.information .information_left .page>li').hide();
											$('.information .information_left .page>#threePlace').show();
										}
									});
									$('.information').on('click', '.information_left .m_tit>.li4', function() {
										if (!$(this).hasClass('active')) {
											$(this).parent().find('.active').removeClass('active');
											var ind = $(this).addClass('active').index();
											// $('.information .information_left .page>li').hide().eq(ind).fadeIn();
											$('.information .information_left .page>li').hide();
											$('.information .information_left .page>#recruitmentPlace').show();
										}
									});
									$('.information').on('click', '.information_left .m_tit>.li5', function() {
										if (!$(this).hasClass('active')) {
											$(this).parent().find('.active').removeClass('active');
											var ind = $(this).addClass('active').index();
											// $('.information .information_left .page>li').hide().eq(ind).fadeIn();
											$('.information .information_left .page>li').hide();
