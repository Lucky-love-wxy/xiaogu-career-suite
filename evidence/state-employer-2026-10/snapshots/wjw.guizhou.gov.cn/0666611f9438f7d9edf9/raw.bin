<script>
/*添加归档图章*/
function SetIsArchive() {
	let DocIsArchive = ($("meta[name='DocIsArchive']").length>0)?($("meta[name='DocIsArchive']").attr("content").split("|")):[0,0];
	let ChannelIsArchive = ($("meta[name='ChannelIsArchive']").length>0)?($("meta[name='ChannelIsArchive']").attr("content").split("|")):[0,0];
	if(parseInt(DocIsArchive[0]) == 1){
		AddArchiveHtml(DocIsArchive[1]);
	}else if(parseInt(ChannelIsArchive[0]) == 1){
		//AddArchiveHtml(ChannelIsArchive[1]);
		if(ChannelIsArchive[1] && ChannelIsArchive[1].indexOf('归档时间【')>-1){
			let gdsj = ChannelIsArchive[1].substring(ChannelIsArchive[1].indexOf('归档时间【')+5,ChannelIsArchive[1].indexOf('】'));
			AddArchiveHtml(gdsj);
		}else{
			AddArchiveHtml(ChannelIsArchive[2]);
		}
	}
}
/*填充图章html结构，根据图章情况编写*/
function AddArchiveHtml(date) {
	$("body").append(`
		 <div class="ArchiveGdPart">
            <p>`+ date +`</p>
            <style type="text/css">
                .ArchiveGdPart{ position: absolute; width: 200px; background: url(//www.guizhou.gov.cn/images/gd_red.png) no-repeat center top; padding: 120px 0 25px; z-index: 99; top: 380px; right: 50%; margin-right:-532px; transform: rotateZ(-20deg); }
                .ArchiveGdPart p{ font-size: 12px; color: #F00; display: block; text-align: center; line-height: 20px; letter-spacing: -1px;}
                @media screen and (max-width:750px ) {
                    .ArchiveGdPart{margin-right: 0px;right: 0;zoom: 0.7;}
                }
            </style>
            
        </div>
	`);
	$(".ArchiveGdPart p").arctext({dir:0,radius:60}); // 执行文字弯曲
}
$(function () {


        // 加载归档图章
        SetIsArchive();

    });
</script>
