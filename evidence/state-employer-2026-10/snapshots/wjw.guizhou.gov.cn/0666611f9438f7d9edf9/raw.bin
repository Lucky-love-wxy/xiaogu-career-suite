                <div class="clear"></div>
                <script type="text/javascript">
                    //网上调查
                    $.ajax({
                        url: '/IGI/open/survey/list',
                        data: {
                            pageIndex : 1,
                            pageSize : 3,
                            siteId : 500663,
                            orderby : 'endTime_desc'
                        },
                        type: 'get',
                        asyn: false,
                        dataType: 'json',
                        success: function (data) {
                            var docList = data.datas;
                            var html = "";
                            $.each(docList.data, function (i, v) {
                                if(v.exLink && v.exLink!=''){
                                    v.publishUrl = v.exLink;
                                }
                                html += '<li>';
                                html += '<h1><a href="' + v.publishUrl+ '" target="_blank">' + v.title + '</a></h1>';
                                if(v.startTime&&v.startTime!=''){
                                    html += '<div class="date">有效时间：' + getMyDate(v.startTime).substring(0,10).replace(/-/g,".") + ' 至 ' + getMyDate(v.endTime).substring(0,10).replace(/-/g,".") + '</div>';
                                }else{
                                    html += '<div class="date">有效时间：' + getMyDate(v.publicTime).substring(0,10).replace(/-/g,".") + '</div>';
                                }
                                html += '<div class="desc">'+ v.prefix +'</div>';
                                html += '<div class="Btns">';
                                if(v.status == 9){
                                    html += '<a class="ing" href="' + v.publishUrl+ '" target="_blank">调查已结束</a>';
                                    html += '<a class="join" href="' + v.publishUrl+ '" target="_blank">查看详情</a>';
                                }else{
                                    html += '<a class="ing" href="' + v.publishUrl+ '" target="_blank">调查进行中</a>';
                                    html += '<a class="join" href="' + v.publishUrl+ '" target="_blank">我要参与</a>';
                                }
                                html += '</div></li>';
                            })
                            $("#wsdc").html(html);
                        }
                    })
                    
                    function removeHTMLTag(str) {
                        str = str.replace(/<\/?[^>]*>/g,''); //去除HTML tag
                        str = str.replace(/[ | ]*\n/g,'\n'); //去除行尾空白
                        str = str.replace(/\n[\s| | ]*\r/g,'\n'); //去除多余空行
                        str=str.replace(/&nbsp;/ig,'');//去掉&nbsp;
                        str=str.replace(/\s/g,''); //将空格去掉
                        return str;
                    }
                    
                    //意见征集
                    $.ajax({
                        url: '/IGI/opinion/web/list',
                        data: {
                            pageIndex : 1,
                            pageSize : 3,
                            siteId : 500663,
                            orderby:"endTime_desc"
                        },
                        type: 'get',
                        asyn: false,
                        dataType: 'json',
                        success: function (data) {
                            var docList = data.datas;
                            var html = "";
                            $.each(docList.data, function (i, v) {
                                if(v.exLink && v.exLink!=''){
                                    v.publishUrl = v.exLink;
                                }
                                html += '<li>';
                                html += '<h1><a href="' + v.publishUrl+ '" target="_blank">' + v.theme + '</a></h1>';
                                if(v.beginTime&&v.beginTime!=''){
                                    html += '<div class="date">有效时间：' + getMyDate(v.beginTime).substring(0,10).replace(/-/g,".") + ' 至 ' + getMyDate(v.endTime).substring(0,10).replace(/-/g,".") + '</div>';
                                }else{
                                    html += '<div class="date">有效时间：' + getMyDate(v.publicTime).substring(0,10).replace(/-/g,".") + '</div>';
                                }
                                html += '<div class="desc">';
                                if(v.htmlContent && v.htmlContent!=''){
                                    html += removeHTMLTag(v.htmlContent);
                                }else{
                                    html += v.theme;
                                }
                                html += '</div><div class="Btns">';
                                if(v.status == 1){
                                    html += '<a class="ing" href="' + v.publishUrl+ '" target="_blank">征集已结束</a>';
                                    html += '<a class="join" href="' + v.publishUrl+ '" target="_blank">查看详情</a>';
                                }else if(v.status == 0){
                                    html += '<a class="ing" href="' + v.publishUrl+ '" target="_blank">征集进行中</a>';
                                    html += '<a class="join" href="' + v.publishUrl+ '" target="_blank">我要参与</a>';
                                }
                                html += '</div></li>';
                            })
                            $("#wszj").html(html);
                            
                            if(!isMobile){
                                $(".WsdcPart").slide({titCell:".inhd",mainCell:".inbd ul",effect:"fade",autoPage:true})
                            }
                        }
                    })
                    
                    if(!isMobile){
                        $(".ZjdcBox").slide({titCell:".PubHd li",mainCell:".bd",effect:"fade"})
                        $(".Part3").slide({titCell:".PartHd li",mainCell:".PartBd",effect:"fold",prevCell:".00",nextCell:".00"
                            ,startFun:function(i,c,s){
                                var lnum = s.find(".PartHd li").eq(i).position().left + 50;
                                $(".PartHd .onBar").stop().animate({left:lnum+"px"},500);
                            }
                        })
                    }else{
                        TouchSlide({ slideCell:"#ZjdcBox", titCell:".PubHd li", mainCell:".bd", effect:"left"});
                    }
                </script>
            </div>
        </div>
        
