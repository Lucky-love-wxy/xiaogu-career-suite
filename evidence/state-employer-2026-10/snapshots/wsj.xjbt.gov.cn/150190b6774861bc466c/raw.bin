	<script>
function lxfEndtime(){
	$t=$('#t').html();
	if($t!=0){
		$('#t').html($t-1);
		$i=setTimeout("lxfEndtime()",1000);
	}else{		
		$('.box').hide();
		$('#t').html(6);
		$('.ad_time').css({'width':'300px','height':'200px'});
		clearTimeout($i);
	}
};
$(document).ready(function(){
	$('.box').show();
	$(this).hide();	
	$('.ad_time').animate({width:40,height:25},'slow');
	lxfEndtime();
	$('.close').click(function(){
		$('.box').hide();
		$('#t').html(6);
		$('.ad_time').css({'width':'300px','height':'200px'});
		clearTimeout($i);
	})
});
</script>

