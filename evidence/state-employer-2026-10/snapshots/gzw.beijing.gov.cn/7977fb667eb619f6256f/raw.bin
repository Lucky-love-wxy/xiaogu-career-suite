<!-- 通用底部嵌套 -->
  <script src="/images/footer.js"></script>
<script src="/images/jquery.SuperSlide.2.1.1.js"></script>
    <!-- 通用底部嵌套 -->
    <script>
        //中央精神
        $(function () {
          $.ajax({
            url: "https://www.beijing.gov.cn/shouye/tltt/pushCommitteeNews_33256.js",
            dataType: "jsonp",
            scriptCharset: "UTF-8",
            jsonp: "pushInfoJsCallBack",
            jsonpCallback: "pushInfoJsCallBack",
            success: function (data) {
                $.each(data.data2, function (i, json) {
                    if (i >= 6) {
                        return false;
                    }
                    var l = json.title.length;
                    var title = (l >= 30) ? json.title.substring(0, 28) + "..." : json.title;
                    $("#zyjs").append("<li><a target='_blank' title='" + json.title + "' href='" + json.link + "'>" + title + "</a></li>")
                });
                $("#zyjs").append(
                    "<a href='https://www.beijing.gov.cn/ywdt/dzyjs/index.html' class='more' target='_blank' title='更多中央精神内容'>更多>></a>"
                );
                $.each(data.data3, function (i, json) {
                    if (i >= 6) {
                        return false;
                    }
                    var l = json.title.length;
                    var title = (l >= 30) ? json.title.substring(0, 28) + "..." : json.title;
                    $("#bjyw").append("<li><a target='_blank' title='" + json.title + "' href='" + json.link + "'>" + title + "</a></li>")
                });
                $("#bjyw").append(
                    "<a href='https://www.beijing.gov.cn/ywdt/yaowen/' class='more' target='_blank' title='更多北京要闻内容'>更多>></a>"
                );
            },
            error: function () {
              alert("error");
            },
          });
        });
    </script>
