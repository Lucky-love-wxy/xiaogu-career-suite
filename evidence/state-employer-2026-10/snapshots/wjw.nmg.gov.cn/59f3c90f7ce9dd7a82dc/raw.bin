    //appkey
    let appKey = "dda1bee997e29182febbe848dd3b313a"
    
    let myParam = {
		title: title,
		url: url,
		doc_id: doc_id,
		siteid: siteid,
		site_name: siteName,
		doc_channel: doc_channel,
		channel_relation: chnlRelation,
		channel_id: channel_id,
		doc_pub_time: docpubtime,
		app_key: appKey
    }
    //统计外链，换成自己网站的域名
    InitExternalLinks("/hx-api/receive/receiveLink",myParam,"wjw.nmg.gov.cn")
    eventReport.trackUserData(myParam)
    // 点击量埋点结束
</script>
<!-- /底部 -->
</body>
